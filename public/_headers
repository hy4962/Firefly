# Cloudflare Workers / Pages 静态资源响应头
#
# 生效范围：仅当站点部署到 Cloudflare（wrangler.jsonc 的 assets.directory）时。
# Vercel 会忽略这个文件——线上的缓存策略仍在 vercel.json 里，两者互不影响。
# 文档：https://developers.cloudflare.com/workers/static-assets/headers/
#
# 说明：Cloudflare 对静态资源的默认响应头是
#   Cache-Control: public, max-age=0, must-revalidate
# 即使是带内容哈希的 /_astro/* 也走这个默认值，所以下面必须显式覆盖。
#
# 限制：最多 100 条规则；每条规则行上限 2000 字符；不支持正则，只有 * 通配和 :placeholder。
# 因此 vercel.json 里的 "/(pagefind|pio)/(.*)" 要拆成两条。

# ── 全站安全头（对应 vercel.json 的 catch-all 规则）──
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin

# ── HTML 页面：边缘缓存 5 分钟 + 后台重新验证 ──
# 不设这一条时，HTML 走 Cloudflare 默认的 max-age=0, must-revalidate（无 s-maxage），
# 边缘每次都要回源校验。
#
# 为什么不用 /*：_headers 的多条规则是「累加」而不是「覆盖」，同名 header 会以逗号
# 合并成 "Cache-Control: a, b"。浏览器/中间层遇到重复指令取第一个，所以 /* 一旦设了
# Cache-Control，就会把下面 /_astro/* 的 immutable 顶掉。
#
# 为什么是 /*/：本站 astro.config 里 trailingSlash: "always"，所有页面 URL 都以 / 结尾
# （/about/、/posts/blog/foo/），而静态资源都是点号结尾（/_astro/x.js、/images/x.webp），
# 天然不会命中。splat 贪婪匹配，多级路径也能覆盖。
#
# s-maxage=300 而不是更长：部署后边缘最多滞后 5 分钟，且有访问就会触发后台刷新；
# stale-while-revalidate 保证这 5 分钟之外仍能先返回旧页、再异步回源，不阻塞首字节。
/*/
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400

# 根路径单独写绝对 URL：避免 "/" 被当成前缀通配匹配到 /_astro/ 等资源。
https://www.9ll.uk/
  Cache-Control: public, max-age=0, s-maxage=300, stale-while-revalidate=86400

# ── Astro 构建产物：文件名带内容哈希，可长期强缓存 ──
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# ── 不带哈希的静态资源：30 天 + 后台重新验证 ──
# 注意：这批文件改名才能让缓存失效，改图时记得换文件名。
/images/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/favicon/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/assets/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/pagefind/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800
/pio/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# ── 站内 API：只在边缘缓存 1 小时，浏览器不缓存（每次重新校验）──
# 与 vercel.json 的 /api/(.*) 保持一致：构建产物是静态 JSON，但每次部署内容会变，
# 若让浏览器缓存 1 小时，日历等组件会读到过期数据。
/api/*
  Cache-Control: public, s-maxage=3600, max-age=0, must-revalidate

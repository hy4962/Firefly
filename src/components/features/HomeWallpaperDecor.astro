            opacity calc(var(--home-wallpaper-collapse-duration, 950ms) * 0.45) ease;
    }

    /* 收起态：整体右移出屏 + 淡出。
       只做水平位移是刻意的 —— 卡片的垂直位置没变，手机端那套「按卡片位置算贴纸落点」的
       布局（applyMobileStickerLayout）读到的 rect.top / rect.bottom 不变，贴纸不会跟着乱跳。
       走动那一下也顺手把点击交出去，免得透明卡片还挡着壁纸上的东西。

       ⚠️ 特意带上 .is-entrance-done.is-collapsed 这一组（4 个类，特异性 0-4-0）：
       光靠 .is-collapsed .is-motion-settled 不够稳 —— 系统开了「减少动态效果」时入场动画是
       none、压根不会有 animationend，卡片就拿不到 is-motion-settled，于是只剩 0-3-0，
       会被同特异性但更靠后的 .is-ready ... { opacity: 1 !important } 反压回去（表现为
       卡片明明移出了屏幕，computed opacity 却还是 1）。
       collapseHomeCard() 必定先加 is-entrance-done 再加 is-collapsed，所以这一组永远命中。 */
    .home-wallpaper-decor.is-collapsed .home-wallpaper-card,
    .home-wallpaper-decor.is-entrance-done.is-collapsed .home-wallpaper-card,
    .home-wallpaper-decor.is-collapsed .home-wallpaper-card.is-motion-settled {
        opacity: 0 !important;
        transform: translate(calc(-50% + var(--home-wallpaper-card-exit-x, 104vw)), -50%) !important;
        pointer-events: none !important;
        transition:
            transform var(--home-wallpaper-collapse-duration, 950ms) cubic-bezier(0.33, 1, 0.68, 1),
            opacity
            calc(var(--home-wallpaper-collapse-duration, 950ms) * 0.5) ease
            calc(var(--home-wallpaper-collapse-duration, 950ms) * 0.32);
    }

    /* 收起后挂在边缘的小竖条（点一下 / 键盘 Enter 把卡片滑回来） */
    .home-wallpaper-card-tab {
        position: absolute;
        top: 50%;
        z-index: 4;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 1.15rem 0.46rem;
        border: 1px solid rgba(255, 249, 239, 0.28);
        color: #fffaf3f5;
        font-family: inherit;
        font-size: 0.74rem;
        font-weight: 700;
        line-height: 1;
        letter-spacing: 0.16em;
        background: rgba(28, 20, 24, 0.55);
        box-shadow: 0 8px 22px #110f133d;
        -webkit-backdrop-filter: blur(9px) saturate(1.05);
        backdrop-filter: blur(9px) saturate(1.05);
        cursor: pointer;
        pointer-events: auto;
        opacity: 0;
        visibility: hidden;
        transform: translate(var(--home-wallpaper-tab-hide-x, -100%), -50%);
        transition:
            opacity 0.3s ease,
            visibility 0s linear 0.3s,
            transform 0.42s var(--home-wallpaper-motion-ease),
            background-color 0.2s ease,
            border-color 0.2s ease;
    }
    .home-wallpaper-decor[data-home-wallpaper-tab-side="left"] .home-wallpaper-card-tab {
        left: 0;
        border-left: 0;
        border-radius: 0 999px 999px 0;
        --home-wallpaper-tab-hide-x: calc(-100% - 0.25rem);
    }
    .home-wallpaper-decor[data-home-wallpaper-tab-side="right"] .home-wallpaper-card-tab {
        right: 0;
        border-right: 0;
        border-radius: 999px 0 0 999px;
        --home-wallpaper-tab-hide-x: calc(100% + 0.25rem);
    }
    .home-wallpaper-card-tab__text {
        display: block;
        writing-mode: vertical-rl;
        text-shadow: 0 1px 7px rgba(18, 17, 22, 0.4);
    }
    /* 指尖那个小方块：和卡片身份行的小方块同色，暗示"点这里展开" */
    .home-wallpaper-card-tab__mark {
        width: 6px;
        height: 6px;
        background: #f2b3bf;
        box-shadow: 0 0 0 2px #ffffff1a;
        transform: rotate(45deg);
        transition: transform 0.3s var(--home-wallpaper-motion-ease);
    }
    /* 等卡片滑出去大半再挂出来（延迟 = 0.55 × 收起时长），两段动作接力而不是同时挤在一起 */
    .home-wallpaper-decor.is-collapsed .home-wallpaper-card-tab {
        opacity: 1;
        visibility: visible;
        transform: translate(var(--home-wallpaper-tab-shift, 0px), -50%);
        transition-delay:
            calc(var(--home-wallpaper-collapse-duration, 950ms) * 0.55),
            calc(var(--home-wallpaper-collapse-duration, 950ms) * 0.55),
            calc(var(--home-wallpaper-collapse-duration, 950ms) * 0.55),
            0s,
            0s;
    }
    .home-wallpaper-decor.is-collapsed .home-wallpaper-card-tab:hover,
    .home-wallpaper-decor.is-collapsed .home-wallpaper-card-tab:focus-visible {
        --home-wallpaper-tab-shift: 0.22rem;
        border-color: rgba(255, 249, 239, 0.48);
        background: rgba(48, 32, 38, 0.62);
    }
    .home-wallpaper-decor.is-collapsed .home-wallpaper-card-tab:hover .home-wallpaper-card-tab__mark,
    .home-wallpaper-decor.is-collapsed
        .home-wallpaper-card-tab:focus-visible
        .home-wallpaper-card-tab__mark {
        transform: rotate(45deg) scale(1.35);
    }
    .home-wallpaper-decor.is-collapsed .home-wallpaper-card-tab:focus-visible {
        outline: 2px solid rgba(255, 236, 170, 0.95);
        outline-offset: 3px;
    }

    /* 卡片右上角的手动收起（×）：跟边缘小竖条同一套毛玻璃，只是缩成一颗圆钮。
       卡片本体 pointer-events: none，所以这里要自己把点击拿回来。 */
    .home-wallpaper-card__close {
        position: absolute;
        top: 0.72rem;
        right: 0.72rem;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 1.75rem;
        height: 1.75rem;
        padding: 0;
        border: 1px solid rgba(255, 249, 239, 0.26);
        border-radius: 999px;
        background: rgba(28, 20, 24, 0.42);
        box-shadow: 0 6px 16px #110f132e;
        -webkit-backdrop-filter: blur(8px) saturate(1.05);
        backdrop-filter: blur(8px) saturate(1.05);
        cursor: pointer;
        pointer-events: auto;
        opacity: 0;
        transition:
            opacity 0.32s ease,
            background-color 0.2s ease,
            border-color 0.2s ease,
            transform 0.3s var(--home-wallpaper-motion-ease);
    }
    /* 等卡片入场落定（1.41s）再淡入，免得跟头像标题一起抢戏 */
    .home-wallpaper-decor.is-ready .home-wallpaper-card__close {
        opacity: 1;
        transition-delay: 1.5s, 0s, 0s, 0s;
    }
    /* 收过一次之后再展开时，× 要立刻回来，别再等 1.5s（选择器多一层，压过上面那条） */
    .home-wallpaper-decor.is-entrance-done .home-wallpaper-card .home-wallpaper-card__close {
        opacity: 1;
        transition-delay: 0s;
    }
    .home-wallpaper-card__close-bar {
        width: 0.72rem;
        height: 1.6px;
        border-radius: 2px;
        background: #fffaf3d9;
    }
    .home-wallpaper-card__close:hover,
    .home-wallpaper-card__close:focus-visible {
        border-color: rgba(255, 249, 239, 0.5);
        background: rgba(70, 44, 52, 0.62);
        transform: scale(1.08);
    }
    .home-wallpaper-card__close:focus-visible {
        outline: 2px solid rgba(255, 236, 170, 0.95);
        outline-offset: 2px;
    }
    /* 收起态顺手把这个钮也关掉：卡片本体虽有 pointer-events: none，
       但子元素 pointer-events: auto 会把它重新打开，别留一颗看不见还能点的按钮 */
    .home-wallpaper-decor.is-collapsed .home-wallpaper-card__close {
        visibility: hidden;
        pointer-events: none;
    }

    /* ========== 贴纸 ========== */
    .home-wallpaper-decor__stickers {
        position: absolute;
        inset: 0;
        z-index: 3;
        pointer-events: none;
    }
    .home-wallpaper-sticker {
        --home-wallpaper-sticker-rotation: 0deg;
        position: absolute;
        display: grid;
        place-items: center;
        width: var(--home-wallpaper-sticker-w, auto);
        min-width: 42px;
        min-height: 42px;
        padding: 0;
        border: 0;
        background: transparent;
        cursor: grab;
        pointer-events: auto;
        touch-action: none;
        user-select: none;
        -webkit-touch-callout: none;
        /* 放回（显示）时的淡入走这里：延迟按序号倒着算，最右边那张先回。
           收起方向的延迟写在 .is-stickers-hidden 那条里 —— CSS 的 transition 取的是
           「变化之后」那条声明，所以两个方向各写各的才不打架。 */
        transition:
            opacity var(--home-wallpaper-sticker-toggle-duration, 340ms) ease
                calc(
                    (var(--home-wallpaper-sticker-count, 11) - 1 - var(--home-wallpaper-sticker-i, 0)) *
                        var(--home-wallpaper-sticker-toggle-stagger, 40ms)
                ),
            visibility 0s linear;
    }
    .home-wallpaper-sticker:active,
    .home-wallpaper-sticker.is-dragging {
        cursor: grabbing;
    }
    .home-wallpaper-sticker--fixed {
        cursor: default;
        pointer-events: none;
    }
    .home-wallpaper-decor.is-ready .home-wallpaper-sticker:not(.home-wallpaper-sticker--fixed) {
        animation: home-wallpaper-sticker-enter 0.76s var(--home-wallpaper-motion-ease) both;
        animation-delay: 0.52s;
    }
    .home-wallpaper-sticker img {
        display: block;
        width: 100%;
        height: auto;
        max-height: 104px;
        object-fit: contain;
        pointer-events: none;
        filter: drop-shadow(0 7px 10px rgba(28, 22, 28, 0.27));
        /* 图片是延迟加载的（脚本才赋 src），到货时淡入，避免直接"啪"地长出来。
           没有 src 时高度是 0，所以这里同时是为了盖住盒子从 0 长到 104px 那一下。 */
        opacity: 0;
        transition: opacity 0.34s var(--home-wallpaper-motion-ease);
    }
    .home-wallpaper-sticker img[src] {
        opacity: 1;
    }
    /* 底部后排贴纸（homeCardConfig 里 bottom >= 12 的那些）：窗口高度不够时整排隐藏，
       否则会顶到卡片底部的导航/社交按钮。手机端不适用（≤767px 由脚本重新排布）。
       ⚠️ 这条只在禁用 JS 时生效：脚本会把整批贴纸压成一行（display 内联覆盖这里），
       免得矮窗口直接少显示 6 张。阈值要和 homeCardConfig 里后排的 bottom: 16 一起改。 */
    @media (min-width: 768px) and (max-height: 940px) {
        .home-wallpaper-sticker--rear {
            display: none;
        }
    }
    .home-wallpaper-sticker--note {
        top: 79%;
        left: 53%;
        width: 84px;
        min-height: 63px;
        padding: 14px 9px 9px;
        color: #6a5430;
        font-size: 0.7rem;
        font-weight: 700;
        line-height: 1.35;
        background: #fff1a8;
        box-shadow: 4px 6px 12px #2d241d33;
        transform: rotate(4deg);
    }
    .home-wallpaper-decor.is-ready .home-wallpaper-sticker--note {
        animation: home-wallpaper-note-enter 0.68s var(--home-wallpaper-motion-ease) both;
        animation-delay: 0.49s;
    }
    .home-wallpaper-sticker--note::before {
        position: absolute;
        top: -7px;
        left: 50%;
        width: 42px;
        height: 13px;
        content: "";
        background: repeating-linear-gradient(-45deg, #87c1a3bf 0 5px, #b1dcbbbd 5px 10px);
        transform: translate(-50%) rotate(4deg);
    }

    /* 中屏 */
    @media (min-width: 768px) and (max-width: 1199px) {
        .home-wallpaper-card {
            width: min(calc(100vw - 1.5rem), 440px);
            padding: 1.65rem 1.45rem 0;
        }
        .home-wallpaper-card h1 {
            font-size: clamp(1.85rem, 5.5vw, 2.8rem);
        }
        .home-wallpaper-card__subtitle {
            margin-top: 0.62rem;
            font-size: 0.84rem;
        }
        .home-wallpaper-card__nav {
            gap: 0.3rem 0.75rem;
            margin-top: 0.85rem;
        }
        .home-wallpaper-card__nav a {
            font-size: 0.72rem;
        }
        .home-wallpaper-card__socials {
            gap: 9px;
            margin-top: 0.88rem;
        }
        .home-wallpaper-card__social-link {
            width: 32px;
            height: 44px;
            padding-bottom: 7px;
            font-size: 0.88rem;
        }
        .home-wallpaper-copy-toast {
            bottom: -3rem;
        }
    }

    /* 移动端：仅显示 mobile 贴纸（由脚本随机投放到四角），便签居中到顶部 */
    @media (max-width: 767px) {
        .home-wallpaper-card {
            width: min(calc(100vw - 2rem), 360px);
            padding: 1.7rem 1rem 0;
        }
        .home-wallpaper-card__avatar {
            border-radius: 13px;
        }
        .home-wallpaper-card__avatar-wrap {
            width: 56px;
            height: 56px;
        }
        .home-wallpaper-card__avatar-sticker {
            top: -0.55rem;
            left: calc(100% - 0.7rem);
        }
        .home-wallpaper-card__identity {
            margin-top: 0.62rem;
            font-size: 0.7rem;
        }
        .home-wallpaper-card h1 {
            font-size: clamp(1.95rem, 10vw, 2.6rem);
        }
        .home-wallpaper-card__subtitle {
            margin-top: 0.6rem;
            font-size: 0.78rem;
        }
        .home-wallpaper-card__nav {
            gap: 0.35rem 0.72rem;
            margin-top: 0.88rem;
        }
        .home-wallpaper-card__nav a {
            font-size: 0.7rem;
        }
        .home-wallpaper-card__socials {
            margin-top: 0.9rem;
        }
        /* 手机端全部贴纸参与布局，宽度统一收缩（位置由脚本按卡片自适应换算） */
        .home-wallpaper-sticker {
            width: clamp(55px, 17.5vw, 80px);
        }
        .home-wallpaper-sticker--note.home-wallpaper-sticker--fixed {
            display: grid;
            inset: 8% auto auto 50% !important;
            width: min(116px, 31vw);
            min-height: 54px;
            padding: 12px 8px 8px;
            font-size: 0.65rem;
            transform: translate(-50%) rotate(4deg);
        }
        .home-wallpaper-decor.is-ready .home-wallpaper-sticker--note {
            animation-name: home-wallpaper-note-enter-mobile;
        }
        .home-wallpaper-card-tab {
            gap: 0.4rem;
            padding: 0.9rem 0.38rem;
            font-size: 0.68rem;
            letter-spacing: 0.12em;
        }
        /* 手机端点按目标放大一点（选择器多挂一层，才压得过后面那条基础样式） */
        .home-wallpaper-decor .home-wallpaper-sticker-toggle {
            right: 0.75rem;
            bottom: 0.75rem;
            width: 2.2rem;
            height: 2.2rem;
            font-size: 0.92rem;
        }
    }

    /* fullscreen 模式豁免：主题对壁纸容器内所有 img 施加了
       width/height 100% + object-fit cover + blur + scale(1.05)（见 layout-styles.css
       html[data-wallpaper-mode="fullscreen"] #wallpaper-wrapper img 等 3 条规则，
       最高特异性 (1,2,2)），会把贴纸图裁切放大并连带模糊。
       这里借助 .home-wallpaper-decor 提升一级特异性至 (1,3,x) 确保覆盖 */
    html[data-wallpaper-mode="fullscreen"] #wallpaper-wrapper .home-wallpaper-decor .home-wallpaper-sticker img,
    html[data-wallpaper-mode="fullscreen"]
        #wallpaper-wrapper
        .home-wallpaper-decor
        img.home-wallpaper-card__avatar-sticker,
    #wallpaper-wrapper.wallpaper-fullscreen .home-wallpaper-decor .home-wallpaper-sticker img,
    #wallpaper-wrapper.wallpaper-fullscreen
        .home-wallpaper-decor
        img.home-wallpaper-card__avatar-sticker {
        width: 100% !important;
        height: auto !important;
        max-height: 104px;
        object-fit: contain !important;
        object-position: center !important;
        filter: none !important;
        opacity: 1 !important;
    }
    /* 场景贴纸图撤销主题 scale；头像贴纸的 transform 走拖拽变量（含 !important 对冲主题的 scale） */
    html[data-wallpaper-mode="fullscreen"] #wallpaper-wrapper .home-wallpaper-decor .home-wallpaper-sticker img,
    #wallpaper-wrapper.wallpaper-fullscreen .home-wallpaper-decor .home-wallpaper-sticker img {
        transform: none !important;
    }
    html[data-wallpaper-mode="fullscreen"]
        #wallpaper-wrapper
        .home-wallpaper-decor
        img.home-wallpaper-card__avatar-sticker,
    #wallpaper-wrapper.wallpaper-fullscreen
        .home-wallpaper-decor
        img.home-wallpaper-card__avatar-sticker {
        transform: translate(var(--avatar-sticker-tx, 0px), var(--avatar-sticker-ty, 0px)) !important;
    }
    /* 卡片头像恢复清晰（保留 100%/cover 尺寸，仅去掉模糊与放大） */
    html[data-wallpaper-mode="fullscreen"] #wallpaper-wrapper .home-wallpaper-decor .home-wallpaper-card__avatar img,
    #wallpaper-wrapper.wallpaper-fullscreen .home-wallpaper-decor .home-wallpaper-card__avatar img {
        filter: none !important;
        transform: none !important;
    }

    /* ========== 右下角：隐藏贴纸开关 ========== */
    /* 错开节奏全在 CSS 里，JS 只切 is-stickers-hidden 这一个类。
       选择器刻意多挂一层 .home-wallpaper-decor__stickers（合计 4 个类）：
       入场动画那条是 (0,4,0)，同特异性就得靠源码顺序，这里放得很靠后所以一定赢；
       也顺带压过 is-motion-settled 与 reduced-motion 里那两条 opacity: 1 !important（都是 (0,3,0)）。
       （!important 的声明优先级高于动画，所以透明度压得住入场动画，不需要再 animation: none。）
       只作用于这一排小人 —— 卡片头像上那张小贴纸在卡片里，不归这里管。

       ⚠️ 这里**故意不写 animation: none**：写了的话，页面加载时就已隐藏的贴纸会被掐掉入场动画，
       于是永远不触发 animationend、拿不到 is-motion-settled；等用户点"放回"时入场动画重新生效
       （0.52s 延迟 + 0.76s），会把右侧先回的级联整个盖掉 —— 表现为"刷新过之后放回没有逐张效果"。
       让它照常跑（看不见而已，11 段很便宜）就能保证两条路径状态一致。 */
    .home-wallpaper-decor.is-stickers-hidden .home-wallpaper-decor__stickers > .home-wallpaper-sticker {
        opacity: 0 !important;
        visibility: hidden;
        pointer-events: none !important;
        transition:
            opacity var(--home-wallpaper-sticker-toggle-duration, 340ms) ease
                calc(var(--home-wallpaper-sticker-i, 0) * var(--home-wallpaper-sticker-toggle-stagger, 40ms)),
            visibility 0s linear
                calc(
                    var(--home-wallpaper-sticker-i, 0) * var(--home-wallpaper-sticker-toggle-stagger, 40ms) +
                        var(--home-wallpaper-sticker-toggle-duration, 340ms)
                );
    }

    /* 开关本体：和卡片右上角那个 − 同一套毛玻璃，尺寸略大一点好点。
       右下角位置是算过的：贴纸那排 bottom: 5%，按钮压在 0.9rem 以内基本只蹭到最右
       那张贴纸盒子底部几像素的透明边，视觉上看不出来。 */
    .home-wallpaper-sticker-toggle {
        position: absolute;
        right: 0.9rem;
        bottom: 0.9rem;
        z-index: 5;
        width: 2rem;
        height: 2rem;
        padding: 0;
        border: 1px solid rgba(255, 249, 239, 0.28);
        border-radius: 999px;
        color: #fffaf3e0;
        font-size: 0.86rem;
        line-height: 1;
        background: rgba(28, 20, 24, 0.46);
        box-shadow: 0 6px 16px #110f132e;
        -webkit-backdrop-filter: blur(9px) saturate(1.05);
        backdrop-filter: blur(9px) saturate(1.05);
        cursor: pointer;
        pointer-events: auto;
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.32s ease,
            visibility 0s linear 0.32s,
            background-color 0.2s ease,
            border-color 0.2s ease,
            transform 0.3s var(--home-wallpaper-motion-ease);
    }
    /* 等贴纸（0.52s + 0.76s = 1.28s）和卡片都落定再露脸，别参与入场抢戏。
       配合 visibility 一起切，未露脸时不会被键盘 Tab 到。 */
    .home-wallpaper-decor.is-ready .home-wallpaper-sticker-toggle {
        opacity: 1;
        visibility: visible;
        transition-delay: 1.6s, 1.6s, 0s, 0s, 0s;
    }
    .home-wallpaper-sticker-toggle__icon {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        transition:
            opacity 0.2s ease,
            transform 0.2s ease;
    }
    .home-wallpaper-sticker-toggle__icon--off {
        opacity: 0;
        transform: scale(0.7);
    }
    .home-wallpaper-decor.is-stickers-hidden .home-wallpaper-sticker-toggle__icon--on {
        opacity: 0;
        transform: scale(0.7);
    }
    .home-wallpaper-decor.is-stickers-hidden .home-wallpaper-sticker-toggle__icon--off {
        opacity: 1;
        transform: scale(1);
    }
    /* 隐藏状态下按钮压暗一点，暗示"有个东西被关掉了" */
    .home-wallpaper-decor.is-stickers-hidden .home-wallpaper-sticker-toggle {
        border-color: rgba(255, 249, 239, 0.18);

---
/**
 * 首页壁纸装饰层：个人卡片（毛玻璃 + 胶带 + 波浪下划线 + 彩色标签）+ 可拖拽贴纸 + 便签。
 * 灵感来自 rainzt.cn（Jarvis0227/Aemeath），为 Firefly 重新实现为独立组件：
 * - 配置见 src/config/homeCardConfig.ts
 * - 挂载点仅 WallpaperSection.astro 中一行，不侵入主题其他文件
 * - 显隐由 CSS 门控（body.is-home + html[data-wallpaper-mode]），Swup 切页无需重新渲染
 * - 贴纸支持按住拖动（Pointer Events，自动限制在壁纸范围内），刷新后恢复初始位置
 */
import { Icon } from "astro-icon/components";
import ImageWrapper from "@/components/common/ImageWrapper.astro";
import { homeCardConfig } from "@/config/homeCardConfig";
import { profileConfig } from "@/config/profileConfig";
import { siteConfig } from "@/config/siteConfig";

const config = homeCardConfig;
const identity = config.identity || profileConfig.name;
const cardTitle = config.title || siteConfig.title;
const subtitle = config.subtitle || profileConfig.bio;

// 场景贴纸基准宽度：px 为上限，随视口宽度/高度按比例缩小
// STICKER_SCALE 整体缩放系数（改这里即全局放大/缩小贴纸）
const STICKER_SCALE = 1.25;
const stickerWidth = (width: number) => {
	const w = width * STICKER_SCALE;
	return `min(${w.toFixed(2)}px, ${(w / 19.2).toFixed(4)}vw, ${(w / 9.125).toFixed(4)}vh)`;
};

// 头像贴纸：只在窄屏时收缩（vw 系数更大）
const avatarStickerWidth = (width: number) =>
	`min(${width}px, ${(width / 4.3333).toFixed(4)}vw)`;

// 贴纸定位：top（距顶）或 bottom（距底，一排贴纸脚踩同一地面线）二选一
// index 会写成 --home-wallpaper-sticker-i，供「整排收起/放回」按序号错开用。
// ⚠️ 必须同时出现在 style 与 data-home-wallpaper-initial-style：拖拽还原是
//    整条 style 覆盖（restoreDesktopStickerPositions），少了就丢。
const stickerStyle = (
	sticker: {
		top?: number;
		bottom?: number;
		left: number;
		rotate: number;
		width: number;
	},
	index: number,
) => {
	const vertical =
		sticker.bottom !== undefined
			? `auto auto ${sticker.bottom}%`
			: `${sticker.top ?? 0}% auto auto`;
	return `inset: ${vertical} ${sticker.left}%; --home-wallpaper-sticker-rotation: ${sticker.rotate}deg; --home-wallpaper-sticker-w: ${stickerWidth(sticker.width)}; --home-wallpaper-sticker-i: ${index};`;
};

const isExternal = (url: string) => url.startsWith("http");

// 入场后自动收起（配置见 homeCardConfig.autoCollapse）
// 收起逻辑整体在客户端，这里只把参数交给 data-* / CSS 变量，服务端不产生额外节点开销。
// 只传「停留多久」一个数：入场动画什么时候跑完由脚本监听 animationend 现算，不在这里写死总时长。
const autoCollapse = config.autoCollapse;
const collapseHold = autoCollapse.enable ? Math.max(0, Math.round(autoCollapse.hold)) : 0;
const collapseOnMobile = autoCollapse.enable && autoCollapse.enableOnMobile;

// 右下角「隐藏贴纸」开关（配置见 homeCardConfig.stickerToggle）
const stickerToggle = config.stickerToggle;
---

{config.enable && (
    <div
        class="home-wallpaper-decor"
        data-home-wallpaper-decor
        data-home-wallpaper-sticker-limit={config.mobileStickerLimit ?? 0}
        data-home-wallpaper-collapse-hold={autoCollapse.enable ? collapseHold : ""}
        data-home-wallpaper-collapse-mobile={collapseOnMobile ? "1" : "0"}
        data-home-wallpaper-card-slide={autoCollapse.slideTo}
        data-home-wallpaper-tab-side={autoCollapse.tabSide}
        style={`--home-wallpaper-collapse-duration: ${autoCollapse.duration}ms; --home-wallpaper-sticker-count: ${config.stickers.length}; --home-wallpaper-sticker-toggle-stagger: ${stickerToggle.stagger}ms; --home-wallpaper-sticker-toggle-duration: ${stickerToggle.duration}ms;`}
    >
        <div
            class="home-wallpaper-decor__stickers"
            aria-hidden="true"
            style={`--home-wallpaper-sticker-count: ${config.stickers.length};`}
        >
            {config.stickers.map((sticker, index) => (
                <div
                    class={`home-wallpaper-sticker${
                        (sticker.bottom ?? 0) >= 12 ? " home-wallpaper-sticker--rear" : ""
                    }`}
                    data-home-wallpaper-sticker
                    style={stickerStyle(sticker, index)}
                    data-home-wallpaper-initial-style={stickerStyle(sticker, index)}
                >
                    {/* 只写 data-home-wallpaper-src，不写 src —— 服务端不产生任何图片请求。
                        真正赋值交给脚本：手机端只给随机抽中的那几张，桌面端等 window.load 之后，
                        免得十几张装饰图跟壁纸（LCP 元素）抢带宽。见 hydrateStickerImages()。 */}
                    <img
                        data-home-wallpaper-src={sticker.src}
                        alt=""
                        draggable="false"
                        decoding="async"
                        referrerpolicy="no-referrer"
                    />
                </div>
            ))}
            {/* 禁用 JS 时上面那批没有 src，这里补一份真实的。
                JS 开启时 noscript 内容是惰性文本，不会被解析成图片、不产生请求。 */}
            <noscript>
                {config.stickers.map((sticker, index) => (
                    <div
                        class={`home-wallpaper-sticker${
                            (sticker.bottom ?? 0) >= 12 ? " home-wallpaper-sticker--rear" : ""
                        }`}
                        style={stickerStyle(sticker, index)}
                    >
                        <img src={sticker.src} alt="" draggable="false" referrerpolicy="no-referrer" />
                    </div>
                ))}
            </noscript>
            {config.note.enable && (
                <div
                    class="home-wallpaper-sticker home-wallpaper-sticker--note home-wallpaper-sticker--fixed"
                    style={`inset: ${config.note.top}% auto auto ${config.note.left}%;`}
                >
                    <span>{config.note.text}</span>
                </div>
            )}
        </div>

        <article id="home-wallpaper-card" class="home-wallpaper-card">
            {/* 右上角手动收起（−）：样式与边缘小竖条同一套毛玻璃。
                用减号不用叉：这按钮是"先把卡片收起来"，不是"永久关掉"，点了还能从边缘小竖条叫回来。 */}
            {autoCollapse.enable && autoCollapse.closeButton && (
                <button
                    type="button"
                    class="home-wallpaper-card__close"
                    data-home-wallpaper-card-close
                    aria-controls="home-wallpaper-card"
                    aria-label="收起卡片"
                >
                    <span class="home-wallpaper-card__close-bar" aria-hidden="true"></span>
                </button>
            )}
            <div class="home-wallpaper-card__content">
                <div class="home-wallpaper-card__avatar-wrap">
                    <div class="home-wallpaper-card__avatar overflow-hidden relative">
                        <ImageWrapper
                            src={profileConfig.avatar ?? ""}
                            alt={`${identity}头像`}
                            class="w-full h-full object-cover"
                            width={256}
                            widths={[128, 256]}
                            sizes="(min-width: 768px) 64px, 56px"
                            loading="eager"
                            position="center"
                        />
                    </div>
                    <img
                        class="home-wallpaper-card__avatar-sticker"
                        data-home-wallpaper-sticker
                        data-home-wallpaper-avatar-sticker
                        src={config.avatarSticker.src}
                        alt=""
                        draggable="false"
                        loading="eager"
                        decoding="async"
                        referrerpolicy="no-referrer"
                        style={`width: ${avatarStickerWidth(config.avatarSticker.width)} !important;`}
                    />
                </div>
                <p class="home-wallpaper-card__identity">
                    <span class="home-wallpaper-card__identity-mark" aria-hidden="true"></span>
                    <span class="home-wallpaper-card__motion-text">{identity}</span>
                </p>
                <h1><span class="home-wallpaper-card__motion-text">{cardTitle}</span></h1>
                <p class="home-wallpaper-card__subtitle">
                    <span class="home-wallpaper-card__motion-text">{subtitle}</span>
                </p>
                <nav class="home-wallpaper-card__nav" aria-label="首页快捷导航">
                    {config.navLinks.map((link) => (
                        <a href={link.url}>
                            <span class="home-wallpaper-card__motion-text">{link.name}</span>
                        </a>
                    ))}
                </nav>
                <div class="home-wallpaper-card__socials" aria-label="社交链接">
                    {config.socials.map((social) => (
                        social.copy ? (
                            <button
                                type="button"
                                class="home-wallpaper-card__social-link"
                                aria-label={social.name}
                                data-home-wallpaper-copy={social.copy}
                            >
                                <span class="home-wallpaper-card__social-icon" aria-hidden="true">
                                    <Icon name={social.icon} />
                                </span>
                            </button>
                        ) : (
                            <a
                                class="home-wallpaper-card__social-link"
                                aria-label={social.name}
                                href={social.url}
                                target={isExternal(social.url ?? "") ? "_blank" : undefined}
                                rel={isExternal(social.url ?? "") ? "me noopener noreferrer" : undefined}
                            >
                                <span class="home-wallpaper-card__social-icon" aria-hidden="true">
                                    <Icon name={social.icon} />
                                </span>
                            </a>
                        )
                    ))}
                </div>
                <div class="home-wallpaper-copy-toast" data-home-wallpaper-copy-toast role="status" aria-live="polite" aria-atomic="true"></div>
            </div>
        </article>

        {/* 收起后挂在边缘的小竖条：点一下 / 键盘 Enter 把卡片滑回来。
            卡片没收起时它是隐藏的（visibility: hidden，不参与键盘 Tab）。 */}
        {autoCollapse.enable && (
            <button
                type="button"
                class="home-wallpaper-card-tab"
                data-home-wallpaper-card-tab
                aria-controls="home-wallpaper-card"
                aria-expanded="false"
                aria-label="展开首页个人卡片"
            >
                <span class="home-wallpaper-card-tab__text">{autoCollapse.tabText}</span>
                <span class="home-wallpaper-card-tab__mark" aria-hidden="true"></span>
            </button>
        )}
        {/* 右下角的贴纸开关：图标画的是"贴纸现在的状态"（眼睛 = 显示中），
            aria-label / title 写的是"点下去会发生什么"，配合 aria-pressed。
            收起 / 放回只切一个类，真正的错开节奏全在 CSS 里（见 is-stickers-hidden）。
            初始状态由脚本读 localStorage 在入场前就补上，所以刷新不会先闪一下贴纸。 */}
        {stickerToggle.enable && (
            <button
                type="button"
                class="home-wallpaper-sticker-toggle"
                data-home-wallpaper-sticker-toggle
                aria-pressed="false"
                aria-label="隐藏贴纸"
                title="隐藏贴纸"
            >
                <span
                    class="home-wallpaper-sticker-toggle__icon home-wallpaper-sticker-toggle__icon--on"
                    aria-hidden="true"
                >
                    <Icon name="fa7-solid:eye" />
                </span>
                <span
                    class="home-wallpaper-sticker-toggle__icon home-wallpaper-sticker-toggle__icon--off"
                    aria-hidden="true"
                >
                    <Icon name="fa7-solid:eye-slash" />
                </span>
            </button>
        )}
    </div>
    )}

<script is:inline data-swup-ignore-script>
    (() => {
        if (window.__homeWallpaperDecorBound) return;
        window.__homeWallpaperDecorBound = true;

        const isMobileLayout = () => window.matchMedia("(max-width: 767px)").matches;

        // 贴纸图片按需加载。服务端只输出 data-home-wallpaper-src（不产生请求），这里再赋 src：
        // - 手机端：只给当前真正显示的那批赋值 —— 抽中的 4 张才下载，其余整页一字节不拉
        // - 桌面端：等 window.load 之后再赋值，避开壁纸（LCP 元素）的关键路径
        // 幂等：已经有 src 的直接跳过，重复调用无副作用。
        const hydrateStickerImages = (decor, onlyVisible = false) => {
            const imgs = [];
            decor
                .querySelectorAll(".home-wallpaper-sticker:not(.home-wallpaper-sticker--fixed)")
                .forEach((sticker) => {
                    if (onlyVisible && sticker.style.display === "none") return;
                    const img = sticker.querySelector("img[data-home-wallpaper-src]");
                    if (!img || img.getAttribute("src")) return;
                    img.setAttribute("src", img.getAttribute("data-home-wallpaper-src"));
                    imgs.push(img);
                });
            if (imgs.length === 0) return Promise.resolve();
            // 等解码完成再返回，调用方才能量到真实高度
            return Promise.all(
                imgs.map((img) =>
                    typeof img.decode === "function"
                        ? img.decode().catch(() => {})
                        : new Promise((resolve) => {
                                img.addEventListener("load", resolve, { once: true });
                                img.addEventListener("error", resolve, { once: true });
                            }),
                ),
            );
        };

        // 桌面端：window.load 之后再放行（load 之前加载会和壁纸抢带宽）
        const scheduleDesktopStickerHydration = (decor) => {
            const run = () => hydrateStickerImages(decor);
            if (document.readyState === "complete") run();
            else window.addEventListener("load", run, { once: true });
        };

        // 手机端贴纸池：从整批场景贴纸里随机抽 limit 张（limit <= 0 表示不限制）。
        // 抽签结果在同一次页面加载内复用——布局会重算多次（load / 定时 / resize），
        // 不缓存这批贴纸会来回跳；刷新页面才会换一批。
        // 注意缓存的是 **贴纸 DOM 元素** 而不是 item 对象：每次布局都会重建 items 数组，
        // 按对象缓存会导致后续几次布局里"抽中的贴纸"对不上，全被判定为不显示。
        let mobilePickedStickers = null;
        const getMobileStickerPool = (list, limit) => {
            if (mobilePickedStickers) {
                const kept = list.filter((item) => mobilePickedStickers.has(item.sticker));
                if (kept.length > 0) return kept;
            }
            const shuffled = [...list];
            for (let i = shuffled.length - 1; i > 0; i -= 1) {
                const j = Math.floor(Math.random() * (i + 1));
                [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
            }
            const take = limit > 0 ? Math.min(limit, shuffled.length) : shuffled.length;
            const picked = shuffled
                .slice(0, Math.max(1, take))
                .sort((a, b) => a.left - b.left);
            mobilePickedStickers = new Set(picked.map((item) => item.sticker));
            return picked;
        };

        // 移动端布局：与桌面端同一套结构（左列 / 右列 / 底部一排），但全部
        // 相对卡片实际位置换算——顶部两张贴在卡片上方两侧，底部五个脚踩
        // 同一条地面线（卡片下方），中间三个在左右两列之间等距分布，
        // 保证任意窄屏都不遮挡卡片内容。
        const applyMobileStickerLayout = (decor) => {
            if (!isMobileLayout()) return;
            const wallpaper = decor.closest("#wallpaper-wrapper") || decor;
            const wallpaperRect = wallpaper.getBoundingClientRect();
            const card = decor.querySelector(".home-wallpaper-card");
            const stickers = [
                ...decor.querySelectorAll(
                    ".home-wallpaper-sticker:not(.home-wallpaper-sticker--fixed)",
                ),
            ];
            if (
                !wallpaperRect.width ||
                !wallpaperRect.height ||
                stickers.length === 0 ||
                !(card instanceof HTMLElement)
            ) {
                return;
            }

            const cardRect = card.getBoundingClientRect();
            const cardTopPct =
                ((cardRect.top - wallpaperRect.top) / wallpaperRect.height) * 100;

            // 解析桌面端初始定位，识别竖向归属（有 top → 卡片上方一行；有 bottom → 卡片下方）。
            // inset 简写交给浏览器解析（临时元素），比正则可靠
            const parseInset = (initial) => {
                const probeEl = document.createElement("div");
                probeEl.style.cssText = initial;
                const top = Number.parseFloat(probeEl.style.top);
                const bottom = Number.parseFloat(probeEl.style.bottom);
                const left = Number.parseFloat(probeEl.style.left);
                return {
                    top: Number.isFinite(top) ? top : undefined,
                    bottom: Number.isFinite(bottom) ? bottom : undefined,
                    left: Number.isFinite(left) ? left : 50,
                };
            };
            const items = stickers.map((sticker) => {
                const initial =
                    sticker.getAttribute("data-home-wallpaper-initial-style") || "";
                return {
                    sticker,
                    ...parseInset(initial),
                };
            });

            const sideMargin = 1.2;
            const usableWidthPct = 100 - sideMargin * 2;
            const topRow = items
                .filter((item) => item.top !== undefined)
                .sort((a, b) => a.left - b.left);
            const bottomRow = items
                .filter((item) => item.bottom !== undefined)
                .sort((a, b) => a.left - b.left);

            // 手机端只随机显示其中一批（数量见 homeCardConfig.mobileStickerLimit），
            // 贴纸再多也不会挤满屏幕；桌面端不受影响，仍全部显示
            const limitRaw = Number.parseInt(decor.dataset.homeWallpaperStickerLimit || "", 10);
            const pool = getMobileStickerPool(bottomRow, Number.isFinite(limitRaw) ? limitRaw : 0);

            const place = (item, horizontal, vertical) => {
                const s = item.sticker;
                s.style.inset = "auto";
                s.style.left = "auto";
                s.style.right = "auto";
                s.style.top = "auto";
                s.style.bottom = "auto";
                if (horizontal.mode === "right") {
                    s.style.right = `${horizontal.value}%`;
                } else {
                    s.style.left = `${horizontal.value}%`;
                }
                if (vertical.mode === "bottom") {
                    s.style.bottom = `${vertical.value}%`;
                } else {
                    s.style.top = `${vertical.value}%`;
                }
            };

            // ——— 底部：先按估算挑尺寸，排完再用实测高度校正行数 ———
            // 贴纸可以无限往上加，手机高度却是固定的，所以这里从大往小试尺寸，
            // 放不下就缩尺寸 / 减行数 / 均匀抽样显示（不留半边空白，也不顶到卡片）。
            const GAP_PX = 8;
            const RATIO = 1.36; // 3:4 素材的 高/宽，仅用于估算，行距随后用渲染高度校准
            const BOTTOM_MARGIN_PCT = 5;
            const bottomMarginPx = (BOTTOM_MARGIN_PCT / 100) * wallpaperRect.height;
            // 贴纸堆叠区上沿不得越过的线：卡片底边往下 40px（社交标签会溢出卡片盒模型，
            // 加上贴纸自身的投影，10px 这种小安全距离实测会被压到），再扣掉地面留白
            const shelfLimitPx = wallpaperRect.bottom - cardRect.bottom - 40 - bottomMarginPx;

            const perRowFor = (sizePx) =>
                Math.max(3, Math.floor(usableWidthPct / ((sizePx / wallpaperRect.width) * 100 + 1.6)));

            const sampleEvenly = (list, total) => {
                const picked = [];
                for (let i = 0; i < total; i += 1) {
                    const index = total === 1 ? 0 : Math.round((i * (list.length - 1)) / (total - 1));
                    if (!picked.includes(list[index])) picked.push(list[index]);
                }
                return picked;
            };

            let plan = null;
            for (const size of [68, 62, 56, 50, 46, 42]) {
                const perRow = perRowFor(size);
                const rows = Math.ceil(pool.length / perRow);
                if (rows * size * RATIO + (rows - 1) * GAP_PX <= shelfLimitPx) {
                    plan = { size, perRow, rows, shown: [...pool] };
                    break;
                }
            }
            if (!plan) {
                // 最小尺寸（42px）都放不下：先用 46px 全上，靠下面的实测校正裁掉多余的行
                const size = 46;
                const perRow = perRowFor(size);
                plan = {
                    size,
                    perRow,
                    rows: Math.ceil(pool.length / perRow),
                    shown: [...pool],
                };
            }

            const applyVisible = (shown) => {
                const visible = new Set([...shown, ...topRow]);
                items.forEach((item) => {
                    const isVisible = visible.has(item);
                    item.sticker.style.display = isVisible ? "" : "none";
                    // 手机端统一尺寸（内联优先级高于媒体查询里的 clamp）
                    if (isVisible) item.sticker.style.width = `${plan.size}px`;
                });
            };
            applyVisible(plan.shown);

            const sizePct = (plan.size / wallpaperRect.width) * 100;
            const estHeightPct = ((plan.size * RATIO) / wallpaperRect.height) * 100;

            const placeBottomRows = (ordered, rowCount, rowHeightPx) => {
                const buckets = Array.from({ length: rowCount }, () => []);
                ordered.forEach((item, index) => buckets[index % rowCount].push(item));
                const stepPct = ((rowHeightPx + GAP_PX) / wallpaperRect.height) * 100;
                buckets.forEach((row, rowIndex) => {
                    const bottomPct = BOTTOM_MARGIN_PCT + stepPct * rowIndex;
                    const slot = usableWidthPct / row.length;
                    row.forEach((item, index) => {
                        place(
                            item,
                            { mode: "left", value: sideMargin + slot * index + (slot - sizePct) / 2 },
                            { mode: "bottom", value: bottomPct },
                        );
                    });
                });
                return buckets;
            };

            const measureRow = (row) => {
                const heights = row
                    .map((item) => item.sticker.getBoundingClientRect().height)
                    .filter((height) => height > 0);
                return heights.length > 0 ? Math.max(...heights) : plan.size * RATIO;
            };

            // 先按估算高度排一次，量出真实高度，再按"最多能放几行"修正
            let buckets = placeBottomRows(plan.shown, plan.rows, plan.size * RATIO);
            const rowHeightPx = measureRow(buckets[0]);
            const maxRows = Math.max(
                1,
                Math.floor((shelfLimitPx - rowHeightPx) / (rowHeightPx + GAP_PX)) + 1,
            );
            if (maxRows < plan.rows) {
                const shown = sampleEvenly(plan.shown, Math.min(plan.shown.length, plan.perRow * maxRows));
                plan = { ...plan, rows: maxRows, shown };
                applyVisible(shown);
                buckets = placeBottomRows(shown, maxRows, rowHeightPx);
            }

            // 顶部一行：贴在卡片上方，底边距卡片顶 3%
            const topYPct = Math.max(1, Math.min(20, cardTopPct - 3 - estHeightPct));
            const spread = (count) => {
                if (count <= 0) return [];
                if (count === 1) return [(100 - sizePct) / 2];
                const usable = 100 - sideMargin * 2 - sizePct;
                return Array.from(
                    { length: count },
                    (_, i) => sideMargin + (usable * i) / (count - 1),
                );
            };
            spread(topRow.length).forEach((leftPct, index) => {
                place(
                    topRow[index],
                    { mode: "left", value: leftPct },
                    { mode: "top", value: topYPct },
                );
            });
        };

        const restoreDesktopStickerPositions = (decor) => {
            if (isMobileLayout()) return;
            decor.querySelectorAll("[data-home-wallpaper-initial-style]").forEach((sticker) => {
                const initialStyle = sticker.getAttribute("data-home-wallpaper-initial-style");
                if (initialStyle) sticker.setAttribute("style", initialStyle);
            });
        };

        // 桌面端矮窗口兜底：卡片底部以下放不下两排贴纸时，CSS（max-height: 940px）
        // 会把后排整排隐藏——但那是把 6 张贴纸直接藏掉，太粗暴。
        // 这里改成把整批贴纸压成一行铺在底部：一行 12 张在 ≥768px 宽度下永远放得下
        // （每张约占 6% 宽），所以一张都不用藏。CSS 那条规则留给禁用 JS 的场景。
        const applyShortViewportStickerLayout = (decor) => {
            const wallpaper = decor.closest("#wallpaper-wrapper") || decor;
            const wallpaperRect = wallpaper.getBoundingClientRect();
            const card = decor.querySelector(".home-wallpaper-card");
            const stickers = [
                ...decor.querySelectorAll(
                    ".home-wallpaper-sticker:not(.home-wallpaper-sticker--fixed)",
                ),
            ];
            if (
                !wallpaperRect.width ||
                !wallpaperRect.height ||
                !(card instanceof HTMLElement) ||
                stickers.length === 0
            ) {
                return;
            }

            const heights = stickers
                .map((sticker) => sticker.getBoundingClientRect().height)
                .filter((height) => height > 0);
            const rowHeight = heights.length > 0 ? Math.max(...heights) : 104;
            // 两边都要换算成「距壁纸底边」再比，否则就是拿距底的值比距顶的值（踩过）
            const rearTopFromBottom = 0.16 * wallpaperRect.height + rowHeight;
            const cardBottomFromBottom =
                wallpaperRect.height - (card.getBoundingClientRect().bottom - wallpaperRect.top);
            // 留 16px 冗余，避免字体/图片加载过程中的测量抖动导致来回切
            if (rearTopFromBottom + 16 <= cardBottomFromBottom) {
                // 两排实测放得下：CSS 那条 940px 阈值偏保守（按卡片固定高度估的），
                // 这里直接把被隐藏的后排放出来，位置沿用服务端渲染的 bottom: 16%
                stickers
                    .filter((sticker) =>
                        sticker.classList.contains("home-wallpaper-sticker--rear"),
                    )
                    .forEach((sticker) => {
                        sticker.style.display = "grid";
                    });
                return;
            }

            const sideMargin = 1.2;
            const widths = stickers.map(
                (sticker) => (sticker.getBoundingClientRect().width / wallpaperRect.width) * 100,
            );
            const widthPct = Math.max(...widths);
            const usable = 100 - sideMargin * 2 - widthPct;
            const step = stickers.length > 1 ? usable / (stickers.length - 1) : 0;

            stickers.forEach((sticker, index) => {
                sticker.style.display = "grid"; // 覆盖 CSS 媒体查询里的整排隐藏
                sticker.style.inset = "auto";
                sticker.style.right = "auto";
                sticker.style.top = "auto";
                sticker.style.left = `${sideMargin + step * index}%`;
                sticker.style.bottom = "5%";
            });
        };

        const bindMobileStickerLayout = (decor) => {
            const mediaQuery = window.matchMedia("(max-width: 767px)");
            const applyLayout = () => {
                if (mediaQuery.matches) {
                    // 同步执行：读 rect 会强制布局，无需 rAF；
                    // rAF 在后台标签页不触发会导致布局不生效
                    applyMobileStickerLayout(decor);
                } else {
                    // 先还原成服务端渲染的两排布局（保证多次调用幂等），再按需压成一行
                    restoreDesktopStickerPositions(decor);
                    applyShortViewportStickerLayout(decor);
                }
            };
            applyLayout();
            // 字体/图片就绪后卡片尺寸才稳定，再校准一次
            window.addEventListener("load", applyLayout);
            window.setTimeout(applyLayout, 400);
            mediaQuery.addEventListener?.("change", (event) => {
                applyLayout();
                // 手机 → 桌面：贴纸池只加载了抽中那几张，补齐剩下的
                if (!event.matches) hydrateStickerImages(decor);
            });
            // 兜底：部分环境（视口仿真等）媒体查询 change 事件不可靠，用 resize 防抖补一层
            let resizeTimer = 0;
            window.addEventListener("resize", () => {
                window.clearTimeout(resizeTimer);
                resizeTimer = window.setTimeout(applyLayout, 120);
            });
        };

        const getDecor = () => document.querySelector(".home-wallpaper-decor");

        // ========== 入场后自动收起 ==========
        // 卡片停一会儿就把位置让给壁纸，只在边缘留一根小竖条；点竖条能把卡片再滑回来。
        //
        // 「只播一次」用内存变量实现，不是 sessionStorage：这个脚本带 data-swup-ignore-script，
        // 只在整页加载时执行一次，而壁纸区在 Swup 容器外不会重渲染 —— 于是
        // 刷新 / 首次进入 → hasAutoCollapsed 为 false，会播；
        // 从文章返回首页 → 脚本没重跑，变量还在，不重播。
        // （用 sessionStorage 反而会把「刷新」也算进同一次会话，和预期相反。）
        let collapseTimer = 0;
        let hasAutoCollapsed = false;

        // 「入场落定」= 这一批入场动画里最后一段结束。只认这几个，别把悬停用的
        // card-text-hover 也算进来 —— 那会让用户鼠标一划就把计时往后顺延。
        const ENTRANCE_ANIMATIONS = [
            "home-wallpaper-card-enter",
            "home-wallpaper-content-enter",
            "home-wallpaper-tag-enter",
            "home-wallpaper-sticker-enter",
            "home-wallpaper-note-enter",
            "home-wallpaper-note-enter-mobile",
        ];

        const getCardTab = (decor) => decor.querySelector("[data-home-wallpaper-card-tab]");
        const getCardClose = (decor) => decor.querySelector("[data-home-wallpaper-card-close]");

        const isAutoCollapseEnabled = (decor) => {
            // 属性存在但为空串 = 配置里 enable 为 false（属性只在这个开关打开时才带值）
            const raw = decor.dataset.homeWallpaperCollapseHold;
            if (raw === undefined || raw === "") return false;
            const hold = Number.parseInt(raw, 10);
            if (!Number.isFinite(hold) || hold < 0) return false;
            // 手机端是否收起由配置决定（data 里是 "1" / "0"）
            if (isMobileLayout() && decor.dataset.homeWallpaperCollapseMobile !== "1") return false;
            return true;
        };

        const collapseHomeCard = (decor) => {
            if (!(decor instanceof HTMLElement) || decor.classList.contains("is-collapsed")) return;
            // 先摘掉卡片自身入场动画的 fill: both 终态 —— 动画的终态优先级高于普通声明，
            // 不摘掉的话下面 transition 改 transform / opacity 根本推不动。
            // 这里强制一次样式计算，好让下一帧的 class 变化能拿到"起始值"并真的走 transition。
            decor.classList.add("is-entrance-done");
            void decor.offsetWidth;
            decor.classList.add("is-collapsed");
            hasAutoCollapsed = true;
            const tab = getCardTab(decor);
            if (tab instanceof HTMLElement) tab.setAttribute("aria-expanded", "false");
        };

        const expandHomeCard = (decor) => {
            if (!(decor instanceof HTMLElement) || !decor.classList.contains("is-collapsed")) return;
            window.clearTimeout(collapseTimer);
            decor.classList.remove("is-collapsed");
            const tab = getCardTab(decor);
            if (tab instanceof HTMLElement) tab.setAttribute("aria-expanded", "true");
        };

        const getCollapseHold = (decor) => {
            const hold = Number.parseInt(decor.dataset.homeWallpaperCollapseHold || "", 10);
            return Number.isFinite(hold) ? hold : 0;
        };

        const scheduleCollapse = (decor, hold) => {
            window.clearTimeout(collapseTimer);
            collapseTimer = window.setTimeout(() => {
                if (decor.isConnected) collapseHomeCard(decor);
            }, hold);
        };

        const bindHomeCardCollapse = (decor) => {
            if (!(decor instanceof HTMLElement)) return;

            const tab = getCardTab(decor);
            if (tab instanceof HTMLElement && tab.dataset.tabBound !== "true") {
                tab.dataset.tabBound = "true";
                tab.addEventListener("click", () => expandHomeCard(decor));
            }

            // 右上角那个 − ：手动提前收起，顺手把还没到点的自动收起定时器掐掉
            const closeButton = getCardClose(decor);
            if (closeButton instanceof HTMLElement && closeButton.dataset.closeBound !== "true") {
                closeButton.dataset.closeBound = "true";
                closeButton.addEventListener("click", () => {
                    window.clearTimeout(collapseTimer);
                    collapseHomeCard(decor);
                });
            }

            if (!isAutoCollapseEnabled(decor)) return;
            // 本次加载已经收过一次（swup 返回首页）：保持收起状态，不重新计时
            if (hasAutoCollapsed) return;
            if (decor.dataset.collapseScheduled === "true") return;
            decor.dataset.collapseScheduled = "true";

            // 先按「卡片此刻已经亮着」起算。只要入场动画在跑，下面每次 animationend 都会往后
            // 顺延一次，最终落点 = 最后一个入场动画结束 + hold —— 所以配置里只写「停留多久」，
            // 不用写「从入场开始算」的总时长，改入场动画节奏也不必回来改这个数。
            scheduleCollapse(decor, getCollapseHold(decor));
            decor.addEventListener("animationend", (event) => {
                if (!(event.target instanceof HTMLElement)) return;
                if (!ENTRANCE_ANIMATIONS.includes(event.animationName)) return;
                if (hasAutoCollapsed) return;
                scheduleCollapse(decor, getCollapseHold(decor));
            });
        };

        // 入场动画：立刻加 is-ready 放行文字动画；卡片图片单独走 is-media-ready 淡入。
        // 早期实现会先等 .home-wallpaper-card 内的图片加载完再加 is-ready，
        // 但那会把卡片标题（LCP 元素）的入场一并拖到图片下载完成之后（实测可达数百毫秒甚至数秒）。
        // 现在文字与图片解耦：文字不等图，图片就绪后自己淡入。
        const revealDecor = (decor, replay = false) => {
            if (!(decor instanceof HTMLElement)) return;
            if (replay) {
                decor.classList.remove("is-ready");
                decor.querySelectorAll(".is-motion-settled").forEach((element) => {
                    element.classList.remove("is-motion-settled");
                });
                void decor.offsetWidth;
            } else if (decor.dataset.revealBound === "true") {
                return;
            }
            decor.dataset.revealBound = "true";
            if (decor.dataset.motionCleanupBound !== "true") {
                decor.dataset.motionCleanupBound = "true";
                decor.addEventListener("animationend", (event) => {
                    if (
                        event.target instanceof HTMLElement &&
                        event.animationName.startsWith("home-wallpaper-")
                    ) {
                        event.target.classList.add("is-motion-settled");
                    }
                });
            }

            // 文字动画不等图片：连读两帧 rAF，确保 is-ready 在首帧后尽快落地
            window.requestAnimationFrame(() => {
                window.requestAnimationFrame(() => {
                    if (decor.isConnected) decor.classList.add("is-ready");
                });
            });

            // 图片独立就绪通道：只影响图片自身的淡入，不再门控文字
            const images = [...decor.querySelectorAll(".home-wallpaper-card img")];
            if (images.length > 0) {
                const markMediaReady = () => {
                    if (decor.isConnected) decor.classList.add("is-media-ready");
                };
                const waitForImage = (image) => {
                    if (image.complete) return Promise.resolve();
                    return new Promise((resolve) => {
                        let settled = false;
                        const finish = () => {
                            if (settled) return;
                            settled = true;
                            resolve();
                        };
                        image.addEventListener("load", finish, { once: true });
                        image.addEventListener("error", finish, { once: true });
                        // 兜底：图片迟迟不来也要放行，避免图片永久停在未就绪态
                        window.setTimeout(finish, 1200);
                    });
                };
                Promise.all(images.map(waitForImage)).then(markMediaReady);
            }
        };

        // 壁纸区在 Swup 容器外，切页不重渲染；返回首页时（body.is-home 变化）重播入场动画
        const bindHomeReturnReplay = () => {
            if (document.body.dataset.homeDecorReplayBound === "true") return;
            document.body.dataset.homeDecorReplayBound = "true";
            let wasHome = document.body.classList.contains("is-home");
            const observer = new MutationObserver(() => {
                const isHome = document.body.classList.contains("is-home");
                if (isHome && !wasHome) {
                    const decor = getDecor();
                    // 卡片已自动收起时不重播入场：让它保持收起，只留边缘小竖条
                    if (decor && !decor.classList.contains("is-collapsed")) revealDecor(decor, true);
                }
                wasHome = isHome;
            });
            observer.observe(document.body, { attributes: true, attributeFilter: ["class"] });

            // 运行时初始化时会用「当前模式」调用一次 applyWallpaperMode()，
            // 而它内部是无条件派发 wallpaperModeChange 的（setting-utils.ts），
            // 所以那次派发并不代表「模式变了」。用 lastMode 记住已生效的模式，
            // 只有真正切换时才重播——否则首屏会白白多播一次入场动画，
            // 表现是头像 / 副标题 / 导航先消失再淡入一次。
            let lastMode = document.documentElement.getAttribute(
                "data-wallpaper-mode",
            );

            window.addEventListener("wallpaperModeChange", (event) => {
                const mode = event.detail?.mode;
                if (!mode) return;
                // 首次派发（或与已生效模式相同）视为初始化，不重播
                const isInit = lastMode === null || mode === lastMode;
                lastMode = mode;
                if (isInit) return;

                if (
                    (mode === "banner" || mode === "fullscreen") &&
                    document.body.classList.contains("is-home")
                ) {
                    const decor = getDecor();
                    // 同上：已收起就不重播，免得卡片又闪回来
                    if (decor && !decor.classList.contains("is-collapsed")) revealDecor(decor, true);
                }
            });
        };

        const bindHomeWallpaperStickers = () => {
            const decor = getDecor();
            if (!decor || decor.getAttribute("data-stickers-bound") === "true") return;
            decor.setAttribute("data-stickers-bound", "true");
            bindMobileStickerLayout(decor);
            revealDecor(decor);
            bindHomeReturnReplay();

            // 贴纸图片按需加载（服务端没输出 src）。手机端此时 display 已经定好，
            // 只加载抽中的那几张；解码完再重排一次 —— 那时才量得到真实行高。
            if (isMobileLayout()) {
                hydrateStickerImages(decor, true).then(() => {
                    if (isMobileLayout() && decor.isConnected) applyMobileStickerLayout(decor);
                });
            } else {
                scheduleDesktopStickerHydration(decor);
            }

            const wallpaper = decor.closest("#wallpaper-wrapper") || decor;
            const stickers = decor.querySelectorAll("[data-home-wallpaper-sticker]");

            stickers.forEach((sticker) => {
                if (sticker.dataset.dragBound === "true") return;
                sticker.dataset.dragBound = "true";
                let dragState = null;
                const isAvatarSticker = sticker.hasAttribute("data-home-wallpaper-avatar-sticker");

                sticker.addEventListener("pointerdown", (event) => {
                    if (event.button !== 0 && event.pointerType !== "touch") return;
                    if (sticker.classList.contains("home-wallpaper-sticker--fixed")) return;

                    const wallpaperRect = wallpaper.getBoundingClientRect();
                    const stickerRect = sticker.getBoundingClientRect();
                    const baseTranslateX =
                        Number.parseFloat(sticker.getAttribute("data-home-wallpaper-drag-x") || "0") || 0;
                    const baseTranslateY =
                        Number.parseFloat(sticker.getAttribute("data-home-wallpaper-drag-y") || "0") || 0;
                    dragState = {
                        startX: event.clientX,
                        startY: event.clientY,
                        isAvatarSticker,
                        left: stickerRect.left - wallpaperRect.left,
                        top: stickerRect.top - wallpaperRect.top,
                        maxLeft: Math.max(0, wallpaperRect.width - stickerRect.width),
                        maxTop: Math.max(0, wallpaperRect.height - stickerRect.height),
                        translateX: baseTranslateX,
                        translateY: baseTranslateY,
                    };

                    sticker.setPointerCapture?.(event.pointerId);
                    sticker.classList.add("is-dragging");
                    if (!isAvatarSticker) {
                        sticker.style.left = `${dragState.left}px`;
                        sticker.style.top = `${dragState.top}px`;
                        sticker.style.right = "auto";
                        sticker.style.bottom = "auto";
                    }
                    sticker.style.zIndex = "8";
                });

                sticker.addEventListener("pointermove", (event) => {
                    if (!dragState) return;
                    event.preventDefault();
                    if (dragState.isAvatarSticker) {
                        dragState.translateX = dragState.translateX + event.clientX - dragState.startX;
                        dragState.translateY = dragState.translateY + event.clientY - dragState.startY;
                        dragState.startX = event.clientX;
                        dragState.startY = event.clientY;
                        // 写 CSS 变量而非 style.transform：fullscreen 下主题对 img 的
                        // transform: scale(1.05) !important 会压过内联 transform
                        sticker.style.setProperty("--avatar-sticker-tx", `${dragState.translateX}px`);
                        sticker.style.setProperty("--avatar-sticker-ty", `${dragState.translateY}px`);
                        return;
                    }
                    const nextLeft = Math.min(
                        dragState.maxLeft,
                        Math.max(0, dragState.left + event.clientX - dragState.startX),
                    );
                    const nextTop = Math.min(
                        dragState.maxTop,
                        Math.max(0, dragState.top + event.clientY - dragState.startY),
                    );
                    sticker.style.left = `${nextLeft}px`;
                    sticker.style.top = `${nextTop}px`;
                });

                const stopDragging = (event) => {
                    if (!dragState) return;
                    if (sticker.hasPointerCapture?.(event.pointerId)) {
                        sticker.releasePointerCapture?.(event.pointerId);
                    }
                    if (dragState.isAvatarSticker) {
                        sticker.setAttribute("data-home-wallpaper-drag-x", String(dragState.translateX));
                        sticker.setAttribute("data-home-wallpaper-drag-y", String(dragState.translateY));
                    }
                    dragState = null;
                    sticker.classList.remove("is-dragging");
                    sticker.style.zIndex = "";
                };

                sticker.addEventListener("pointerup", stopDragging);
                sticker.addEventListener("pointercancel", stopDragging);
                // 阻止 iOS 长按弹出的图片菜单干扰拖拽
                sticker.addEventListener("contextmenu", (event) => event.preventDefault());
            });
        };

        const bindHomeWallpaperCopyLinks = () => {
            const decor = getDecor();
            if (!(decor instanceof HTMLElement) || decor.dataset.copyBound === "true") return;
            const copyLinks = decor.querySelectorAll("[data-home-wallpaper-copy]");
            const toast = decor.querySelector("[data-home-wallpaper-copy-toast]");
            if (!(toast instanceof HTMLElement) || copyLinks.length === 0) return;

            decor.dataset.copyBound = "true";
            let toastTimer = 0;

            const showToast = (message, isError = false) => {
                toast.textContent = message;
                toast.classList.toggle("is-error", isError);
                toast.classList.add("is-visible");
                window.clearTimeout(toastTimer);
                toastTimer = window.setTimeout(() => {
                    toast.classList.remove("is-visible");
                }, 1800);
            };

            const fallbackCopy = (value) => {
                const input = document.createElement("textarea");
                input.value = value;
                input.setAttribute("readonly", "");
                input.style.position = "fixed";
                input.style.top = "-9999px";
                input.style.left = "-9999px";
                input.style.opacity = "0";
                document.body.appendChild(input);
                input.focus();
                input.select();
                let copied = false;
                try {
                    copied = document.execCommand("copy");
                } catch {
                    copied = false;
                }
                input.remove();
                return copied;
            };

            copyLinks.forEach((copyLink) => {
                if (copyLink.dataset.copyBound === "true") return;
                copyLink.dataset.copyBound = "true";
                copyLink.addEventListener("click", async (event) => {
                    event.preventDefault();
                    const value = copyLink.getAttribute("data-home-wallpaper-copy")?.trim();
                    if (!value) {
                        showToast("复制失败，请手动复制", true);
                        return;
                    }
                    let copied = false;
                    if (navigator.clipboard?.writeText) {
                        try {
                            await navigator.clipboard.writeText(value);
                            copied = true;
                        } catch {
                            copied = false;
                        }
                    }
                    if (!copied) copied = fallbackCopy(value);
                    showToast(copied ? "已复制" : "复制失败，请手动复制", !copied);
                });
            });
        };

        // ========== 右下角：贴纸开关 ==========
        // JS 只切 is-stickers-hidden 一个类，错开节奏全在 CSS（按 --home-wallpaper-sticker-i）。
        // 状态存 localStorage，刷新 / 切页 / 从文章返回都记得住。
        const STICKERS_HIDDEN_KEY = "homeWallpaperStickersHidden";

        const readStickersHidden = () => {
            try {
                return window.localStorage.getItem(STICKERS_HIDDEN_KEY) === "1";
            } catch {
                // 隐私模式读不了就当没隐藏
                return false;
            }
        };

        const applyStickersHidden = (decor, hidden) => {
            decor.classList.toggle("is-stickers-hidden", hidden);
            const toggle = decor.querySelector("[data-home-wallpaper-sticker-toggle]");
            if (toggle instanceof HTMLElement) {
                const label = hidden ? "显示贴纸" : "隐藏贴纸";
                toggle.setAttribute("aria-pressed", hidden ? "true" : "false");
                toggle.setAttribute("aria-label", label);
                toggle.title = label;
            }
        };

        const bindStickerToggle = (decor) => {
            if (!(decor instanceof HTMLElement)) return;
            const toggle = decor.querySelector("[data-home-wallpaper-sticker-toggle]");
            if (!(toggle instanceof HTMLElement)) return;

            if (toggle.dataset.toggleBound !== "true") {
                toggle.dataset.toggleBound = "true";
                toggle.addEventListener("click", () => {
                    const hidden = !decor.classList.contains("is-stickers-hidden");
                    applyStickersHidden(decor, hidden);
                    try {
                        window.localStorage.setItem(STICKERS_HIDDEN_KEY, hidden ? "1" : "0");
                    } catch {
                        // 写不进去就不记状态，当次开关照常生效
                    }
                });
            }

            // 每次 bind 都回写：一来切页后状态能对上，二来 bindAll 在放行 is-ready 的 rAF
            // 之前就执行，所以刷新时"已隐藏"会在入场动画开跑前贴上，不会先闪一下贴纸。
            applyStickersHidden(decor, readStickersHidden());
        };

        const bindAll = () => {
            bindHomeWallpaperStickers();
            bindHomeWallpaperCopyLinks();
            const decor = getDecor();
            bindHomeCardCollapse(decor);
            bindStickerToggle(decor);
        };
        bindAll();
        // 壁纸区在 Swup 容器外理论上只渲染一次，这里防御性重绑（内部均有去重标记）
        document.addEventListener("swup:page:view", bindAll);
        document.addEventListener("astro:page-load", bindAll);
    })();
</script>


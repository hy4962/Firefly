---
/**
 * 博客更新日志页面主体（参考 rainzt.cn 的 blog-changelog 结构重制）
 * 结构：hero 统计卡 + 返回导航 + 按日倒序时间线（日期列 / 圆点轴 / 卡片）
 * 每个条目：版本徽章 + kind 短语 + h2 标题 + 总结 + <details> 折叠明细 + 标签
 * 所有样式自包含，CSS 变量复用 Firefly 主题（--line-divider 等），合并上游安全。
 * 数据来自 src/config/blogChangelogConfig.ts
 *
 * 分页（V1.6）：本组件是纯展示组件，分页数据由路由层 src/pages/blog-changelog/[...page].astro
 * 用 getStaticPaths() 生成真实静态路由后传入，详见该文件的注释。
 * 详情的默认展开态由 JS 处理（见文件末尾脚本）——仅最新一期展开，其余收起。
 */
import type { ChangelogEntry } from "@/config/blogChangelogConfig";

interface Props {
	/** 当前页要渲染的条目（已由路由层切好片） */
	entries: ChangelogEntry[];
	/** 全量条目，用于 hero 统计（不随分页变化） */
	allEntries: ChangelogEntry[];
	/** 每页更新日数量 */
	pageSize: number;
	/** 当前页码，从 1 开始 */
	currentPage: number;
	/** 总页数 */
	totalPages: number;
}

const { entries, allEntries, pageSize, currentPage, totalPages } =
	Astro.props;

const totalItems = allEntries.reduce((sum, entry) => sum + entry.items.length, 0);
const totalEntries = allEntries.length;
const pageStart = (currentPage - 1) * pageSize;

const formatDate = (date: string) => {
	const d = new Date(`${date}T00:00:00`);
	return `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
};

// 时间跨度按全量数据算（hero 是整站统计，不随分页变化）
const dateSpan = totalEntries
	? `${allEntries[totalEntries - 1].date.slice(2, 7).replace("-", ".")}—${allEntries[0].date.slice(2, 7).replace("-", ".")}`
	: "—";
// 当前版本 = 全量数组第一项
const currentVersion = allEntries[0]?.version ?? "V1.0";

// --- 分页链接：第 1 页用干净路径，其余用 /blog-changelog/N/ 静态路由 ---
const pageHref = (page: number) =>
	page === 1 ? "/blog-changelog/" : `/blog-changelog/${page}/`;

// 页码按钮列表（页数少时全列，多时用省略号收窄）
type PageToken = number | "gap";
const pageTokens: PageToken[] = (() => {
	if (totalPages <= 7) {
		return Array.from({ length: totalPages }, (_, i) => i + 1);
	}
	const tokens: PageToken[] = [1];
	if (currentPage > 3) tokens.push("gap");
	for (
		let p = Math.max(2, currentPage - 1);
		p <= Math.min(totalPages - 1, currentPage + 1);
		p++
	) {
		tokens.push(p);
	}
	if (currentPage < totalPages - 2) tokens.push("gap");
	tokens.push(totalPages);
	return tokens;
})();

const rangeFrom = totalEntries === 0 ? 0 : pageStart + 1;
const rangeTo = pageStart + entries.length;

// kind 徽章配色（按条目顺序循环）
const KIND_VARIANTS = ["blue", "mint", "gold", "violet"] as const;
const kindVariant = (index: number) =>
	KIND_VARIANTS[index % KIND_VARIANTS.length];
---

<div class="blog-changelog-page">
    <header class="blog-changelog-hero card-base">
        <div class="blog-changelog-hero__topline">
            <div class="blog-changelog-kicker">
                <span></span><span>BLOG CHANGELOG</span><span>/</span><span>PUBLIC RECORD</span>
            </div>
        </div>
        <div class="blog-changelog-hero__main">
            <div class="blog-changelog-hero__copy">
                <h1 id="blog-changelog-title">博客日志</h1>
                <p class="blog-changelog-hero__lead">这里记录这个博客从上线、写作到页面迭代的每一个重要节点，每一次都按真实改动整理，展开即可查看完整变更说明。</p>
                <p class="blog-changelog-hero__rule">版本规则：Major 代表结构级升级 · Minor 代表新功能 · Patch 代表修复、内容与维护</p>
            </div>
            <div class="blog-changelog-stats" aria-label="博客更新日志统计">
                <span><strong>{currentVersion}</strong><small>当前版本</small></span>
                <span><strong>{totalEntries}</strong><small>个更新日</small></span>
                <span><strong>{totalItems}</strong><small>条详细记录</small></span>
                <span><strong>{dateSpan}</strong><small>时间跨度</small></span>
            </div>
        </div>
    </header>

    <nav class="blog-changelog-nav card-base" aria-label="日志页面导航">
        <a href="/about/" class="blog-changelog-nav__back">
            <svg width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                <path fill="currentColor" d="m7.825 13l4.9 4.9q.3.3.288.7t-.313.7q-.3.275-.7.288t-.7-.288l-6.6-6.6q-.15-.15-.213-.325T4.426 12t.063-.375t.212-.325l6.6-6.6q.275-.275.688-.275t.712.275q.3.3.3.713t-.3.712L7.825 11H19q.425 0 .713.288T20 12t-.288.713T19 13z"/>
            </svg>
            关于我
        </a>
        <span>按日倒序 · 建站以来{totalPages > 1 ? ` · 第 ${currentPage} / ${totalPages} 页` : ""}</span>
    </nav>

    <ol class="blog-changelog-list">
        {entries.map((entry, entryIndex) => (
            <li class="blog-changelog-entry" id={`blog-changelog-${entry.version.toLowerCase().replace(/\./g, "-")}`}>
                <div class="blog-changelog-date">
                    <time datetime={entry.date}>{formatDate(entry.date)}</time>
                    <span>第 {totalEntries - pageStart - entryIndex} 次记录</span>
                </div>
                <div class="blog-changelog-rail" aria-hidden="true">
                    <span></span>
                </div>
                <article class={`blog-changelog-card blog-changelog-card--${kindVariant(entryIndex)}`}>
                    <header class="blog-changelog-card__header">
                        <div class="blog-changelog-card__meta">
                            <div class="blog-changelog-card__labels">
                                <span class="blog-changelog-version">{entry.version}</span>
                                <span class={`blog-changelog-kind blog-changelog-kind--${kindVariant(entryIndex)}`}>{entry.title}</span>
                            </div>
                            <span>{entry.items.length} 条记录</span>
                        </div>
                        <h2>{entry.summary}</h2>
                        <p>{entry.description}</p>
                    </header>
                    {/* 默认展开态交给 JS 控制：仅最新一期展开，其余收起（见文件末尾脚本） */}
                    <details class="blog-changelog-details" data-changelog-details>
                        <summary>
                            <span>查看当天详细记录</span>
                            <svg width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                                <path fill="currentColor" d="M11.625 14.913q-.175-.063-.325-.213l-4.6-4.6q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l3.9 3.9l3.9-3.9q.275-.275.7-.275t.7.275t.275.7t-.275.7l-4.6 4.6q-.15.15-.325.213t-.375.062t-.375-.062"/>
                            </svg>
                        </summary>
                        <div class="blog-change-points">
                            <div class="blog-change-points__column">
                                {entry.items.filter((_, i) => i % 2 === 0).map((item, i) => (
                                    <details class="blog-change-point" open style={`--point-order: ${i * 2};`}>
                                        <summary>
                                            <span class="blog-change-point__number">{String(i * 2 + 1).padStart(2, "0")}</span>
                                            <strong>{item.category} · 具体变更</strong>
                                            <svg width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                                                <path fill="currentColor" d="M11.625 14.913q-.175-.063-.325-.213l-4.6-4.6q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l3.9 3.9l3.9-3.9q.275-.275.7-.275t.7.275t.275.7t-.275.7l-4.6 4.6q-.15.15-.325.213t-.375.062t-.375-.062"/>
                                            </svg>
                                        </summary>
                                        <div class="blog-change-point__body">
                                            <p>{item.text}</p>
                                        </div>
                                    </details>
                                ))}
                            </div>
                            <div class="blog-change-points__column">
                                {entry.items.filter((_, i) => i % 2 === 1).map((item, i) => (
                                    <details class="blog-change-point" open style={`--point-order: ${i * 2 + 1};`}>
                                        <summary>
                                            <span class="blog-change-point__number">{String(i * 2 + 2).padStart(2, "0")}</span>
                                            <strong>{item.category} · 具体变更</strong>
                                            <svg width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                                                <path fill="currentColor" d="M11.625 14.913q-.175-.063-.325-.213l-4.6-4.6q-.275-.275-.275-.7t.275-.7t.7-.275t.7.275l3.9 3.9l3.9-3.9q.275-.275.7-.275t.7.275t.275.7t-.275.7l-4.6 4.6q-.15.15-.325.213t-.375.062t-.375-.062"/>
                                            </svg>
                                        </summary>
                                        <div class="blog-change-point__body">
                                            <p>{item.text}</p>
                                        </div>
                                    </details>
                                ))}
                            </div>
                        </div>
                    </details>
                    <div class="blog-changelog-tags" aria-label="更新标签">
                        {entry.tags.map((tag) => <span>{tag}</span>)}
                    </div>
                </article>
            </li>
        ))}
    </ol>

    {totalPages > 1 && (
        <nav class="blog-changelog-pager card-base" aria-label="日志分页导航">
            <div class="blog-changelog-pager__info">
                共 {totalEntries} 个更新日 · 每页 {pageSize} 期 · 当前显示第 {rangeFrom}–{rangeTo} 期
            </div>
            <ul class="blog-changelog-pager__list">
                <li>
                    {currentPage > 1 ? (
                        <a
                            class="blog-changelog-pager__step"
                            href={pageHref(currentPage - 1)}
                            rel="prev"
                            aria-label="上一页"
                        >
                            <svg width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                                <path fill="currentColor" d="M14.175 11l-4.9-4.9q-.3-.3-.288-.7t.313-.7q.3-.275.7-.288t.7.288l6.6 6.6q.15.15.213.325t.062.375t-.062.375t-.213.325l-6.6 6.6q-.275.275-.688.275t-.712-.275q-.3-.3-.3-.713t.3-.712L14.175 13H3q-.425 0-.712-.288T2 12t.288-.712T3 11z"/>
                            </svg>
                            上一页
                        </a>
                    ) : (
                        <span class="blog-changelog-pager__step blog-changelog-pager__step--disabled" aria-disabled="true">
                            <svg width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                                <path fill="currentColor" d="M14.175 11l-4.9-4.9q-.3-.3-.288-.7t.313-.7q.3-.275.7-.288t.7.288l6.6 6.6q.15.15.213.325t.062.375t-.062.375t-.213.325l-6.6 6.6q-.275.275-.688.275t-.712-.275q-.3-.3-.3-.713t.3-.712L14.175 13H3q-.425 0-.712-.288T2 12t.288-.712T3 11z"/>
                            </svg>
                            上一页
                        </span>
                    )}
                </li>
                {pageTokens.map((token) =>
                    token === "gap" ? (
                        <li class="blog-changelog-pager__gap" aria-hidden="true">…</li>
                    ) : (
                        <li>
                            {token === currentPage ? (
                                <span class="blog-changelog-pager__num blog-changelog-pager__num--current" aria-current="page">{token}</span>
                            ) : (
                                <a class="blog-changelog-pager__num" href={pageHref(token)}>{token}</a>
                            )}
                        </li>
                    ),
                )}
                <li>
                    {currentPage < totalPages ? (
                        <a
                            class="blog-changelog-pager__step"
                            href={pageHref(currentPage + 1)}
                            rel="next"
                            aria-label="下一页"
                        >
                            下一页
                            <svg width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                                <path fill="currentColor" d="m9.825 13l4.9 4.9q.3.3.288.7t-.313.7q-.3.275-.7.288t-.7-.288l-6.6-6.6q-.15-.15-.213-.325T6.426 12t.063-.375t.212-.325l6.6-6.6q.275-.275.688-.275t.712.275q.3.3.3.713t-.3.712L9.825 11H21q.425 0 .713.288T22 12t-.288.713T21 13z"/>
                            </svg>
                        </a>
                    ) : (
                        <span class="blog-changelog-pager__step blog-changelog-pager__step--disabled" aria-disabled="true">
                            下一页
                            <svg width="1em" height="1em" viewBox="0 0 24 24" aria-hidden="true">
                                <path fill="currentColor" d="m9.825 13l4.9 4.9q.3.3.288.7t-.313.7q-.3.275-.7.288t-.7-.288l-6.6-6.6q-.15-.15-.213-.325T6.426 12t.063-.375t.212-.325l6.6-6.6q.275-.275.688-.275t.712.275q.3.3.3.713t-.3.712L9.825 11H21q.425 0 .713.288T22 12t-.288.713T21 13z"/>
                            </svg>
                        </span>
                    )}
                </li>
            </ul>
        </nav>
    )}
</div>

<script>
    /**
     * 详情块的默认展开态：只有「最新一期」默认展开，其余收起。
     * 不写成服务端 open 属性，是因为要跟随当前页自适应：
     * 第 1 页展开最新一期，翻到第 2 页就展开当页第一个，不会出现整页全展开。
     */
    const openLatest = () => {
        const all = document.querySelectorAll<HTMLDetailsElement>(
            ".blog-changelog-details[data-changelog-details]",
        );
        all.forEach((el, i) => {
            el.open = i === 0;
        });
    };

    // 用 sessionStorage 记住用户在本页手动展开过，Swup 返回时不要清掉
    const STORAGE_KEY = "blog-changelog-manual-open";

    const run = () => {
        const manuallyOpened =
            sessionStorage.getItem(STORAGE_KEY) === "1";
        if (!manuallyOpened) openLatest();

        document
            .querySelectorAll<HTMLDetailsElement>(
                ".blog-changelog-details[data-changelog-details]",
            )
            .forEach((el) => {
                el.addEventListener("toggle", () => {
                    // 忽略脚本首次设定的那次
                    if (el.dataset.initialized === "1") {
                        sessionStorage.setItem(STORAGE_KEY, "1");
                    } else {
                        el.dataset.initialized = "1";
                    }
                });
            });
    };

    run();

    // Swup 换页后重新执行（普通跳转时无副作用）
    document.addEventListener("swup:page:view", () => {
        sessionStorage.removeItem(STORAGE_KEY);
        run();
    });
</script>

<style is:global>
    .blog-changelog-page {
        width: 100%;
        max-width: 72rem;
        margin: 0 auto;
        padding-bottom: 1rem;
    }

    /* ===== hero ===== */
    .blog-changelog-hero {
        padding: clamp(1.1rem, 2.4vw, 2rem);
        border: 1px solid var(--line-divider);
        background-color: var(--card-bg) !important;
    }

    .blog-changelog-hero__topline,
    .blog-changelog-kicker,
    .blog-changelog-nav,
    .blog-changelog-stats,
    .blog-changelog-card__meta,
    .blog-changelog-details summary {
        display: flex;
        align-items: center;
    }

    .blog-changelog-hero__topline {
        justify-content: space-between;
        gap: 1rem;
    }

    .blog-changelog-hero__main {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(15rem, 21rem);
        align-items: end;
        gap: clamp(1.5rem, 4vw, 3.5rem);
        margin-top: 0.9rem;
    }

    .blog-changelog-hero__copy {
        min-width: 0;
    }

    .blog-changelog-kicker {
        gap: 0.45rem;
        color: var(--content-meta);
        font-size: 0.65rem;
        font-weight: 800;
        letter-spacing: 0.1em;
    }

    .blog-changelog-kicker > span:first-child {
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--primary);
        box-shadow: 0 0 0 0.25rem color-mix(in srgb, var(--primary) 15%, transparent);
    }

    .blog-changelog-nav {
        justify-content: space-between;
        gap: 0.8rem;
        margin: 1rem 0;
        padding: 0.72rem 1rem;
        border: 1px solid var(--line-divider);
        color: var(--content-meta);
        font-size: 0.68rem;
        background-color: var(--card-bg) !important;
    }

    .blog-changelog-nav__back {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        color: var(--primary);
        font-size: 0.72rem;
        font-weight: 760;
        text-decoration: none;
    }

    .blog-changelog-nav a:hover,
    .blog-changelog-nav a:focus-visible {
        color: var(--text-color);
        outline: none;
    }

    .blog-changelog-hero h1 {
        margin: 0 0 0.45rem;
        color: var(--text-color);
        font-size: clamp(1.65rem, 3vw, 2.5rem);
        font-weight: 850;
        letter-spacing: -0.045em;
    }

    .blog-changelog-hero__lead {
        max-width: 62ch;
        margin: 0;
        color: var(--content-meta);
        font-size: 0.88rem;
        line-height: 1.8;
    }

    .blog-changelog-hero__rule {
        margin: 0.55rem 0 0;
        color: var(--primary);
        font-size: 0.68rem;
        font-weight: 720;
        line-height: 1.6;
    }

    .blog-changelog-stats {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.45rem;
        align-self: stretch;
        padding-left: 1.1rem;
        border-left: 1px solid var(--line-divider);
    }

    .blog-changelog-stats span {
        display: flex;
        min-height: 3.1rem;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        gap: 0.15rem;
        padding: 0.38rem 0.6rem;
        border: 1px solid color-mix(in srgb, var(--primary) 15%, var(--line-divider));
        border-radius: 0.45rem;
        background-color: var(--card-bg);
        color: var(--content-meta);
        font-size: 0.64rem;
    }

    .blog-changelog-stats strong {
        color: var(--primary);
        font-size: 1.02rem;
        font-weight: 850;
        line-height: 1;
    }

    .blog-changelog-stats small {
        font-size: 0.68rem;
    }

    /* ===== 时间线 ===== */
    .blog-changelog-list {
        position: relative;
        display: grid;
        gap: 1rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .blog-changelog-list::before {
        content: "";
        position: absolute;
        left: 8.15rem;
        top: 0.7rem;
        bottom: 0.7rem;
        width: 1px;
        background: linear-gradient(to bottom, color-mix(in srgb, var(--primary) 38%, var(--line-divider)), var(--line-divider));
    }

    .blog-changelog-entry {
        display: grid;
        grid-template-columns: 7.25rem 1.8rem minmax(0, 1fr);
        gap: 0.9rem;
        min-width: 0;
    }

    .blog-changelog-date {
        display: grid;
        align-content: start;
        justify-items: end;
        gap: 0.28rem;
        padding-top: 0.8rem;
        text-align: right;
    }

    .blog-changelog-date time {
        color: var(--text-color);
        font-size: 0.72rem;
        font-weight: 780;
        line-height: 1.35;
        white-space: nowrap;
    }

    .blog-changelog-date span {
        color: var(--content-meta);
        font-size: 0.62rem;
        line-height: 1.35;
    }

    .blog-changelog-rail {
        position: relative;
        display: flex;
        justify-content: center;
        min-height: 100%;
    }

    .blog-changelog-rail span {
        position: relative;
        z-index: 1;
        width: 0.7rem;
        height: 0.7rem;
        margin-top: 0.88rem;
        border: 2px solid var(--card-bg);
        border-radius: 999px;
        background: var(--primary);
        box-shadow: 0 0 0 0.22rem color-mix(in srgb, var(--primary) 13%, transparent);
    }

    /* ===== 条目卡片 ===== */
    .blog-changelog-card {
        min-width: 0;
        padding: 0.9rem 1rem;
        border: 1px solid var(--line-divider);
        border-radius: 0.78rem;
        box-shadow: 0 0.35rem 0.95rem #3a5b8908;
        background-color: var(--card-bg) !important;
    }

    .blog-changelog-card__header {
        display: grid;
        gap: 0.42rem;
    }

    .blog-changelog-card__meta {
        justify-content: space-between;
        gap: 0.6rem;
        color: var(--content-meta);
        font-size: 0.64rem;
    }

    .blog-changelog-card__labels {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        min-width: 0;
    }

    .blog-changelog-version {
        color: var(--primary);
        font-size: 0.68rem;
        font-weight: 850;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }

    .blog-changelog-kind {
        display: inline-flex;
        align-items: center;
        min-height: 1.45rem;
        padding: 0.2rem 0.45rem;
        border: 1px solid color-mix(in srgb, var(--primary) 18%, var(--line-divider));
        border-radius: 0.4rem;
        background-color: var(--card-bg);
        color: var(--primary);
        font-size: 0.62rem;
        font-weight: 780;
        line-height: 1.2;
    }

    .blog-changelog-kind--mint {
        border-color: color-mix(in srgb, #42c7b0 22%, var(--line-divider));
        background: color-mix(in srgb, #42c7b0 8%, var(--card-bg));
        color: #159b8b;

---
import { Icon } from "astro-icon/components";
import CategoryRose from "@/components/widget/CategoryRose.astro";
import TagGraph from "@/components/widget/TagGraph.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getCategoryList, getTagGraphData } from "@/utils/content-utils";
import { url } from "@/utils/url-utils";
import "@/styles/pages/common.css";
import "@/styles/pages/categories.css";

const categories = await getCategoryList();
const totalPosts = categories.reduce((sum, cat) => sum + cat.count, 0);
const tagGraph = await getTagGraphData();

const title = i18n(I18nKey.categories);
const description = i18n(I18nKey.categoriesSubtitle);
---

<MainGridLayout title={title} description={description}>
	<div
		class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32"
	>
		<div
			class="card-base categories-page z-10 px-4 py-6 md:px-9 relative w-full"
		>
			<!-- 页面标题 -->
			<header class="page-heading mb-6">
				<div class="page-icon" aria-hidden="true">
					<Icon name="material-symbols:donut-large" />
				</div>
				<div>
					<h2>{title}</h2>
					<p>{description}</p>
				</div>
			</header>

			<!-- 分类玫瑰图 -->
			{
				categories.length > 0 ? (
					<section aria-labelledby="category-rose-title">
						<div class="categories-page__section-header">
							<div>
								<h3
									id="category-rose-title"
									class="categories-page__section-title"
								>
									{i18n(I18nKey.categoryRoseTitle)}
								</h3>
								<p class="categories-page__section-meta">
									{categories.length}{" "}
									{i18n(I18nKey.categoriesCount)} · {totalPosts}{" "}
									{i18n(I18nKey.postsCount)}
								</p>
							</div>
						</div>
						<CategoryRose
							categories={categories}
							totalPosts={totalPosts}
						/>
					</section>
				) : (
					<div class="categories-page__empty">
						<Icon
							name="material-symbols:folder-off"
							class="text-5xl text-30 mb-3"
						/>
						<p>{i18n(I18nKey.noData)}</p>
					</div>
				)
			}

			<div class="categories-page__divider" />

			<!-- 标签关系图 -->
			<section class="tag-graph" aria-labelledby="tag-graph-title">
				<div class="tag-graph__header">
					<div class="tag-graph__heading">
						<div>
							<h3
								id="tag-graph-title"
								class="tag-graph__section-title"
							>
								{i18n(I18nKey.tagGraphTitle)}
							</h3>
							<p class="tag-graph__meta">
								{tagGraph.nodes.length}{" "}
								{i18n(I18nKey.tagsCount)} ·{" "}
								{tagGraph.links.length}{" "}
								{i18n(I18nKey.tagGraphLinks)}
							</p>
						</div>
						<a href={url("/tags/")} class="tag-graph__more">
							<Icon
								name="material-symbols:tag-rounded"
								class="text-base"
								aria-hidden="true"
							/>
							<span>{i18n(I18nKey.tagGraphMore)}</span>
						</a>
					</div>
					<p class="tag-graph__hint">
						{i18n(I18nKey.tagGraphDescription)}
					</p>
				</div>

				{
					tagGraph.nodes.length > 0 ? (
						<TagGraph graph={tagGraph} />
					) : (
						<div class="categories-page__empty">
							<Icon
								name="material-symbols:hub"
								class="text-5xl text-30 mb-3"
							/>
							<p>{i18n(I18nKey.tagGraphEmpty)}</p>
						</div>
					)
				}
			</section>
		</div>
	</div>
</MainGridLayout>

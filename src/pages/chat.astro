	}
	.tea-input__tools {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-wrap: wrap;
	}
	.tea-tool {
		width: 1.8rem;
		height: 1.8rem;
		display: grid;
		place-items: center;
		border: 1px solid var(--tea-line);
		border-radius: 0.55rem;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.08));
		color: var(--tea-muted);
		cursor: pointer;
		transition: color 0.15s, background 0.15s;
	}
	.tea-tool:hover {
		color: color-mix(in oklch, var(--primary) 70%, currentColor);
		background: color-mix(in oklch, var(--primary) 12%, transparent);
	}
	.tea-tool svg {
		width: 1.1rem;
		height: 1.1rem;
	}
	.tea-tool.is-active {
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
		background: color-mix(in oklch, var(--primary) 14%, transparent);
	}
	.tea-md-preview {
		border: 1px solid var(--tea-line-strong);
		border-radius: 0.75rem;
		background: color-mix(in oklch, var(--primary) 4%, transparent);
		overflow: hidden;
	}
	.tea-md-preview[hidden] { display: none; }
	.tea-md-preview__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.35rem 0.6rem;
		font-size: 0.68rem;
		color: var(--tea-muted);
		border-bottom: 1px solid var(--tea-line);
	}
	.tea-md-preview__head button {
		border: 0;
		background: none;
		color: color-mix(in oklch, var(--primary) 70%, currentColor);
		font-size: 0.68rem;
		cursor: pointer;
	}
	.tea-md-preview__body {
		padding: 0.5rem 0.7rem;
		min-height: 2.4rem;
		max-height: 8rem;
		overflow: auto;
		font-size: 0.86rem;
		line-height: 1.6;
	}
	.tea-md-preview__body p { margin: 0 0 0.5rem; }
	.tea-md-preview__body p:last-child { margin-bottom: 0; }
	.tea-md-preview__body pre {
		padding: 0.5rem 0.6rem;
		border-radius: 0.5rem;
		background: rgba(128, 128, 128, 0.12);
		overflow: auto;
	}
	.tea-md-preview__body code { font-size: 0.8em; }
	.tea-md-preview__body a { color: color-mix(in oklch, var(--primary) 70%, currentColor); }
	.tea-md-preview__body .tea-poll-card { margin: 0; }
	/* @ 提及面板：跟表情面板一样浮在输入框上方，键盘上下键可选 */
	.tea-mention {
		position: fixed;
		bottom: 0;
		left: 0;
		z-index: 130;
		display: flex;
		flex-direction: column;
		width: 20rem;
		max-width: calc(100vw - 1.5rem);
		max-height: min(19rem, 52vh);
		overflow: hidden;
		border: 1px solid var(--tea-line);
		border-radius: 0.85rem;
		background: var(--card-bg, #fff);
		box-shadow: 0 14px 40px rgba(0, 0, 0, 0.16);
	}
	.tea-mention[data-anchored] {
		bottom: auto;
		left: auto;
	}
	.tea-mention[hidden] {
		display: none;
	}
	.tea-mention__head {
		flex: none;
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.5rem 0.7rem 0.35rem;
		border-bottom: 1px solid var(--tea-line);
	}
	.tea-mention__head b {
		font-size: 0.78rem;
	}
	.tea-mention__head span {
		font-size: 0.66rem;
		color: var(--tea-muted);
	}
	.tea-mention__list {
		display: flex;
		flex: 1 1 auto;
		flex-direction: column;
		/* min-height:0 才肯真的收缩，否则列表撑满把「查看全部」那行顶出去 */
		min-height: 0;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.25rem;
	}
	.tea-mention__item {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		width: 100%;
		padding: 0.32rem 0.4rem;
		border: 0;
		border-radius: 0.55rem;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.8rem;
		text-align: left;
		cursor: pointer;
	}
	.tea-mention__item:hover,
	.tea-mention__item.is-active {
		background: color-mix(in oklch, var(--primary) 13%, transparent);
	}
	.tea-mention__avatar {
		flex: none;
		width: 1.55rem;
		height: 1.55rem;
		display: grid;
		place-items: center;
		border-radius: 50%;
		background-size: cover;
		background-position: center;
		color: #fff;
		font-size: 0.68rem;
		line-height: 1;
	}
	.tea-mention__nick {
		flex: 1;
		min-width: 0;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.tea-mention__self {
		margin-left: 0.25rem;
		padding: 0 0.25rem;
		border-radius: 0.3rem;
		background: color-mix(in oklch, var(--primary) 16%, transparent);
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
		font-size: 0.64rem;
	}
	.tea-mention__site {
		flex: none;
		max-width: 42%;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
		font-size: 0.66rem;
		color: var(--tea-muted);
	}
	.tea-mention__foot {
		flex: none;
		padding: 0.4rem;
		border: 0;
		border-top: 1px solid var(--tea-line);
		background: transparent;
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
		font: inherit;
		font-size: 0.72rem;
		cursor: pointer;
	}
	.tea-mention__empty {
		padding: 0.9rem 0.5rem;
		text-align: center;
		font-size: 0.74rem;
		color: var(--tea-muted);
	}
	/* 消息正文里的 @ 高亮；提到自己时更显眼一点 */
	.tea-at {
		color: color-mix(in oklch, var(--primary) 82%, currentColor);
		font-weight: 600;
	}
	.tea-at--me {
		padding: 0 0.18rem;
		border-radius: 0.3rem;
		background: color-mix(in oklch, var(--primary) 16%, transparent);
	}
	/* 可点的 @：点开这个人的名片 */
	.tea-at--link {
		padding: 0 0.18rem;
		border-radius: 0.3rem;
		background: color-mix(in oklch, var(--primary) 10%, transparent);
		cursor: pointer;
		transition: background 0.15s ease;
	}
	.tea-at--link:hover {
		background: color-mix(in oklch, var(--primary) 24%, transparent);
	}
	.tea-at--link:focus-visible {
		outline: 2px solid color-mix(in oklch, var(--primary) 60%, transparent);
		outline-offset: 1px;
	}
	.tea-emoji-panel {
		position: fixed;
		bottom: 0;
		left: 0;
		z-index: 130;
		width: 21rem;
		max-width: calc(100vw - 1.5rem);
		max-height: min(20rem, 52vh);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.6rem;
		border: 1px solid var(--tea-line);
		border-radius: 0.85rem;
		box-shadow: 0 14px 40px rgba(0, 0, 0, 0.16);
		background: var(--card-bg, #fff);
	}
	.tea-emoji-panel[data-anchored] { bottom: auto; left: auto; }
	.tea-emoji-panel[hidden] {
		display: none;
	}
	.tea-emoji-panel__tabs {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin-bottom: 0.4rem;
	}
	.tea-emoji-panel__search {
		display: block;
		margin-bottom: 0.45rem;
	}
	.tea-emoji-panel__search input {
		width: 100%;
		padding: 0.34rem 0.55rem;
		border: 1px solid var(--tea-line);
		border-radius: 0.6rem;
		background: color-mix(in oklch, var(--tea-line) 16%, transparent);
		color: inherit;
		font: inherit;
		font-size: 0.76rem;
	}
	.tea-emoji-panel__search input::placeholder {
		color: var(--tea-muted);
	}
	.tea-emoji-panel__search input:focus {
		outline: 2px solid color-mix(in oklch, var(--primary) 32%, transparent);
		outline-offset: 1px;
	}
	/* 颜文字：纯文本按钮，横向流式排，长的一个也不截断 */
	.tea-emoji-panel__kao {
		display: flex;
		flex-wrap: wrap;
		align-content: flex-start;
		gap: 0.3rem;
	}
	.tea-emoji-panel__kao .tea-emoji-kao {
		padding: 0.3rem 0.45rem;
		border: 1px solid var(--tea-line);
		border-radius: 0.5rem;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.76rem;
		line-height: 1.55;
		white-space: nowrap;
		word-break: keep-all;
		cursor: pointer;
	}
	.tea-emoji-panel__kao .tea-emoji-kao:hover {
		border-color: color-mix(in oklch, var(--primary) 30%, transparent);
		background: color-mix(in oklch, var(--primary) 12%, transparent);
	}
	.tea-emoji-panel__empty {
		padding: 0.9rem 0.4rem;
		text-align: center;
		font-size: 0.74rem;
		color: var(--tea-muted);
	}
	.tea-emoji-panel__tab {
		padding: 0.15rem 0.55rem;
		border: 0;
		border-radius: 0.5rem;
		background: transparent;
		color: var(--tea-muted);
		font-size: 0.72rem;
		cursor: pointer;
	}
	.tea-emoji-panel__tab.is-active {
		background: color-mix(in oklch, var(--primary) 15%, transparent);
		color: color-mix(in oklch, var(--primary) 75%, currentColor);
		font-weight: 600;
	}
	.tea-emoji-panel__grid {
		display: grid;
		grid-template-columns: repeat(9, minmax(0, 1fr));
		gap: 0.1rem;
	}
	.tea-emoji-panel__grid img,
	.tea-emoji-panel__grid .tea-emoji-char {
		width: 100%;
		height: 2rem;
		display: grid;
		place-items: center;
		object-fit: contain;
		font-size: 1.25rem;
		line-height: 1;
		cursor: pointer;
		border: 0;
		border-radius: 0.35rem;
		background: transparent;
	}
	.tea-emoji-panel__grid img:hover,
	.tea-emoji-panel__grid .tea-emoji-char:hover {
		background: color-mix(in oklch, var(--primary) 15%, transparent);
	}
	.tea-emoji-panel__msg {
		font-size: 0.72rem;
		color: var(--tea-muted);
		padding: 0.4rem;
	}
	.tea-typing {
		position: absolute;
		left: 1rem;
		bottom: 0.45rem;
		z-index: 4;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.3rem 0.65rem;
		border: 1px solid var(--tea-line);
		border-radius: 999px;
		background: var(--card-bg, #fff);
		box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
		font-size: 0.7rem;
		color: var(--tea-muted);
		pointer-events: none;
	}
	.tea-typing[hidden] {
		display: none;
	}
	.tea-typing__dots {
		display: inline-flex;
		gap: 0.15rem;
	}
	.tea-typing__dots i {
		width: 0.28rem;
		height: 0.28rem;
		border-radius: 50%;
		background: color-mix(in oklch, var(--primary) 65%, currentColor);
		animation: tea-typing-bounce 1.1s infinite ease-in-out;
	}
	.tea-typing__dots i:nth-child(2) { animation-delay: 0.15s; }
	.tea-typing__dots i:nth-child(3) { animation-delay: 0.3s; }
	@keyframes tea-typing-bounce {
		0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
		30% { transform: translateY(-0.2rem); opacity: 1; }
	}
	.tea-replybar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.55rem;
		border-left: 2px solid color-mix(in oklch, var(--primary) 55%, transparent);
		background: color-mix(in oklch, var(--primary) 8%, transparent);
		border-radius: 0 0.5rem 0.5rem 0;
		font-size: 0.72rem;
	}
	.tea-replybar[hidden] { display: none; }
	.tea-replybar__icon svg { width: 1rem; height: 1rem; }
	.tea-replybar__copy { flex: 1; min-width: 0; display: grid; }
	.tea-replybar__copy b { color: color-mix(in oklch, var(--primary) 70%, currentColor); }
	.tea-replybar__copy span { color: var(--tea-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.tea-replybar button { border: 0; background: none; color: var(--tea-muted); font-size: 1.1rem; cursor: pointer; }
	.tea-input__count {
		margin-left: auto;
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		font-variant-numeric: tabular-nums;
	}

	/* 按钮 */
	.tea-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		border-radius: 0.65rem;
		border: 1px solid transparent;
		font: inherit;
		font-size: 0.78rem;
		font-weight: 500;
		padding: 0.45rem 0.9rem;
		cursor: pointer;
		transition: transform 0.12s ease, filter 0.15s ease, background 0.15s ease;
		white-space: nowrap;
	}
	.tea-btn svg {
		width: 1rem;
		height: 1rem;
	}
	.tea-btn--primary {
		background: var(--primary);
		color: color-mix(in oklch, var(--primary) 22%, #2b2205);
		box-shadow: 0 8px 18px -12px color-mix(in oklch, var(--primary) 80%, transparent);
	}
	.tea-btn--primary:hover {
		filter: brightness(1.04);
	}
	.tea-btn--primary:active {
		transform: translateY(1px);
	}
	.tea-btn--ghost {
		background: transparent;
		border-color: var(--tea-line-strong);
		color: inherit;
	}
	.tea-btn--ghost:hover {
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-btn:disabled {
		opacity: 0.5;
		cursor: not-allowed;
		transform: none;
	}
	.tea-send {
		padding: 0.42rem 0.8rem;
	}
	.tea-form-error {
		margin: 0;
		font-size: 0.72rem;
		color: #c0563f;
	}

	/* ─── 点歌台 ───────────────────────────────────────────── */
	.tea-juke {
		display: flex;
		flex-direction: column;
		min-height: 0;
		background: var(--tea-surface);
		border: 1px solid var(--tea-line);
		border-radius: 1.1rem;
		overflow: hidden;
	}
	.tea-juke__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.7rem 0.8rem;
		border-bottom: 1px solid var(--tea-line);
		flex: none;
	}
	.tea-juke__title {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		min-width: 0;
	}
	.tea-juke__title svg {
		width: 1rem;
		height: 1rem;
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
	}
	.tea-juke__title h2 {
		margin: 0;
		font-size: 0.86rem;
		font-weight: 600;
	}
	.tea-juke__tools {
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}
	.tea-juke__live {
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		white-space: nowrap;
	}
	.tea-juke__live i {
		width: 0.34rem;
		height: 0.34rem;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.5;
	}
	.tea-juke__live b {
		font-weight: 400;
	}
	.tea-juke__live.is-playing {
		color: #2f9e6b;
	}
	.tea-juke__live.is-playing i {
		opacity: 1;
		box-shadow: 0 0 0 3px color-mix(in oklch, #2f9e6b 20%, transparent);
	}

	.tea-juke__stage {
		display: grid;
		grid-template-columns: minmax(0, 40%) minmax(0, 1fr);
		gap: 0.65rem;
		padding: 0.8rem 0.8rem 0.15rem;
		align-items: center;
		flex: none;
	}
	.tea-juke__cover {
		position: relative;
		aspect-ratio: 1 / 1;
		width: 100%;
		border-radius: 0.8rem;
		background-color: color-mix(in oklch, var(--primary) 12%, transparent);
		background-size: cover;
		background-position: center;
		border: 1px solid var(--tea-line);
		overflow: hidden;
	}
	.tea-juke__eq {
		position: absolute;
		left: 0.55rem;
		bottom: 0.55rem;
		display: flex;
		align-items: flex-end;
		gap: 0.14rem;
		height: 0.85rem;
		padding: 0.18rem 0.32rem;
		border-radius: 0.4rem;
		background: rgba(0, 0, 0, 0.35);
		backdrop-filter: blur(4px);
	}
	.tea-juke__eq i {
		width: 2px;
		background: #fff;
		border-radius: 1px;
		height: 30%;
		opacity: 0.55;
	}
	.tea-juke__eq i:nth-child(2) {
		height: 70%;
	}
	.tea-juke__eq i:nth-child(3) {
		height: 45%;
	}
	.tea-juke.is-playing .tea-juke__eq i {
		animation: tea-eq 0.9s ease-in-out infinite alternate;
		opacity: 1;
	}
	.tea-juke.is-playing .tea-juke__eq i:nth-child(2) {
		animation-delay: -0.3s;
	}
	.tea-juke.is-playing .tea-juke__eq i:nth-child(3) {
		animation-delay: -0.6s;
	}
	@keyframes tea-eq {
		from {
			height: 22%;
		}
		to {
			height: 100%;
		}
	}
	.tea-juke__info {
		min-width: 0;
		display: grid;
		gap: 0.6rem;
		align-content: center;
	}
	.tea-juke__meta {
		min-width: 0;
	}
	.tea-juke__meta h3 {
		margin: 0;
		font-size: 0.82rem;
		font-weight: 600;
		line-height: 1.35;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}
	.tea-juke__meta p {
		margin: 0.25rem 0 0;
		font-size: 0.68rem;
		color: var(--tea-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.tea-juke__timeline {
		min-width: 0;
	}
	.tea-juke input[type="range"] {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 3px;
		border-radius: 999px;
		background: linear-gradient(
			to right,
			var(--primary) 0%,
			var(--primary) var(--p, 0%),
			color-mix(in oklch, currentColor 14%, transparent) var(--p, 0%),
			color-mix(in oklch, currentColor 14%, transparent) 100%
		);
		outline: none;
		cursor: pointer;
	}
	.tea-juke input[type="range"]::-webkit-slider-thumb {
		-webkit-appearance: none;
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--primary);
		border: 2px solid var(--tea-surface);
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
	}
	.tea-juke input[type="range"]::-moz-range-thumb {
		width: 0.6rem;
		height: 0.6rem;
		border: 2px solid var(--tea-surface);
		border-radius: 50%;
		background: var(--primary);
	}
	.tea-juke__times {
		display: flex;
		justify-content: space-between;
		font-size: 0.62rem;
		color: var(--tea-muted-soft);
		margin-top: 0.2rem;
		font-variant-numeric: tabular-nums;
	}

	.tea-juke__controls {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem 0.8rem 0.6rem;
		flex: none;
	}
	.tea-juke__ctrl,
	.tea-juke__play {
		border: 0;
		background: transparent;
		color: inherit;
		cursor: pointer;
		display: grid;
		place-items: center;
		border-radius: 50%;
		opacity: 0.75;
	}
	.tea-juke__ctrl {
		width: 1.9rem;
		height: 1.9rem;
	}
	.tea-juke__ctrl:hover {
		opacity: 1;
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.1));
	}
	.tea-juke__ctrl svg {
		width: 1.1rem;
		height: 1.1rem;
	}
	.tea-juke__play {
		width: 2.35rem;
		height: 2.35rem;
		background: var(--primary);
		color: color-mix(in oklch, var(--primary) 20%, #2b2205);
		box-shadow: 0 8px 18px -12px color-mix(in oklch, var(--primary) 80%, transparent);
		opacity: 1;
	}
	.tea-juke__play svg {
		width: 1.25rem;
		height: 1.25rem;
	}
	.tea-juke__play span {
		display: grid;
		place-items: center;
	}
	.tea-juke__play span[hidden] {
		display: none;
	}
	.tea-juke__vol {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		margin-left: auto;
		flex: 1;
		max-width: 5.6rem;
		color: var(--tea-muted-soft);
	}
	.tea-juke__vol svg {
		width: 0.9rem;
		height: 0.9rem;
		flex: none;
	}

	.tea-juke__tabs {
		display: flex;
		gap: 0.2rem;
		padding: 0 0.7rem;
		border-top: 1px solid var(--tea-line);
		flex: none;
	}
	.tea-juke__tabs button {
		border: 0;
		background: none;
		color: var(--tea-muted);
		font: inherit;
		font-size: 0.72rem;
		padding: 0.5rem 0.4rem 0.45rem;
		cursor: pointer;
		border-bottom: 2px solid transparent;
	}
	.tea-juke__tabs button.is-active {
		color: inherit;
		font-weight: 600;
		border-bottom-color: var(--primary);
	}
	.tea-juke__panel {
		flex: 1 1 auto;
		min-height: 5rem;
		overflow-y: auto;
		padding: 0.35rem 0.4rem 0.6rem;
		scrollbar-width: thin;
	}
	.tea-juke__empty {
		margin: 0;
		padding: 0.6rem 0.4rem;
		font-size: 0.7rem;
		color: var(--tea-muted-soft);
	}
	.tea-song {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: 100%;
		padding: 0.3rem 0.4rem;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		border-radius: 0.55rem;
		cursor: pointer;
	}
	.tea-song:hover {
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-song.is-current {
		background: color-mix(in oklch, var(--primary) 10%, transparent);
	}
	.tea-song__idx {
		width: 1rem;
		flex: none;
		font-size: 0.62rem;
		color: var(--tea-muted-soft);
		font-variant-numeric: tabular-nums;
		text-align: center;
	}
	.tea-song.is-current .tea-song__idx {
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
	}
	.tea-song__copy {
		min-width: 0;
		display: grid;
	}
	.tea-song__name {
		font-size: 0.74rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tea-song__artist {
		font-size: 0.64rem;
		color: var(--tea-muted-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tea-juke__lyrics {
		font-size: 0.75rem;
		text-align: center;
		padding: 0.5rem 0.5rem 3rem;
		-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 1.4rem, #000 calc(100% - 1.6rem), transparent 100%);
		mask-image: linear-gradient(to bottom, transparent 0, #000 1.4rem, #000 calc(100% - 1.6rem), transparent 100%);
	}
	.tea-lyric {
		display: block;
		width: 100%;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		font-size: 0.75rem;
		line-height: 2.05;
		padding: 0.08rem 0.3rem;
		text-align: center;
		cursor: pointer;
		border-radius: 0.45rem;
		opacity: 0.58;
		transition: opacity 0.2s ease, color 0.2s ease;
	}
	.tea-lyric:hover {
		opacity: 0.95;
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-lyric.is-current {
		opacity: 1;
		font-weight: 600;
		color: color-mix(in oklch, var(--primary) 74%, currentColor);
	}
	.dark .tea-lyric.is-current {
		color: color-mix(in oklch, var(--primary) 86%, white);
	}

	/* ─── 图片预览 ─────────────────────────────────────────── */
	.tea-zoom {
		position: fixed;
		inset: 0;
		z-index: 170;
		background: rgba(14, 16, 12, 0.86);
		backdrop-filter: blur(8px);
		animation: tea-zoom-in 0.18s ease-out;
		overflow: hidden;
		touch-action: none;
	}
	.tea-zoom[hidden] {
		display: none;
	}
	.tea-zoom__stage {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		overflow: hidden;
		cursor: grab;
	}
	.tea-zoom__stage.is-dragging {
		cursor: grabbing;
	}
	.tea-zoom img {
		max-width: min(92vw, 1400px);
		max-height: 88vh;
		border-radius: 0.8rem;
		box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
		object-fit: contain;
		cursor: default;
		user-select: none;
		-webkit-user-drag: none;
		transform-origin: center center;
		will-change: transform;
	}
	.tea-zoom__close,
	.tea-zoom__nav,
	.tea-zoom__bar {
		position: absolute;
		z-index: 2;
	}
	.tea-zoom__close {
		top: 1rem;
		right: 1rem;
		width: 2.4rem;
		height: 2.4rem;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.92);
		color: #1f2418;
		cursor: pointer;
		box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.7);
	}
	.tea-zoom__close svg {
		width: 1.2rem;
		height: 1.2rem;
	}
	.tea-zoom__nav {
		top: 50%;
		width: 2.6rem;
		height: 2.6rem;
		transform: translateY(-50%);
		display: grid;
		place-items: center;
		border: 1px solid rgba(255, 255, 255, 0.28);
		border-radius: 50%;
		background: rgba(20, 22, 18, 0.55);
		color: #fff;
		cursor: pointer;
		backdrop-filter: blur(8px);
	}
	.tea-zoom__nav:hover {
		background: rgba(255, 255, 255, 0.18);
	}
	.tea-zoom__nav svg {
		width: 1.2rem;
		height: 1.2rem;
	}
	.tea-zoom__nav--prev { left: 1rem; }
	.tea-zoom__nav--next { right: 1rem; }
	.tea-zoom__nav[hidden] { display: none; }
	.tea-zoom__bar {
		left: 50%;
		bottom: 1.1rem;
		transform: translateX(-50%);
		display: flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.3rem;
		border: 1px solid rgba(255, 255, 255, 0.22);
		border-radius: 999px;
		background: rgba(20, 22, 18, 0.6);
		backdrop-filter: blur(10px);
		color: #fff;
	}
	.tea-zoom__bar button {
		width: 2rem;
		height: 2rem;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 1.05rem;
		cursor: pointer;
	}
	.tea-zoom__bar button:hover {
		background: rgba(255, 255, 255, 0.16);
	}
	.tea-zoom__count {
		padding: 0 0.55rem;
		font-size: 0.7rem;
		color: rgba(255, 255, 255, 0.78);
		font-variant-numeric: tabular-nums;
	}
	@keyframes tea-zoom-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.tea-zoom {
			animation: none;
		}
	}

	/* ─── 弹窗 ─────────────────────────────────────────────── */
	.tea-dialog {
		border: 0;
		padding: 0;
		margin: auto;
		width: min(24rem, calc(100vw - 2rem));
		max-height: calc(100dvh - 2rem);
		border-radius: 1.1rem;
		background: var(--card-bg, #fff);
		color: inherit;
		box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.5);
		overflow: auto;
	}
	.tea-dialog::backdrop {
		background: rgba(20, 24, 18, 0.36);
		backdrop-filter: blur(6px);
	}
	.tea-dialog__inner {
		padding: 1.05rem 1.25rem 1.25rem;
		display: grid;
		gap: 0.65rem;
	}
	.tea-dialog__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
	}
	.tea-dialog__icon {
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 0.8rem;
		display: grid;
		place-items: center;
		background: color-mix(in oklch, var(--primary) 15%, transparent);
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
	}
	.tea-dialog__icon svg {
		width: 1.3rem;
		height: 1.3rem;
	}
	.tea-dialog__close {
		width: 1.9rem;
		height: 1.9rem;
	}
	.tea-dialog h3 {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 600;
	}
	.tea-dialog__desc {
		margin: -0.25rem 0 0.2rem;
		font-size: 0.76rem;
		line-height: 1.6;
		color: var(--tea-muted);
	}
	.tea-field {
		display: grid;
		gap: 0.28rem;
	}
	.tea-field > span {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		font-size: 0.74rem;
		font-weight: 500;
	}
	.tea-field em {
		font-style: normal;
		font-size: 0.66rem;
		font-weight: 400;
		color: var(--tea-muted-soft);
	}
	.tea-field input {
		width: 100%;
		padding: 0.5rem 0.65rem;
		border-radius: 0.6rem;
		border: 1px solid var(--tea-line-strong);
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.84rem;
		outline: none;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.tea-field input:focus {
		border-color: color-mix(in oklch, var(--primary) 48%, transparent);
		box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 14%, transparent);
	}
	.tea-dialog__preview {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.55rem 0.65rem;
		border-radius: 0.75rem;
		background: color-mix(in oklch, var(--primary) 6%, transparent);
		border: 1px solid color-mix(in oklch, var(--primary) 14%, transparent);
	}
	.tea-dialog__avatar {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: 0.78rem;
		font-weight: 600;
		color: #fff;
		background: color-mix(in oklch, var(--primary) 70%, #6b5a22);
		background-size: cover;
		background-position: center;
		flex: none;
	}
	.tea-dialog__preview-copy {
		display: grid;
		gap: 0.08rem;
		min-width: 0;
	}
	.tea-dialog__preview-copy b {
		font-size: 0.8rem;
		font-weight: 600;
	}
	.tea-dialog__preview-copy span {
		font-size: 0.66rem;
		color: var(--tea-muted);
	}
	.tea-dialog__submit {
		margin-top: 0.15rem;
		padding: 0.55rem 1rem;
	}
	.tea-dialog__error {
		margin: 0;
		font-size: 0.72rem;
		color: #c0563f;
	}
	.tea-dialog__inner[hidden] {
		display: none;
	}
	.tea-dialog__divider {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0.3rem 0 0.1rem;
		font-size: 0.68rem;
		color: var(--tea-muted-soft);
	}
	.tea-dialog__divider::before,
	.tea-dialog__divider::after {
		content: "";
		height: 1px;
		flex: 1;
		background: var(--tea-line-strong);
		opacity: 0.7;
	}
	.tea-dialog__waline {
		width: 100%;
		padding: 0.55rem 1rem;
		border-color: var(--tea-line);
	}
	.tea-dialog__hint {
		margin: 0;
		font-size: 0.66rem;
		line-height: 1.6;
		color: var(--tea-muted-soft);
	}
	/* ── 登录弹窗：Waline 主入口 + 访客折叠 ─────────────── */
	.tea-dialog.tea-login {
		width: min(32rem, calc(100vw - 2rem));
	}
	.tea-login__head h3 {
		margin: 0;
		font-size: 1.12rem;
	}
	.tea-login__head .tea-dialog__desc {
		margin: 0.18rem 0 0;
	}
	.tea-login__primary {
		display: grid;
		gap: 0.6rem;
		padding: 0.85rem;
		border: 1px solid color-mix(in oklch, var(--primary) 28%, var(--tea-line));
		border-radius: 0.9rem;
		background: color-mix(in oklch, var(--primary) 7%, var(--card-bg, #fff));
	}
	.tea-login__primary-head {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.tea-login__primary-head b {
		font-size: 0.92rem;
	}
	.tea-login__badge {
		font-size: 0.58rem;
		font-weight: 700;
		padding: 0.18rem 0.4rem;
		border-radius: 999px;
		background: #2f6b4f;
		color: #fff;
	}
	.tea-login__link {
		margin-left: auto;
		font-size: 0.68rem;
		color: color-mix(in oklch, var(--primary) 72%, currentColor);
		text-decoration: none;
	}
	.tea-login__link:hover { text-decoration: underline; }
	.tea-login__desc {
		margin: 0;
		font-size: 0.74rem;
		line-height: 1.65;
		color: var(--tea-muted);
	}
	.tea-login__desc b { color: color-mix(in oklch, var(--primary) 72%, currentColor); }
	.tea-login__cta {
		width: 100%;
		padding: 0.65rem 0.9rem;
		font-size: 0.88rem;
		font-weight: 600;
	}
	.tea-login__cta svg { width: 1rem; height: 1rem; }
	.tea-login__foot {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		font-size: 0.64rem;
		color: var(--tea-muted-soft);
	}
	.tea-login__foot a {
		color: color-mix(in oklch, var(--primary) 68%, currentColor);
		text-decoration: none;
		white-space: nowrap;
	}
	.tea-login__foot a:hover { text-decoration: underline; }
	.tea-login__guest {
		border: 1px solid var(--tea-line);
		border-radius: 0.85rem;
		overflow: hidden;
	}
	.tea-login__guest summary {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.7rem 0.8rem;
		cursor: pointer;
		list-style: none;
	}
	.tea-login__guest summary::-webkit-details-marker { display: none; }
	.tea-login__guest-copy {
		flex: 1;
		min-width: 0;
		display: grid;
		gap: 0.16rem;
	}
	.tea-login__guest-copy b {
		font-size: 0.82rem;
		font-weight: 500;
	}
	.tea-login__guest-copy small {
		font-size: 0.66rem;
		color: var(--tea-muted);
		line-height: 1.5;
	}
	.tea-login__chev {
		width: 1rem;
		height: 1rem;
		flex: none;
		color: var(--tea-muted);
		transition: transform 0.15s ease;
	}
	.tea-login__guest[open] .tea-login__chev { transform: rotate(180deg); }
	.tea-login__guest-body {
		display: grid;
		gap: 0.5rem;
		padding: 0.15rem 0.8rem 0.8rem;
	}
	.tea-dialog__back {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		align-self: center;
		border: 0;
		background: none;
		color: var(--tea-muted);
		font: inherit;
		font-size: 0.72rem;
		cursor: pointer;
		padding: 0.2rem;
	}
	.tea-dialog__back:hover {
		color: inherit;
	}
	.tea-dialog__back svg {
		width: 0.9rem;
		height: 0.9rem;
	}

	/* 遮罩（移动端抽屉） */
	.tea-scrim {
		position: fixed;
		inset: 0;
		z-index: 29;
		background: rgba(20, 24, 18, 0.32);
		backdrop-filter: blur(2px);
	}
	.tea-juke-scrim {
		display: none;
		z-index: 30;
	}

	/* ─── 响应式 ───────────────────────────────────────────── */
	@media (max-width: 1440px) {
		.tea-app {
			grid-template-columns: 15.5rem minmax(0, 1fr) 16rem;
		}
		.tea-app.is-juke-hidden {
			grid-template-columns: 15.5rem minmax(0, 1fr);
		}
	}
	@media (max-width: 1240px) {
		.tea-app,
		.tea-app.is-juke-hidden {
			grid-template-columns: 15rem minmax(0, 1fr);
		}
		.tea-juke {
			position: fixed;
			top: var(--tea-top);
			right: 0.5rem;
			bottom: 0.5rem;
			width: min(19rem, calc(100vw - 1rem));
			z-index: 31;
			display: flex !important;
			transform: translateX(114%);
			transition: transform 0.24s ease;
			box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.55);
		}
		.tea-app.is-juke-open .tea-juke {
			transform: none;
		}
		.tea-app.is-juke-open .tea-juke-scrim {
			display: block;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.tea-juke {
			transition: none;
		}
	}
	@media (max-width: 900px) {
		.tea-app {
			--tea-top: 3.6rem;
			left: 0.5rem;
			right: 0.5rem;
			bottom: 0.5rem;
			grid-template-columns: minmax(0, 1fr);
		}
		.tea-side {
			position: fixed;
			top: var(--tea-top);
			bottom: 0.5rem;
			left: 0.5rem;
			width: min(17rem, calc(100vw - 2rem));
			z-index: 30;
			padding: 0.6rem;
			border-radius: 1.1rem;
			background: var(--page-bg, #f6f6f1);
			overflow-y: auto;
			transform: translateX(-116%);
			transition: transform 0.22s ease;
			box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.6);
		}
		.tea-app.is-drawer-open .tea-side {
			transform: none;
		}
		.tea-bar {
			padding: 0.6rem 0.7rem;
			gap: 0.4rem;
		}
		.tea-bar__brand {
			flex: 1;
			gap: 0.4rem;
		}
		.tea-bar__brand > div {
			display: none;
		}
		.tea-bar__mark {
			width: 1.8rem;
			height: 1.8rem;
		}
		.tea-room-switch {
			flex: none;
			white-space: nowrap;
			padding: 0 0.45rem;
		}
		.tea-room-switch > span:first-of-type {
			display: none;
		}
		.tea-bar__tools {
			gap: 0.25rem;
		}
		.tea-conn [data-tea-conn-text] {
			display: none;
		}
		.tea-banner {
			margin: 0.55rem 0.7rem 0;
			font-size: 0.68rem;
		}
		.tea-feed {
			padding: 0.75rem 0.75rem 2.4rem;
		}
		.tea-composer {
			padding: 0.6rem 0.7rem 0.7rem;
		}
		.tea-gate__copy span {
			display: none;
		}
	}
	@media (max-width: 520px) {
		.tea-banner__peers {
			display: none;
		}
		.tea-bar__sub {
			display: none;
		}
	}

	.dark .tea-banner a,
	.dark .tea-msg__text a {
		color: color-mix(in oklch, var(--primary) 82%, white);
	}

	/* ─── 互联友站 / 活跃线程浮层 ───────────────────────────── */
	.tea-room-switch {
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
		height: 1.85rem;
		padding: 0 0.55rem;
		border-radius: 999px;
		border: 1px solid color-mix(in oklch, var(--primary) 26%, transparent);
		background: color-mix(in oklch, var(--primary) 8%, transparent);

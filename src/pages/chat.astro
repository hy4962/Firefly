---
import ChatApp from "@/components/chat/ChatApp.svelte";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import "@/styles/pages/chat.css";

const title = "聊天室";
const description = "一个连着 Matrix 公共大厅的聊天室，消息会同步到已接入的友站。";

// 生产后端跑在 fnOS 的 tea-bridge 容器里，由 Lucky 反向代理到这个域名。
const CHAT_API = "https://tea.0dm.cn";
const WALINE_SERVER = "https://waline.0dm.cn";

const rooms = [
	{
		id: "lobby",
		name: "互联茶室",
		subtitle: "和其他站点的朋友一起聊天",
		avatar: "/assets/images/room-lobby.webp",
	},
	{
		id: "chat",
		name: "闲聊",
		subtitle: "随便聊聊日常与折腾",
		avatar: "/assets/images/room-chat.webp",
	},
];

const interconnectSites = [
	{
		name: "折腾进行时",
		siteUrl: "https://www.9ll.uk",
		url: "https://www.9ll.uk/chat/",
		owner: "HY",
		avatar: "/assets/images/kirino.webp",
		desc: "生命不息，折腾不止",
		badge: "折腾进行时",
		isSelf: true,
	},
	{
		name: "冷汐的杂货铺",
		siteUrl: "https://lengxiqwq.com",
		url: "https://lengxiqwq.com/chat/",
		homeserver: "matrix.lengxiqwq.com",
		owner: "冷汐OωO",
		avatar: "https://lengxiqwq.com/assets/images/avatar.webp",
		desc: "你好谢谢小笼包再见",
		badge: "杂货铺",
	},
	{
		name: "朝朝听雨",
		siteUrl: "https://rainzt.cn",
		url: "https://rainzt.cn/chat/",
		homeserver: "matrix.rainzt.cn",
		owner: "朝朝听雨",
		avatar: "https://rainzt.cn/zzty.png",
		desc: "物物而不物于物，念念而不念于念",
		badge: "听雨茶室",
	},
	{
		name: "Detached",
		siteUrl: "https://detached.online",
		url: "https://detached.online/chat/",
		owner: "Detached",
		avatar: "https://detached.online/favicon.ico",
		desc: "总能看见不完美，所以一直追求完美，从修好每一处细节做起",
	},
	{
		name: "AIOVTUE-雪",
		siteUrl: "https://daily.yybb.us",
		url: "https://daily.yybb.us/chat/",
		homeserver: "matrix.rainzt.cn",
		owner: "AIOVTUE-雪",
		avatar: "https://daily.yybb.us/owo/snow/snow-03.webp",
		desc: "雨滴会记录生命中的每一个瞬间",
	},
	{
		name: "Somoe",
		siteUrl: "https://somoe.xyz",
		url: "https://somoe.xyz/chat",
		owner: "Somoe",
		avatar: "https://somoe.xyz/qiumonster.webp",
		desc: "在文字的深海里，拾贝而行",
	},
	{
		name: "昭鸢笺",
		siteUrl: "https://blog.mibase.top",
		url: "https://blog.mibase.top/chat/",
		owner: "Mi",
		avatar: "https://blog.mibase.top/icon-192.png",
		desc: "鸢起云间，一纸藏闲",
	},
];

const stickerPackUrls = ["/assets/stickers/qq", "/assets/stickers/miku"];
---

<MainGridLayout title={title} description={description} heading={title}>
	<script is:inline slot="head" data-swup-ignore-script define:vars={{ chatWallpapers: null }}>
		(function () {
			if (window.swup) return;
			var root = document.documentElement;
			root.setAttribute("data-chat-page", "true");
			if (/iPhone|iPod/.test(navigator.userAgent)) {
				root.setAttribute("data-is-iphone", "true");
			}
			root.setAttribute("data-chat-bg", "wallpaper");
			root.setAttribute("data-chat-density", "comfortable");
			root.setAttribute("data-chat-font-size", "md");
			root.style.setProperty("--chat-hue", "175");
			root.style.setProperty("--hue", "175");
		})();
	</script>

	<div id="chat-page" class="chat-page-container">
		<ChatApp
			client:load
			chatServerUrl={CHAT_API}
			walineServerUrl={WALINE_SERVER}
			playlistOutApiUrl="https://playlistout-api.lengxiqwq.com"
			rooms={rooms}
			enableImageUpload={true}
			stickerPackUrls={stickerPackUrls}
			musicTracks={[]}
			initialMusicVolume={1}
			interconnectSites={interconnectSites}
			siteAvatar="/assets/images/kirino.webp"
		/>
	</div>
</MainGridLayout>

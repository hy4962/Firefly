	@media (max-width: 900px) {
		.tea-app {
			--tea-top: 3.6rem;
			left: 0.5rem;
			right: 0.5rem;
			bottom: 0.5rem;
			grid-template-columns: minmax(0, 1fr);
		}
		.tea-side {
			position: fixed;
			top: var(--tea-top);
			bottom: 0.5rem;
			left: 0.5rem;
			width: min(17rem, calc(100vw - 2rem));
			z-index: 30;
			padding: 0.6rem;
			border-radius: 1.1rem;
			background: var(--page-bg, #f6f6f1);
			overflow-y: auto;
			transform: translateX(-116%);
			transition: transform 0.22s ease;
			box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.6);
		}
		.tea-app.is-drawer-open .tea-side {

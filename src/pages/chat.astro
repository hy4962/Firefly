	.tea-source__box {
		background: var(--card-bg, #fff);
		border: 1px solid var(--tea-line);
		border-radius: 0.9rem;
		box-shadow: 0 18px 50px rgba(0, 0, 0, 0.22);
		overflow: hidden;
	}
	.tea-source__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.45rem 0.7rem;
		border-bottom: 1px solid var(--tea-line);
		font-size: 0.74rem;
		font-weight: 600;
	}
	.tea-source__head button {
		border: 0;
		background: none;
		color: var(--tea-muted);
		font-size: 1.1rem;
		cursor: pointer;
	}
	.tea-source pre {
		margin: 0;
		padding: 0.7rem;
		max-height: min(22rem, 60vh);
		overflow: auto;
		font-size: 0.74rem;
		line-height: 1.55;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.tea-react-picker {
		position: fixed;
		z-index: 160;
		width: 18rem;
		max-width: calc(100vw - 1.5rem);
		padding: 0.4rem;
		border: 1px solid var(--tea-line);
		border-radius: 0.85rem;
		background: var(--card-bg, #fff);
		box-shadow: 0 14px 38px rgba(0, 0, 0, 0.16);
		display: grid;
		gap: 0.35rem;

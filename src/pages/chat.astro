---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "茶室";
const description = "一个连着 Matrix 公共大厅的聊天室，消息会同步到已接入的友站。";

// ── 桥接服务地址（Cloudflare Worker，见仓库 chat-bridge/ ）────────────
// 调试时可用 ?api=http://127.0.0.1:8787 覆盖，方便本地联调。
const CHAT_API = "https://tea.0dm.cn";

// 留言板地址：资料弹窗里的「Waline 个人中心」直接带 token 跳过去
const WALINE_SERVER = "https://waline.0dm.cn";

// 站点署名，后缀会拼到访客昵称后面同步到大厅
const SITE_NAME = "折腾进行时";

const roomRules = [
	"友善交流，别刷屏、别发广告，也别打探别人的隐私。",
	"这里是公开房间，消息会同步到 Matrix 和其他友站，别放私密内容。",
	"图片每 10 分钟最多 3 张，慢慢来。",
];

// 互联茶室友站（点击顶栏的站点按钮可查看）
const peers = [
	{ name: "听雨茶室", owner: "朝朝听雨", avatar: "https://rainzt.cn/zzty.png", url: "https://rainzt.cn/chat/", desc: "物物而不物于物，念念而不念于念" },
	{ name: "Detached 茶室", owner: "Detached", avatar: "https://detached.online/favicon.ico", url: "https://detached.online/chat/", desc: "总能看见不完美，所以一直追求完美" },
	{ name: "雪的茶室", owner: "AIOVTUE-雪", avatar: "https://daily.yybb.us/owo/snow/snow-03.webp", url: "https://chat.yybb.us/", desc: "雨滴会记录生命中的每一个瞬间" },
	{ name: "Somoe 茶室", owner: "Somoe", avatar: "https://somoe.xyz/favicon.ico", url: "https://somoe.xyz/chat", desc: "在文字的深海里，拾贝而行" },
];
const selfSite = { name: "折腾进行时", owner: "HY", avatar: "/assets/images/kirino.webp", url: "https://www.9ll.uk/chat/", desc: "在折腾里慢慢变老", isSelf: true };
---

<MainGridLayout title={title} description={description} heading={title}>
	<section
		class="tea-app"
		id="tea-app"
		data-tea-app
		data-api={CHAT_API}
		data-waline={WALINE_SERVER}
		data-site={SITE_NAME}
		data-peers={JSON.stringify(peers)}
		data-self-site={JSON.stringify(selfSite)}
	>
		<!-- ── 左栏 ───────────────────────────────────────────── -->
		<aside class="tea-side" data-tea-side>
			<div class="tea-card tea-me" data-tea-me>
				<button type="button" class="tea-me__main" data-tea-profile-open aria-label="编辑个人资料">
					<span class="tea-me__avatar" data-tea-me-avatar aria-hidden="true">?</span>
					<span class="tea-me__copy">
						<span class="tea-me__nameline">
							<b data-tea-me-name>还没入座</b>
							<em class="tea-me__badge" data-tea-me-badge hidden>已入座</em>
						</span>
						<span class="tea-me__status" data-tea-me-status>点击设置状态…</span>
						<span class="tea-me__stats" hidden><b data-tea-me-count>0</b><span data-tea-me-since></span></span>
					</span>
				</button>
				<button type="button" class="tea-icon-btn tea-me__bell" data-tea-notify-toggle aria-label="通知" title="通知">
					<Icon is:inline name="material-symbols:notifications-outline-rounded" />
					<span class="tea-me__dot" data-tea-notify-dot hidden></span>
				</button>
				<button type="button" class="tea-btn tea-btn--primary tea-me__login" data-tea-enter data-tea-card-login hidden>登录</button>
			</div>

			<div class="tea-card tea-rooms">
				<header class="tea-card__head">
					<span class="tea-card__title">
						<Icon is:inline name="material-symbols:forum-outline-rounded" /> 房间与成员
					</span>
				</header>
				<ul class="tea-rooms__list" data-tea-rooms>
					<li class="tea-rooms__group">互联房间</li>
					<li>
						<button type="button" class="tea-room-item is-active" data-room="lobby">
							<span class="tea-room-item__avatar"><img src="/assets/images/room-lobby.webp" data-room-avatar="lobby" alt="" /></span>
							<span class="tea-room-item__copy">
								<b>互联茶室</b>
								<span>和其他站点的朋友一起聊天</span>
							</span>
						</button>
					</li>
					<li class="tea-rooms__group">本站</li>
					<li>
						<button type="button" class="tea-room-item" data-room="chat">
							<span class="tea-room-item__avatar"><img src="/assets/images/room-chat.webp" data-room-avatar="chat" alt="" loading="lazy" /></span>
							<span class="tea-room-item__copy">
								<b>闲聊</b>
								<span>随便聊聊日常与折腾</span>
							</span>
						</button>
					</li>
				</ul>
			</div>

			<div class="tea-card tea-roster">
				<header class="tea-card__head">
					<span class="tea-card__title">
						<Icon is:inline name="material-symbols:group-outline-rounded" /> 在线茶友
					</span>
					<span class="tea-roster__count"><i></i><b data-tea-online>0</b> 人在线</span>
				</header>
				<ul class="tea-roster__list" data-tea-members>
					<li class="tea-roster__empty">暂时没人，等你来坐第一桌。</li>
				</ul>
				<button type="button" class="tea-roster__all" data-tea-roster-all hidden>显示全部</button>
			</div>

			<div class="tea-card tea-notice">
				<header class="tea-card__head">
					<span class="tea-card__title">
						<Icon is:inline name="material-symbols:campaign-outline-rounded" /> 群公告
					</span>
				</header>
				<ul class="tea-notice__list">
					{roomRules.map((rule) => <li>{rule}</li>)}
				</ul>
			</div>
		</aside>

		<!-- ── 主区 ───────────────────────────────────────────── -->
		<div class="tea-room">
			<header class="tea-bar" data-tea-bar>
				<div class="tea-bar__brand">
					<span class="tea-bar__mark" data-tea-bar-mark>
						<img data-tea-bar-avatar src="/assets/images/room-lobby.webp" alt="" />
					</span>
					<div>
						<h1 class="tea-bar__title">{title}</h1>
						<p class="tea-bar__sub">Matrix 互联大厅</p>
					</div>
					<button type="button" class="tea-room-switch" data-tea-sites-trigger aria-expanded="false" title="查看互联茶室友站" aria-label="查看互联茶室友站">
						<Icon is:inline name="material-symbols:public-rounded" />
						<span>互联茶室</span>
						<b data-tea-sites-count>{peers.length + 1}</b><span class="tea-room-switch__unit">个站点</span>
						<Icon is:inline name="material-symbols:expand-more-rounded" class="tea-room-switch__caret" />
					</button>
				</div>
				<div class="tea-bar__tools">
					<button type="button" class="tea-search-btn" data-tea-search-open title="翻聊天记录" aria-label="翻聊天记录">
						<Icon is:inline name="material-symbols:search-rounded" />
						<span>搜索</span>
					</button>
					<span class="tea-conn" data-tea-conn><i></i><span data-tea-conn-text>连接中</span></span>
					<button type="button" class="tea-thread-pill" data-tea-threads-trigger aria-expanded="false" title="查看活跃线程回复" aria-label="查看活跃线程回复" hidden>
						<Icon is:inline name="material-symbols:forum-rounded" />
						<span>线程回复</span>
						<b data-tea-threads-count>0</b>
					</button>
					<button type="button" class="tea-icon-btn" data-tea-juke-toggle title="点歌台" aria-label="打开点歌台">
						<Icon is:inline name="material-symbols:music-note-rounded" />
					</button>
					<button type="button" class="tea-icon-btn" data-tea-roster-toggle title="在线列表" aria-label="在线列表">
						<Icon is:inline name="material-symbols:group-outline-rounded" />
					</button>
					<button type="button" class="tea-icon-btn" data-tea-refresh title="刷新" aria-label="刷新">
						<Icon is:inline name="material-symbols:refresh-rounded" />
					</button>
				</div>
			</header>

			<!-- ── 置顶消息 ───────────────────────────────────────── -->
			<div class="tea-pins" data-tea-pins hidden>
				<span class="tea-pins__icon"><Icon is:inline name="material-symbols:push-pin" /></span>
				<div class="tea-pins__body" data-tea-pins-body></div>
				<button type="button" class="tea-pins__toggle" data-tea-pins-toggle aria-label="展开或收起置顶">展开</button>
			</div>

			<!-- ── 历史定位提示条 ─────────────────────────────────── -->
			<div class="tea-historybar" data-tea-historybar hidden>
				<span class="tea-historybar__tag"><Icon is:inline name="material-symbols:history-rounded" /> 正在看历史</span>
				<span class="tea-historybar__text" data-tea-historybar-text>这是从搜索结果跳过来的位置</span>
				<button type="button" class="tea-historybar__exit" data-tea-history-exit>回到最新</button>
			</div>

			<div class="tea-feed-wrap">
				<div class="tea-feed" data-tea-feed tabindex="0" role="log" aria-live="polite" aria-label="茶室消息">
					<div class="tea-feed__status" data-tea-feed-status>
						<span class="tea-spinner"></span> 正在看看大家聊到哪儿了…
					</div>
				</div>
				<button type="button" class="tea-jump" data-tea-jump hidden>
					<Icon is:inline name="material-symbols:arrow-downward-rounded" /> 有新消息
				</button>
				<button type="button" class="tea-readjump" data-tea-readjump hidden>回到上次阅读位置 ↑</button>
				<div class="tea-typing" data-tea-typing hidden aria-live="polite"><span class="tea-typing__dots"><i></i><i></i><i></i></span><span data-tea-typing-text></span></div>
			</div>

			<form class="tea-composer" data-tea-composer autocomplete="off">
				<div class="tea-gate" data-tea-gate>
					<span class="tea-gate__icon"><Icon is:inline name="material-symbols:coffee-rounded" /></span>
					<div class="tea-gate__copy">
						<b>坐下来，一起聊聊吧</b>
						<span>填个昵称就能进，不用注册账号。</span>
					</div>
					<button type="button" class="tea-btn tea-btn--primary" data-tea-enter>进入茶室</button>
				</div>
				<div class="tea-replybar" data-tea-replybar hidden>
					<span class="tea-replybar__icon"><Icon is:inline name="material-symbols:reply-rounded" /></span>
					<span class="tea-replybar__copy"><b data-tea-reply-who></b><span data-tea-reply-text></span></span>
					<button type="button" data-tea-reply-cancel aria-label="取消回复">×</button>
				</div>
				<div class="tea-input" data-tea-input hidden>
					<div class="tea-md-preview" data-tea-md-preview hidden>
						<div class="tea-md-preview__head">
							<span>预览 Markdown</span>
							<button type="button" data-tea-md-close aria-label="切回编辑">切回编辑</button>
						</div>
						<div class="tea-md-preview__body" data-tea-md-body></div>
					</div>
					<textarea
						name="message"
						rows="1"
						maxlength="500"
						placeholder="说点什么…"
						data-tea-text
					></textarea>
					<div class="tea-input__tools">
						<button type="button" class="tea-tool" data-tea-emoji-toggle title="表情" aria-label="表情">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
						</button>
						<button type="button" class="tea-tool" data-tea-image-pick title="发送图片、视频或链接" aria-label="发送图片、视频或链接">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
						</button>
						<input type="file" accept="image/*,video/*" data-tea-image-file hidden />
						<button type="button" class="tea-tool" data-tea-poll-toggle title="发起投票" aria-label="发起投票">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><rect x="7" y="10" width="3" height="8" rx="1"/><rect x="13" y="5" width="3" height="13" rx="1"/><rect x="19" y="13" width="3" height="5" rx="1"/></svg>
						</button>
						<button type="button" class="tea-tool" data-tea-md-toggle title="预览 Markdown" aria-label="预览 Markdown">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
						</button>
						<span class="tea-input__count" data-tea-count>0/500</span>
						<button type="submit" class="tea-btn tea-btn--primary tea-send" data-tea-send>
							<span>发送</span>
							<Icon is:inline name="material-symbols:send-rounded" />
						</button>
					</div>
					<div class="tea-emoji-panel" data-tea-emoji-panel hidden></div>
					<div class="tea-mention" data-tea-mention hidden></div>
				</div>
				<p class="tea-form-error" data-tea-error hidden></p>
			</form>
		</div>

		<!-- ── 点歌台：茶室共享队列，复用站点全局播放器 ─────────── -->
		<aside class="tea-juke" data-tea-juke aria-label="点歌台">
			<header class="tea-juke__head">
				<div class="tea-juke__title">
					<Icon is:inline name="material-symbols:music-note-rounded" />
					<h2>点歌台</h2>
				</div>
				<div class="tea-juke__tools">
					<span class="tea-juke__live" data-juke-live><i></i><b>未开始</b></span>
					<button type="button" class="tea-icon-btn" data-juke-listen title="开始收听" aria-label="开始收听">
						<Icon is:inline name="material-symbols:headphones-rounded" />
					</button>
					<button type="button" class="tea-icon-btn" data-juke-close aria-label="关闭点歌台">
						<Icon is:inline name="material-symbols:close-rounded" />
					</button>
				</div>
			</header>

			<div class="tea-juke__stage">
				<div class="tea-juke__cover" data-juke-cover>
					<span class="tea-juke__eq"><i></i><i></i><i></i></span>
				</div>
				<div class="tea-juke__info">
					<div class="tea-juke__meta">
						<h3 data-juke-title>还没开始听</h3>
						<p data-juke-artist>从下面挑一首，或者让茶室随便放</p>
					</div>
					<div class="tea-juke__timeline">
						<input type="range" min="0" max="1000" step="1" value="0" data-juke-seek aria-label="播放进度" />
						<div class="tea-juke__times">
							<span data-juke-cur>0:00</span>
							<span data-juke-dur>0:00</span>
						</div>
					</div>
				</div>
			</div>

			<div class="tea-juke__controls">
				<button type="button" class="tea-juke__ctrl" data-juke-random title="随便放一首" aria-label="随便放一首">
					<Icon is:inline name="material-symbols:shuffle-rounded" />
				</button>
				<button type="button" class="tea-juke__ctrl" data-juke-prev aria-label="上一首">
					<Icon is:inline name="material-symbols:skip-previous-rounded" />
				</button>
				<button type="button" class="tea-juke__play" data-juke-play aria-label="播放">
					<span data-juke-icon-play><Icon is:inline name="material-symbols:play-arrow-rounded" /></span>
					<span data-juke-icon-pause hidden><Icon is:inline name="material-symbols:pause-rounded" /></span>
				</button>
				<button type="button" class="tea-juke__ctrl" data-juke-next aria-label="切歌或发起投票" title="切歌 / 投票">
					<Icon is:inline name="material-symbols:skip-next-rounded" />
				</button>
				<label class="tea-juke__vol" title="音量">
					<Icon is:inline name="material-symbols:volume-up-rounded" />
					<input type="range" min="0" max="100" step="1" value="70" data-juke-vol aria-label="音量" />
				</label>
			</div>

			<p class="tea-juke__notice" data-juke-notice hidden></p>

			<nav class="tea-juke__tabs" role="tablist">
				<button type="button" class="is-active" data-juke-tab="lyrics" role="tab">歌词</button>
				<button type="button" data-juke-tab="search" role="tab">搜索</button>
				<button type="button" data-juke-tab="list" role="tab">歌单</button>
				<button type="button" data-juke-tab="history" role="tab">历史</button>
			</nav>

			<div class="tea-juke__panel tea-juke__lyrics" data-juke-lyrics role="tabpanel">
				<p class="tea-juke__empty">先挑一首歌吧。</p>
			</div>
			<div class="tea-juke__panel" data-juke-search role="tabpanel" hidden>
				<div class="tea-juke__sources" data-juke-sources>
					<button type="button" class="is-active" data-juke-source="site">本站</button>
					<button type="button" data-juke-source="all">全部</button>
					<button type="button" data-juke-source="qq">QQ 音乐</button>
					<button type="button" data-juke-source="netease">网易云</button>
					<button type="button" data-juke-source="kugou">酷狗</button>
				</div>
				<form class="tea-juke__searchform" data-juke-searchform>
					<input type="search" maxlength="60" placeholder="搜歌名、歌手，或粘贴歌单链接…" data-juke-q aria-label="搜索歌曲" />
					<button type="submit" class="tea-btn tea-btn--primary">搜</button>
				</form>
				<div class="tea-juke__importbar">
					<button type="button" class="tea-juke__linkbtn" data-juke-import-toggle>导入歌单</button>
					<span>网易云 / QQ / Apple Music / Spotify</span>
				</div>
				<form class="tea-juke__importform" data-juke-importform hidden>
					<input type="url" maxlength="600" placeholder="粘贴公开歌单链接" data-juke-importurl aria-label="歌单链接" />
					<button type="submit" class="tea-btn tea-btn--primary">导入</button>
				</form>
				<div class="tea-juke__results" data-juke-results><p class="tea-juke__empty">搜全网歌曲，或者切到「本站」翻站点歌单。</p></div>
			</div>
			<div class="tea-juke__panel" data-juke-list role="tabpanel" hidden>
				<div class="tea-juke__plbar" data-juke-plbar></div>
				<div class="tea-juke__plhead" data-juke-plhead hidden>
					<span data-juke-plname></span>
					<button type="button" data-juke-pl-rotation hidden>设为轮播</button>
				</div>
				<div class="tea-juke__results" data-juke-pltracks><p class="tea-juke__empty">歌单还在路上…</p></div>
			</div>
			<div class="tea-juke__panel" data-juke-history role="tabpanel" hidden>
				<p class="tea-juke__empty">还没有播放记录。</p>
			</div>

			<div class="tea-juke__queue">
				<div class="tea-juke__queuehead">
					<span>待播 <b data-juke-queuecount>0</b></span>
					<div class="tea-juke__queuetabs">
						<button type="button" class="is-active" data-juke-queue-tab="request">点播</button>
						<button type="button" data-juke-queue-tab="rotation">轮播</button>
					</div>
				</div>
				<div class="tea-juke__queuelist" data-juke-queue><p class="tea-juke__empty">队列空着，点一首歌吧。</p></div>
			</div>
		</aside>

		<!-- ── 互联友站浮层 ─────────────────────────────────────── -->
		<div class="tea-pop tea-pop--sites" data-tea-sites-pop hidden role="dialog" aria-label="互联茶室友站列表">
			<div class="tea-pop__head">
				<span class="tea-pop__title"><Icon name="material-symbols:emoji-food-beverage-outline-rounded" /> 互联茶室</span>
				<div class="tea-pop__links">

		top: 0.14rem;
		left: 0.14rem;
		width: 0.87rem;
		height: 0.87rem;
		border-radius: 50%;
		background: #fff;
		transition: transform 0.15s;
	}
	.tea-switch input:checked + i { background: color-mix(in oklch, var(--primary) 70%, #2f6b4f); }
	.tea-switch input:checked + i::after { transform: translateX(0.95rem); }

	.tea-push { display: grid; gap: 0.5rem; }
	.tea-push__head { display: flex; align-items: flex-start; gap: 0.5rem; }
	.tea-switch__copy { flex: 1; display: grid; gap: 0.1rem; }

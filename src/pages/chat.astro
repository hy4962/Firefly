	.mc-song__copy span { font-size: 0.65rem; color: var(--tea-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.mc-song__add { flex: none; border: 1px solid color-mix(in oklch, var(--primary) 45%, transparent); border-radius: 2rem; background: transparent; color: color-mix(in oklch, var(--primary) 70%, currentColor); font-size: 0.66rem; padding: 0.25rem 0.6rem; cursor: pointer; }
	.mc-empty { font-size: 0.72rem; color: var(--tea-muted); padding: 1.5rem 0.5rem; text-align: center; }

	.tea-msg__actions {
		position: absolute;
		top: 50%;
		right: -0.35rem;
		transform: translate(100%, -50%);
		display: inline-flex;
		align-items: center;
		gap: 0.1rem;
		padding: 0.2rem 0.28rem;
		border: 1px solid var(--tea-line);
		border-radius: 999px;
		background: var(--card-bg, #fff);
		box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.15s ease;
		z-index: 4;
	}
	.tea-msg:hover .tea-msg__actions,
	.tea-msg__actions:hover,
	.tea-msg__actions:focus-within {
		opacity: 1;
		pointer-events: auto;
	}
	.tea-msg--mine .tea-msg__actions {
		right: auto;
		left: -0.35rem;
		transform: translate(-100%, -50%);
	}
	.tea-msg__action {
		width: 1.55rem;
		height: 1.55rem;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 999px;
		background: transparent;
		color: color-mix(in oklch, var(--tea-muted) 40%, #000);
		cursor: pointer;
	}
	.tea-msg__action:hover {
		color: color-mix(in oklch, var(--primary) 72%, currentColor);
		background: color-mix(in oklch, var(--primary) 12%, transparent);
	}
	.tea-msg__action svg { width: 1rem; height: 1rem; display: block; }
	.tea-msg-menu {
		position: fixed;
		z-index: 140;
		min-width: 9.5rem;
		padding: 0.28rem;
		border: 1px solid var(--tea-line);
		border-radius: 0.7rem;
		background: var(--card-bg, #fff);
		box-shadow: 0 10px 28px rgba(0, 0, 0, 0.14);
		display: grid;
		gap: 0.1rem;
	}
	.tea-msg-menu[hidden] { display: none; }
	.tea-msg-menu button {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: 100%;
		padding: 0.4rem 0.5rem;
		border: 0;
		border-radius: 0.45rem;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.74rem;
		text-align: left;
		cursor: pointer;
	}
	.tea-msg-menu button:hover { background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08)); }
	.tea-msg-menu button.is-danger { color: #c0563f; }
	.tea-msg-menu svg { width: 0.95rem; height: 0.95rem; color: var(--tea-muted); flex: none; }
	.tea-source {
		border: 0;
		padding: 0;
		background: transparent;
		max-width: min(34rem, calc(100vw - 2rem));
	}

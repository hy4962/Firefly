	.tea-notify__empty { padding: 1rem 0.6rem; text-align: center; font-size: 0.72rem; color: var(--tea-muted); }

	/* ── 个人资料弹窗 ─────────────────────────────────────── */
	.tea-dialog.tea-profile { width: min(56rem, calc(100vw - 2rem)); }

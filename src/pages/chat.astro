		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin: 0 0 0.25rem;
		padding: 0.15rem 0.4rem 0.35rem;
		border-bottom: 1px solid var(--tea-line);
		font-size: 0.72rem;
		font-weight: 600;

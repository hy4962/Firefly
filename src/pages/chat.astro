		border: 0;
		padding: 0;
		background: none;
		font: inherit;
		font-size: 0.66rem;
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
		cursor: pointer;
		flex: none;
	}
	.tea-profile__reset:hover { text-decoration: underline; }
	.tea-profile__hint { margin: 0; font-size: 0.64rem; color: var(--tea-muted); line-height: 1.5; }
	.tea-profile__hr {
		margin: 0;
		border: 0;
		border-top: 1px solid var(--tea-line);
	}

	/* 状态：固定 3 行高，超出滚动，避免 12 个标签把弹窗顶长 */
	.tea-status-grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 0.32rem;
		max-height: 6.2rem;
		overflow-y: auto;
		scrollbar-width: thin;
		padding-right: 0.1rem;
	}
	.tea-status-grid button {
		border: 1px solid var(--tea-line);
		border-radius: 0.45rem;
		background: var(--btn-regular-bg-hover, rgba(128, 128, 128, 0.1));
		color: var(--tea-muted);
		font: inherit;
		font-size: 0.68rem;
		padding: 0.34rem 0.2rem;
		cursor: pointer;
		transition: background 0.15s, border-color 0.15s, color 0.15s;
	}
	.tea-status-grid button:hover { color: inherit; background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.16)); }
	.tea-status-grid button.is-active {
		background: color-mix(in oklch, var(--primary) 22%, transparent);
		border-color: color-mix(in oklch, var(--primary) 52%, transparent);
		color: color-mix(in oklch, var(--primary) 82%, currentColor);
		font-weight: 600;
	}

	.tea-switch {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		cursor: pointer;
	}
	.tea-switch > span { flex: 1; display: grid; gap: 0.1rem; }
	.tea-switch b { font-size: 0.72rem; font-weight: 500; }
	.tea-switch small { font-size: 0.62rem; color: var(--tea-muted); line-height: 1.45; }
	.tea-switch input { position: absolute; opacity: 0; pointer-events: none; }
	.tea-switch i {
		position: relative;
		width: 2.1rem;
		height: 1.15rem;
		border-radius: 999px;
		background: rgba(128, 128, 128, 0.25);
		flex: none;
		transition: background 0.15s;

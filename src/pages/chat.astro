		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
	}
	.tea-receipt__list img,
	.tea-receipt__list span.tea-receipt__ph {
		width: 1.35rem;
		height: 1.35rem;
		flex: none;
		border-radius: 50%;
		object-fit: cover;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
		display: grid;
		place-items: center;
		font-size: 0.62rem;

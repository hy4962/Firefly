	.tea-profile__meta > span {
		max-width: 100%;
		font-size: 0.68rem;
		color: var(--tea-muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.tea-profile__meta a {
		display: inline-flex;
		align-items: center;
		gap: 0.16rem;
		max-width: 100%;
		font-size: 0.68rem;
		color: var(--tea-muted);
		text-decoration: none;
	}
	.tea-profile__meta a:hover { color: var(--primary); }
	.tea-profile__meta a svg { width: 0.8rem; height: 0.8rem; flex: none; }
	.tea-profile__meta a span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

	.tea-profile__grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.85rem 1rem;
		align-items: start;
	}
	.tea-profile__section { display: grid; gap: 0.42rem; min-width: 0; }
	.tea-profile__section h4 {
		margin: 0;
		display: flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.78rem;
		font-weight: 700;

---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "茶室";
const description = "一个连着 Matrix 公共大厅的聊天室，消息会同步到已接入的友站。";

// ── 桥接服务地址（Cloudflare Worker，见仓库 chat-bridge/ ）────────────
// 调试时可用 ?api=http://127.0.0.1:8787 覆盖，方便本地联调。
const CHAT_API = "https://tea.9ll.uk";

// 站点署名，后缀会拼到访客昵称后面同步到大厅
const SITE_NAME = "折腾进行时";

const roomRules = [
	"友善交流，别刷屏、别发广告，也别打探别人的隐私。",
	"这里是公开房间，消息会同步到 Matrix 和其他友站，别放私密内容。",
	"图片每 10 分钟最多 3 张，慢慢来。",
];

const peers = [
	{ name: "听雨茶室", url: "https://rainzt.cn/chat/" },
	{ name: "Detached", url: "https://detached.online/chat/" },
	{ name: "AIOVTUE-雪", url: "https://daily.yybb.us/chat/" },
	{ name: "冷汐的杂货铺", url: "https://lengxiqwq.com/chat/" },
	{ name: "Somoe Home", url: "https://somoe.xyz/chat/" },
];
---

<MainGridLayout title={title} description={description} heading={title}>
	<section class="tea-app" id="tea-app" data-tea-app data-api={CHAT_API} data-site={SITE_NAME}>
		<!-- ── 左栏 ───────────────────────────────────────────── -->
		<aside class="tea-side" data-tea-side>
			<div class="tea-card tea-me" data-tea-me>
				<div class="tea-me__cover" aria-hidden="true">
					<span class="tea-me__glow"></span>
					<span class="tea-me__glow tea-me__glow--b"></span>
				</div>
				<div class="tea-me__body">
					<div class="tea-me__avatar" data-tea-me-avatar aria-hidden="true">?</div>
					<div class="tea-me__name" data-tea-me-name>还没入座</div>
					<p class="tea-me__meta" data-tea-me-meta>填个昵称，就能在这儿坐下。</p>
					<div class="tea-me__stats">
						<span><b data-tea-me-count>0</b> 发言</span>
						<span class="tea-me__dot"></span>
						<span data-tea-me-since>今天刚到</span>
					</div>
					<button type="button" class="tea-btn tea-btn--ghost tea-me__act" data-tea-enter>
						<Icon is:inline name="material-symbols:login-rounded" /> 入座
					</button>
				</div>
			</div>

			<div class="tea-card tea-rooms">
				<header class="tea-card__head">
					<span class="tea-card__title">
						<Icon is:inline name="material-symbols:forum-outline-rounded" /> 房间与成员
					</span>
				</header>
				<ul class="tea-rooms__list" data-tea-rooms>
					<li class="tea-rooms__group">互联房间</li>
					<li>
						<button type="button" class="tea-room-item is-active" data-room="lobby">
							<span class="tea-room-item__avatar"><img src="/assets/images/room-lobby.svg" alt="" /></span>
							<span class="tea-room-item__copy">
								<b>互联茶室</b>
								<span>和其他站点的朋友一起聊天</span>
							</span>
						</button>
					</li>
					<li class="tea-rooms__group">本站</li>
					<li>
						<button type="button" class="tea-room-item" data-room="chat">
							<span class="tea-room-item__avatar"><img src="/assets/images/kirino.webp" alt="" loading="lazy" /></span>
							<span class="tea-room-item__copy">
								<b>闲聊</b>
								<span>随便聊聊日常与折腾</span>
							</span>
						</button>
					</li>
				</ul>
			</div>

			<div class="tea-card tea-roster">
				<header class="tea-card__head">
					<span class="tea-card__title">
						<Icon is:inline name="material-symbols:group-outline-rounded" /> 在线茶友
					</span>
					<span class="tea-roster__count"><i></i><b data-tea-online>0</b> 人在线</span>
				</header>
				<ul class="tea-roster__list" data-tea-members>
					<li class="tea-roster__empty">暂时没人，等你来坐第一桌。</li>
				</ul>
				<button type="button" class="tea-roster__all" data-tea-roster-all hidden>显示全部</button>
			</div>

			<div class="tea-card tea-notice">
				<header class="tea-card__head">
					<span class="tea-card__title">
						<Icon is:inline name="material-symbols:campaign-outline-rounded" /> 群公告
					</span>
				</header>
				<ul class="tea-notice__list">
					{roomRules.map((rule) => <li>{rule}</li>)}
				</ul>
			</div>
		</aside>

		<!-- ── 主区 ───────────────────────────────────────────── -->
		<div class="tea-room">
			<header class="tea-bar">
				<div class="tea-bar__brand">
					<span class="tea-bar__mark"><Icon is:inline name="material-symbols:emoji-food-beverage-outline-rounded" /></span>
					<div>
						<h1 class="tea-bar__title">{title}</h1>
						<p class="tea-bar__sub">Matrix 互联大厅</p>
					</div>
				</div>
				<div class="tea-bar__tools">
					<span class="tea-conn" data-tea-conn><i></i><span data-tea-conn-text>连接中</span></span>
					<button type="button" class="tea-icon-btn" data-tea-juke-toggle title="点歌台" aria-label="打开点歌台">
						<Icon is:inline name="material-symbols:music-note-rounded" />
					</button>
					<button type="button" class="tea-icon-btn" data-tea-roster-toggle title="在线列表" aria-label="在线列表">
						<Icon is:inline name="material-symbols:group-outline-rounded" />
					</button>
					<button type="button" class="tea-icon-btn" data-tea-refresh title="刷新" aria-label="刷新">
						<Icon is:inline name="material-symbols:refresh-rounded" />
					</button>
				</div>
			</header>

			<div class="tea-banner">
				<Icon is:inline name="material-symbols:public" />
				<p>
					<span data-tea-banner-text>公开房间，消息会同步到 Matrix 大厅和已接入的友站。</span>
					<span class="tea-banner__peers" data-tea-peers>
						{peers.map((p, i) => (
							<>
								{i > 0 && <span class="tea-banner__sep">、</span>}
								<a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a>
							</>
						))}
					</span>
				</p>
			</div>

			<div class="tea-feed-wrap">
				<div class="tea-feed" data-tea-feed tabindex="0" role="log" aria-live="polite" aria-label="茶室消息">
					<div class="tea-feed__status" data-tea-feed-status>
						<span class="tea-spinner"></span> 正在看看大家聊到哪儿了…
					</div>
				</div>
				<button type="button" class="tea-jump" data-tea-jump hidden>
					<Icon is:inline name="material-symbols:arrow-downward-rounded" /> 有新消息
				</button>
			</div>

			<form class="tea-composer" data-tea-composer autocomplete="off">
				<div class="tea-gate" data-tea-gate>
					<span class="tea-gate__icon"><Icon is:inline name="material-symbols:coffee-rounded" /></span>
					<div class="tea-gate__copy">
						<b>坐下来，一起聊聊吧</b>
						<span>填个昵称就能进，不用注册账号。</span>
					</div>
					<button type="button" class="tea-btn tea-btn--primary" data-tea-enter>进入茶室</button>
				</div>
				<div class="tea-input" data-tea-input hidden>
					<textarea
						name="message"
						rows="1"
						maxlength="500"
						placeholder="说点什么…（Enter 发送，Shift+Enter 换行）"
						data-tea-text
					></textarea>
					<div class="tea-input__foot">
						<span class="tea-input__hint">公开消息，会被同步出去</span>
						<span class="tea-input__count" data-tea-count>0/500</span>
						<button type="submit" class="tea-btn tea-btn--primary tea-send" data-tea-send>
							<span>发送</span>
							<Icon is:inline name="material-symbols:send-rounded" />
						</button>
					</div>
				</div>
				<p class="tea-form-error" data-tea-error hidden></p>
			</form>
		</div>

		<!-- ── 点歌台：直接驱动站点全局播放器 __fireflyMusic ──────── -->
		<aside class="tea-juke" data-tea-juke aria-label="点歌台">
			<header class="tea-juke__head">
				<div class="tea-juke__title">
					<Icon is:inline name="material-symbols:music-note-rounded" />
					<h2>点歌台</h2>
				</div>
				<div class="tea-juke__tools">
					<span class="tea-juke__live" data-juke-live><i></i><b>未开始</b></span>
					<button type="button" class="tea-icon-btn" data-juke-close aria-label="关闭点歌台">
						<Icon is:inline name="material-symbols:close-rounded" />
					</button>
				</div>
			</header>

			<div class="tea-juke__stage">
				<div class="tea-juke__cover" data-juke-cover>
					<span class="tea-juke__eq"><i></i><i></i><i></i></span>
				</div>
				<div class="tea-juke__meta">
					<span class="tea-juke__eyebrow">正在播放</span>
					<h3 data-juke-title>还没开始听</h3>
					<p data-juke-artist>从下面挑一首，或者让茶室随便放</p>
				</div>
			</div>

			<div class="tea-juke__timeline">
				<input type="range" min="0" max="1000" step="1" value="0" data-juke-seek aria-label="播放进度" />
				<div class="tea-juke__times">
					<span data-juke-cur>0:00</span>
					<span data-juke-dur>0:00</span>
				</div>
			</div>

			<div class="tea-juke__controls">
				<button type="button" class="tea-juke__ctrl" data-juke-prev aria-label="上一首">
					<Icon is:inline name="material-symbols:skip-previous-rounded" />
				</button>
				<button type="button" class="tea-juke__play" data-juke-play aria-label="播放">
					<span data-juke-icon-play><Icon is:inline name="material-symbols:play-arrow-rounded" /></span>
					<span data-juke-icon-pause hidden><Icon is:inline name="material-symbols:pause-rounded" /></span>
				</button>
				<button type="button" class="tea-juke__ctrl" data-juke-next aria-label="下一首">
					<Icon is:inline name="material-symbols:skip-next-rounded" />
				</button>
				<label class="tea-juke__vol" title="音量">
					<Icon is:inline name="material-symbols:volume-up-rounded" />
					<input type="range" min="0" max="100" step="1" value="70" data-juke-vol aria-label="音量" />
				</label>
			</div>

			<nav class="tea-juke__tabs" role="tablist">
				<button type="button" class="is-active" data-juke-tab="lyrics" role="tab">歌词</button>
				<button type="button" data-juke-tab="list" role="tab">歌单</button>
			</nav>

			<div class="tea-juke__panel" data-juke-list role="tabpanel" hidden>
				<p class="tea-juke__empty">歌单还在路上…</p>
			</div>
			<div class="tea-juke__panel tea-juke__lyrics" data-juke-lyrics role="tabpanel">
				<p class="tea-juke__empty">先挑一首歌吧。</p>
			</div>
		</aside>

		<!-- ── 图片预览 ─────────────────────────────────────────── -->
		<div class="tea-zoom" data-tea-zoom hidden>
			<button type="button" class="tea-zoom__close" data-tea-zoom-close aria-label="关闭预览">
				<Icon is:inline name="material-symbols:close-rounded" />
			</button>
			<img data-tea-zoom-img alt="" />
		</div>

		<!-- ── 遮罩（移动端抽屉 / 点歌台浮层） ─────────────────── -->
		<div class="tea-scrim" data-tea-scrim hidden></div>
		<div class="tea-scrim" data-juke-scrim hidden></div>
	</section>

	<!-- ── 身份弹窗 ─────────────────────────────────────────── -->
	<dialog class="tea-dialog" data-tea-dialog aria-labelledby="tea-dialog-title">
		<form method="dialog" class="tea-dialog__inner" data-tea-identity>
			<header class="tea-dialog__head">
				<span class="tea-dialog__icon"><Icon is:inline name="material-symbols:local-cafe-rounded" /></span>
				<button type="button" class="tea-icon-btn tea-dialog__close" data-tea-dialog-close aria-label="关闭">
					<Icon is:inline name="material-symbols:close-rounded" />
				</button>
			</header>
			<h3 id="tea-dialog-title">欢迎来喝杯茶</h3>
			<p class="tea-dialog__desc">填个昵称和邮箱就能开始聊天，邮箱不会公开显示。</p>

			<label class="tea-field">
				<span>昵称 <em>最多 8 个字</em></span>
				<input type="text" name="nick" maxlength="8" placeholder="你的名字或昵称" required />
			</label>
			<label class="tea-field">
				<span>邮箱 <em>不会公开，只用来认人</em></span>
				<input type="email" name="email" maxlength="120" placeholder="you@example.com" required />
			</label>
			<label class="tea-field">
				<span>网站 <em>选填</em></span>
				<input type="text" name="website" maxlength="120" placeholder="https://你的博客" />
			</label>

			<div class="tea-dialog__preview">
				<div class="tea-dialog__avatar" data-tea-preview-avatar>?</div>
				<div class="tea-dialog__preview-copy">
					<b data-tea-preview-name>还没填昵称</b>
					<span>会以「昵称 · {SITE_NAME}」的身份出现在大厅</span>
				</div>
			</div>

			<button type="submit" class="tea-btn tea-btn--primary tea-dialog__submit" value="ok" data-tea-submit>
				<span data-tea-submit-label>进入茶室</span>
				<Icon is:inline name="material-symbols:arrow-forward-rounded" />
			</button>
			<p class="tea-dialog__error" data-tea-dialog-error hidden></p>

			<div class="tea-dialog__divider"><span>也可以使用 Waline 账号</span></div>
			<button type="button" class="tea-btn tea-btn--ghost tea-dialog__waline" data-tea-waline-open>
				<Icon is:inline name="material-symbols:forum-outline-rounded" />
				Waline 账号登录 / 注册
			</button>
			<p class="tea-dialog__hint">同一邮箱共用茶室资料、聊天记录和网站绑定，切换登录方式无需重复填写。</p>
			<button type="button" class="tea-dialog__back" data-tea-matrix-open>
				<Icon is:inline name="material-symbols:admin-panel-settings-outline-rounded" /> 已有 Matrix 账号？登录
			</button>
		</form>

		<form method="dialog" class="tea-dialog__inner" data-tea-waline hidden>
			<header class="tea-dialog__head">
				<span class="tea-dialog__icon"><Icon is:inline name="material-symbols:forum-outline-rounded" /></span>
				<button type="button" class="tea-icon-btn tea-dialog__close" data-tea-waline-close aria-label="关闭">
					<Icon is:inline name="material-symbols:close-rounded" />
				</button>
			</header>
			<h3>用 Waline 账号进茶室</h3>
			<p class="tea-dialog__desc">用留言板那个账号登录，昵称、头像和网站直接沿用。</p>

			<label class="tea-field">
				<span>邮箱</span>
				<input type="email" name="email" autocomplete="email" maxlength="120" placeholder="you@example.com" required />
			</label>
			<label class="tea-field">
				<span>密码</span>
				<input type="password" name="password" autocomplete="current-password" maxlength="120" placeholder="Waline 密码" required />
			</label>

			<button type="submit" class="tea-btn tea-btn--primary tea-dialog__submit" data-tea-waline-submit>
				<span data-tea-waline-label>登录并进入</span>
				<Icon is:inline name="material-symbols:arrow-forward-rounded" />
			</button>
			<p class="tea-dialog__error" data-tea-waline-error hidden></p>
			<button type="button" class="tea-dialog__back" data-tea-waline-back>
				<Icon is:inline name="material-symbols:arrow-back-rounded" /> 用昵称和邮箱进入
			</button>
			<p class="tea-dialog__hint">还没注册过？先去留言板发一条评论注册，再回来登录。</p>
		</form>

		<form method="dialog" class="tea-dialog__inner" data-tea-matrix hidden>
			<header class="tea-dialog__head">
				<span class="tea-dialog__icon"><Icon is:inline name="material-symbols:admin-panel-settings-outline-rounded" /></span>
				<button type="button" class="tea-icon-btn tea-dialog__close" data-tea-matrix-close aria-label="关闭">
					<Icon is:inline name="material-symbols:close-rounded" />
				</button>
			</header>
			<h3>用 Matrix 账号进茶室</h3>
			<p class="tea-dialog__desc">站长或有 Matrix 账号的人用这个。发言直接用你自己的账号，其他站点看到的也是你。</p>

			<label class="tea-field">
				<span>服务器</span>
				<input type="text" name="homeserver" value="https://matrix.0dm.cn" readonly />
			</label>
			<label class="tea-field">
				<span>用户名</span>
				<input type="text" name="username" autocomplete="username" placeholder="heyuan" required />
			</label>
			<label class="tea-field">
				<span>密码</span>
				<input type="password" name="password" autocomplete="current-password" placeholder="Matrix 密码" required />
			</label>

			<button type="submit" class="tea-btn tea-btn--primary tea-dialog__submit" data-tea-matrix-submit>
				<span data-tea-matrix-label>登录并进入</span>
				<Icon is:inline name="material-symbols:arrow-forward-rounded" />
			</button>
			<p class="tea-dialog__error" data-tea-matrix-error hidden></p>
			<button type="button" class="tea-dialog__back" data-tea-matrix-back>
				<Icon is:inline name="material-symbols:arrow-back-rounded" /> 返回其他方式
			</button>
		</form>
	</dialog>
</MainGridLayout>

<style is:global>
	/* ─── 页面容器：固定视口，盖住侧栏，独占一屏 ─────────────── */
	html:has(.tea-app) {
		overflow: hidden !important;
		overscroll-behavior: none;
	}
	body:has(.tea-app) {
		overflow: hidden !important;
	}
	/* 上游布局的外层带 transform / 入场动画，会让 position:fixed 认错包含块，
	   这里针对本页拆掉；同时把壁纸和侧栏藏掉，给茶室一个干净的底 */
	html:has(.tea-app) :is(#content-panel, #content-panel-inner, #main-grid, #content-column, #content-wrapper, #swup-container) {
		transform: none !important;
		animation: none !important;
		opacity: 1 !important;
		contain: none !important;
	}
	html:has(.tea-app) body :is(#wallpaper-wrapper, #category-bar-wrapper, #category-bar, #left-sidebar-wrapper, #right-sidebar-wrapper, #left-sidebar, #right-sidebar, #left-sidebar-static, #right-sidebar-static, #left-sidebar-sticky, #right-sidebar-sticky, #left-sidebar-dynamic, #right-sidebar-dynamic, #mobile-bottom-sidebar, .site-footer, .floating-controls-container) {
		display: none !important;
	}
	html:has(.tea-app),
	html:has(.tea-app) body {
		background: var(--page-bg, #f6f6f1) !important;
	}

	html:has(.tea-app) {
		--tea-line: var(--line-divider, rgba(0, 0, 0, 0.08));
		--tea-line-strong: var(--line-color, rgba(0, 0, 0, 0.12));
		--tea-muted: color-mix(in oklch, currentColor 58%, transparent);
		--tea-muted-soft: color-mix(in oklch, currentColor 42%, transparent);
		--tea-surface: var(--card-bg, #fff);
		--tea-surface-2: color-mix(in oklch, var(--primary) 5%, var(--card-bg, #fff));
	}
	.tea-app {
		--tea-top: 5rem;
		--tea-gap: 1rem;
		position: fixed;
		z-index: 28;
		top: var(--tea-top);
		bottom: 0.9rem;
		left: max(var(--tea-gap), calc((100vw - var(--page-width, 100rem)) / 2));
		right: max(var(--tea-gap), calc((100vw - var(--page-width, 100rem)) / 2));
		display: grid;
		grid-template-columns: 17.5rem minmax(0, 1fr) 17.5rem;
		gap: 0.9rem;
		min-height: 0;
		color: inherit;
	}
	.tea-app.is-juke-hidden {
		grid-template-columns: 17.5rem minmax(0, 1fr);
	}
	.tea-app.is-juke-hidden .tea-juke {
		display: none;
	}

	/* ─── 通用卡片 ─────────────────────────────────────────── */
	.tea-card {
		background: var(--tea-surface);
		border: 1px solid var(--tea-line);
		border-radius: 1.1rem;
		overflow: hidden;
	}
	.tea-card__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.85rem 0.95rem 0.55rem;
	}
	.tea-card__title {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.01em;
	}
	.tea-card__title svg {
		width: 1rem;
		height: 1rem;
		opacity: 0.72;
	}

	/* ─── 左栏 ─────────────────────────────────────────────── */
	.tea-side {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-height: 0;
		overflow-y: auto;
		scrollbar-width: thin;
		padding-right: 2px;
	}
	.tea-side::-webkit-scrollbar {
		width: 4px;
	}
	.tea-side::-webkit-scrollbar-thumb {
		background: color-mix(in oklch, currentColor 18%, transparent);
		border-radius: 999px;
	}

	/* 名片 */
	.tea-me {
		flex: none;
		position: relative;
	}
	.tea-me__cover {
		position: relative;
		height: 5.6rem;
		overflow: hidden;
		background:
			linear-gradient(120deg, color-mix(in oklch, var(--primary) 34%, transparent), transparent 62%),
			color-mix(in oklch, var(--primary) 10%, var(--card-bg, #fff));
	}
	.tea-me__glow {
		position: absolute;
		width: 7rem;
		height: 7rem;
		border-radius: 50%;
		background: color-mix(in oklch, var(--primary) 42%, transparent);
		filter: blur(26px);
		top: -2.6rem;
		left: -1.2rem;
	}
	.tea-me__glow--b {
		top: auto;
		left: auto;
		right: -1.6rem;
		bottom: -3rem;
		opacity: 0.65;
		background: color-mix(in oklch, var(--primary) 26%, transparent);
	}
	.tea-me__line {
		display: none;
	}
	.tea-me__body {
		position: relative;
		z-index: 1;
		padding: 0 1rem 1rem;
		margin-top: -1.75rem;
		display: grid;
		justify-items: center;
		text-align: center;
		gap: 0.3rem;
	}
	.tea-me__avatar {
		width: 3.4rem;
		height: 3.4rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: 1.15rem;
		font-weight: 600;
		color: #fff;
		background: linear-gradient(150deg, color-mix(in oklch, var(--primary) 92%, white), color-mix(in oklch, var(--primary) 66%, #1f2937));
		border: 3px solid var(--tea-surface);
		box-shadow: 0 6px 18px -8px color-mix(in oklch, var(--primary) 70%, transparent);
		background-size: cover;
		background-position: center;
	}
	.tea-me__name {
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.tea-me__meta {
		margin: 0;
		font-size: 0.72rem;
		line-height: 1.55;
		color: var(--tea-muted);
	}
	.tea-me__stats {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.7rem;
		color: var(--tea-muted);
		margin-top: 0.1rem;
	}
	.tea-me__stats b {
		font-weight: 600;
		color: inherit;
	}
	.tea-me__dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.35;
	}
	.tea-me__act {
		margin-top: 0.35rem;
		font-size: 0.75rem;
		padding: 0.35rem 0.9rem;
	}

	/* 房间列表 */
	.tea-rooms {
		flex: none;
	}
	.tea-rooms__list {
		list-style: none;
		margin: 0;
		padding: 0 0.45rem 0.55rem;
		display: grid;
		gap: 0.15rem;
	}
	.tea-rooms__group {
		font-size: 0.62rem;
		letter-spacing: 0.04em;
		color: var(--tea-muted-soft);
		padding: 0.35rem 0.45rem 0.15rem;
	}
	.tea-room-item {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: 100%;
		padding: 0.38rem 0.45rem;
		border: 1px solid transparent;
		border-radius: 0.6rem;
		background: transparent;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition: background 0.15s ease, border-color 0.15s ease;
	}
	.tea-room-item:hover {
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-room-item.is-active {
		background: color-mix(in oklch, var(--primary) 10%, transparent);
		border-color: color-mix(in oklch, var(--primary) 22%, transparent);
	}
	.tea-room-item__hash {
		width: 1.5rem;
		height: 1.5rem;
		flex: none;
		display: grid;
		place-items: center;
		border-radius: 0.5rem;
		font-size: 0.72rem;
		font-weight: 600;
		color: color-mix(in oklch, var(--primary) 72%, currentColor);
		background: color-mix(in oklch, var(--primary) 12%, transparent);
	}
	.tea-room-item__avatar {
		width: 1.5rem;
		height: 1.5rem;
		flex: none;
		display: grid;
		place-items: center;
		border-radius: 0.5rem;
		overflow: hidden;
		background: color-mix(in oklch, var(--primary) 12%, transparent);
	}
	.tea-room-item__avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.tea-room-item__copy {
		min-width: 0;
		display: grid;
		gap: 0.05rem;
	}
	.tea-room-item__copy b {
		font-size: 0.76rem;
		font-weight: 600;
	}
	.tea-room-item__copy span {
		font-size: 0.64rem;
		color: var(--tea-muted-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* 在线列表 */
	.tea-roster {
		flex: 1 0 auto;
		display: flex;
		flex-direction: column;
		min-height: 9rem;
	}
	.tea-roster__count {
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
		font-size: 0.68rem;
		color: var(--tea-muted);
	}
	.tea-roster__count i {
		width: 0.36rem;
		height: 0.36rem;
		border-radius: 50%;
		background: #34c759;
		box-shadow: 0 0 0 3px color-mix(in oklch, #34c759 22%, transparent);
	}
	.tea-roster__count b {
		font-weight: 600;
	}
	.tea-roster__list {
		list-style: none;
		margin: 0;
		padding: 0 0.45rem 0.55rem;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		scrollbar-width: thin;
	}
	.tea-roster__empty {
		padding: 0.6rem 0.5rem 0.9rem;
		font-size: 0.74rem;
		color: var(--tea-muted-soft);
	}
	.tea-member {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.42rem 0.45rem;
		border-radius: 0.55rem;
		font-size: 0.78rem;
		border-bottom: 1px dashed color-mix(in oklch, currentColor 12%, transparent);
	}
	.tea-member:last-child {
		border-bottom: 0;
	}
	.tea-member:hover {
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-member__badge {
		margin-left: auto;
		flex: none;
		font-size: 0.62rem;
		line-height: 1;
		padding: 0.22rem 0.5rem;
		border-radius: 999px;
		border: 1px solid transparent;
		white-space: nowrap;
	}
	.tea-member__badge.is-online {
		color: #2f9e6b;
		background: color-mix(in oklch, #2f9e6b 12%, transparent);
		border-color: color-mix(in oklch, #2f9e6b 28%, transparent);
	}
	.tea-member__badge.is-away {
		color: #b07d12;
		background: color-mix(in oklch, #e0a020 16%, transparent);
		border-color: color-mix(in oklch, #e0a020 32%, transparent);
	}
	.dark .tea-member__badge.is-online {
		color: #5fd39a;
	}
	.dark .tea-member__badge.is-away {
		color: #f0c264;
	}
	.tea-member__avatar {
		width: 1.7rem;
		height: 1.7rem;
		border-radius: 50%;
		flex: none;
		display: grid;
		place-items: center;
		font-size: 0.7rem;
		font-weight: 600;
		color: #fff;
		background-size: cover;
		background-position: center;
	}
	.tea-member__copy {
		min-width: 0;
		display: grid;
		gap: 0.05rem;
	}
	.tea-member__name {
		font-weight: 500;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tea-member__site {
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tea-member--idle {
		opacity: 0.92;
	}
	.tea-roster__all {
		flex: none;
		margin: 0 0.55rem 0.6rem;
		padding: 0.42rem 0.5rem;
		border-radius: 0.6rem;
		border: 1px solid var(--tea-line);
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.72rem;
		cursor: pointer;
		opacity: 0.75;
		transition: opacity 0.15s ease, background 0.15s ease;
	}
	.tea-roster__all:hover {
		opacity: 1;
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}

	/* 公告 */
	.tea-notice {
		flex: none;
	}
	.tea-notice__list {
		margin: 0;
		padding: 0 0.95rem 0.9rem;
		list-style: none;
		display: grid;
		gap: 0.4rem;
		font-size: 0.73rem;
		line-height: 1.65;
		color: var(--tea-muted);
		counter-reset: rule;
	}
	.tea-notice__list li {
		position: relative;
		padding-left: 0.95rem;
	}
	.tea-notice__list li::before {
		counter-increment: rule;
		content: counter(rule);
		position: absolute;
		left: 0;
		top: 0.05rem;
		font-size: 0.6rem;
		font-weight: 700;
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
		opacity: 0.85;
	}

	/* ─── 主区 ─────────────────────────────────────────────── */
	.tea-room {
		position: relative;
		display: grid;
		grid-template-rows: auto auto minmax(0, 1fr) auto;
		min-height: 0;
		background: var(--tea-surface);
		border: 1px solid var(--tea-line);
		border-radius: 1.1rem;
		overflow: hidden;
	}
	.tea-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 0.95rem;
		border-bottom: 1px solid var(--tea-line);
	}
	.tea-bar__brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
	}
	.tea-bar__mark {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 0.7rem;
		display: grid;
		place-items: center;
		color: color-mix(in oklch, var(--primary) 82%, #3f2d0a);
		background: color-mix(in oklch, var(--primary) 16%, transparent);
		border: 1px solid color-mix(in oklch, var(--primary) 26%, transparent);
		flex: none;
	}
	.tea-bar__mark svg {
		width: 1.15rem;
		height: 1.15rem;
	}
	.tea-bar__title {
		margin: 0;
		font-size: 0.98rem;
		font-weight: 600;
		line-height: 1.25;
	}
	.tea-bar__sub {
		margin: 0;
		font-size: 0.68rem;
		color: var(--tea-muted-soft);
		letter-spacing: 0.02em;
	}
	.tea-bar__tools {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.tea-conn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.7rem;
		color: var(--tea-muted);
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--tea-line);
		margin-right: 0.15rem;
		white-space: nowrap;
	}
	.tea-conn i {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.45;
	}
	.tea-conn.is-live {
		color: #2f9e6b;
		border-color: color-mix(in oklch, #2f9e6b 30%, transparent);
		background: color-mix(in oklch, #2f9e6b 8%, transparent);
	}
	.tea-conn.is-live i {
		opacity: 1;
		box-shadow: 0 0 0 3px color-mix(in oklch, #2f9e6b 20%, transparent);
	}
	.tea-conn.is-down {
		color: #c0563f;
		border-color: color-mix(in oklch, #c0563f 30%, transparent);
	}
	.tea-icon-btn {
		width: 2rem;
		height: 2rem;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 0.6rem;
		background: transparent;
		color: inherit;
		cursor: pointer;
		opacity: 0.72;
		transition: background 0.15s ease, opacity 0.15s ease;
	}
	.tea-icon-btn:hover {
		opacity: 1;
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.1));
	}
	.tea-icon-btn svg {
		width: 1.15rem;
		height: 1.15rem;
	}

	/* 互联提示条 */
	.tea-banner {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		margin: 0.7rem 0.95rem 0;
		padding: 0.5rem 0.7rem;
		border-radius: 0.75rem;
		background: color-mix(in oklch, var(--primary) 8%, transparent);
		border: 1px solid color-mix(in oklch, var(--primary) 16%, transparent);
		font-size: 0.72rem;
		line-height: 1.6;
		color: var(--tea-muted);
	}
	.tea-banner > svg {
		width: 0.95rem;
		height: 0.95rem;
		flex: none;
		margin-top: 0.18rem;
		color: color-mix(in oklch, var(--primary) 72%, currentColor);
	}
	.tea-banner p {
		margin: 0;
	}
	.tea-banner a {
		color: color-mix(in oklch, var(--primary) 62%, #4b3a12);
		text-decoration: none;
		border-bottom: 1px solid color-mix(in oklch, var(--primary) 30%, transparent);
	}
	.tea-banner a:hover {
		border-bottom-color: currentColor;
	}
	.tea-banner__sep {
		opacity: 0.5;
	}

	/* 消息流 */
	.tea-feed-wrap {
		position: relative;
		min-height: 0;
	}
	.tea-feed {
		height: 100%;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.9rem 1rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.95rem;
		scrollbar-width: thin;
		outline: none;
	}
	.tea-feed::-webkit-scrollbar {
		width: 6px;
	}
	.tea-feed__status {
		margin: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.78rem;
		color: var(--tea-muted-soft);
		text-align: center;
	}
	.tea-feed__status--error {
		flex-direction: column;
		gap: 0.45rem;
	}
	.tea-feed__status--error b {
		font-size: 0.88rem;
		font-weight: 600;
		color: inherit;
		opacity: 0.85;
	}
	.tea-feed__status--error span {
		font-size: 0.72rem;
		opacity: 0.7;
		word-break: break-word;
	}
	.tea-spinner {
		width: 0.85rem;
		height: 0.85rem;
		border-radius: 50%;
		border: 2px solid color-mix(in oklch, var(--primary) 30%, transparent);
		border-top-color: var(--primary);
		animation: tea-spin 0.8s linear infinite;
		flex: none;
	}
	@keyframes tea-spin {
		to {
			transform: rotate(360deg);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.tea-spinner {
			animation-duration: 2s;
		}
	}
	.tea-empty {
		margin: auto;
		text-align: center;
		display: grid;
		gap: 0.3rem;
		color: var(--tea-muted-soft);
	}
	.tea-empty b {
		font-size: 0.9rem;
		font-weight: 600;
		color: inherit;
		opacity: 0.8;
	}
	.tea-empty span {
		font-size: 0.74rem;
	}

	.tea-day {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.68rem;
		color: var(--tea-muted-soft);
		margin: 0.2rem 0 -0.25rem;
	}
	.tea-day::before,
	.tea-day::after {
		content: "";
		height: 1px;
		flex: 1;
		background: var(--tea-line);
	}

	.tea-msg {
		display: grid;
		grid-template-columns: 2.1rem minmax(0, 1fr);
		gap: 0.6rem;
		align-items: start;
	}
	.tea-msg__avatar {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: 0.78rem;
		font-weight: 600;
		color: #fff;
		background-size: cover;
		background-position: center;
		flex: none;
	}
	.tea-msg__body {
		min-width: 0;
	}
	.tea-msg__head {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 0.16rem;
	}
	.tea-msg__nick {
		font-size: 0.8rem;
		font-weight: 600;
	}
	.tea-msg__site {
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
		border-radius: 999px;
		padding: 0.05rem 0.42rem;
		white-space: nowrap;
	}
	.tea-msg__time {
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		font-variant-numeric: tabular-nums;
	}
	.tea-msg__text {
		font-size: 0.86rem;
		line-height: 1.7;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.tea-msg__text a {
		color: color-mix(in oklch, var(--primary) 60%, #4b3a12);
		text-decoration: underline;
		text-decoration-color: color-mix(in oklch, var(--primary) 35%, transparent);
		text-underline-offset: 2px;
	}
	.tea-msg__text img {
		display: block;
		max-width: min(100%, 17rem);
		max-height: 14rem;
		border-radius: 0.7rem;
		margin-top: 0.3rem;
		border: 1px solid var(--tea-line);
		cursor: zoom-in;
		transition: filter 0.15s ease;
	}
	.tea-msg__text img:hover {
		filter: brightness(1.04);
	}
	.tea-msg__text pre {
		margin: 0.35rem 0 0;
		padding: 0.5rem 0.65rem;
		border-radius: 0.6rem;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
		overflow-x: auto;
		font-size: 0.74rem;
		line-height: 1.65;
		white-space: pre;
	}
	.tea-msg__text code {
		font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
		font-size: 0.94em;
	}
	.tea-msg__text strong {
		font-weight: 600;
	}
	.tea-msg__reply {
		margin: 0 0 0.3rem;
		padding: 0.3rem 0.55rem;
		border-left: 2px solid color-mix(in oklch, var(--primary) 55%, transparent);
		border-radius: 0 0.45rem 0.45rem 0;
		background: color-mix(in oklch, var(--primary) 8%, var(--btn-regular-bg, rgba(128, 128, 128, 0.08)));
		font-size: 0.76rem;
		line-height: 1.5;
	}
	.tea-msg__reply b {
		display: block;
		font-size: 0.7rem;
		font-weight: 600;
		color: color-mix(in oklch, var(--primary) 62%, currentColor);
	}
	.tea-msg__reply span {
		display: block;
		opacity: 0.78;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.tea-msg--grouped {
		margin-top: -0.55rem;
	}
	.tea-msg--grouped .tea-msg__avatar {
		visibility: hidden;
		height: 0;
	}
	.tea-msg--grouped .tea-msg__head {
		display: none;
	}
	.tea-msg--mine .tea-msg__nick {
		color: color-mix(in oklch, var(--primary) 66%, currentColor);
	}
	.tea-msg--mine .tea-msg__text {
		background: color-mix(in oklch, var(--primary) 11%, transparent);
		border: 1px solid color-mix(in oklch, var(--primary) 18%, transparent);
		border-radius: 0.75rem;
		padding: 0.42rem 0.62rem;
		display: inline-block;
	}
	.tea-msg--pending {
		opacity: 0.55;
	}
	.tea-msg--failed .tea-msg__text {
		border-color: color-mix(in oklch, #c0563f 45%, transparent);
	}
	.tea-msg__retry {
		font-size: 0.68rem;
		color: #c0563f;
		background: none;
		border: 0;
		padding: 0.2rem 0 0;
		cursor: pointer;
	}

	/* ── 已读回执 ───────────────────────────────────────── */
	.tea-receipt {
		position: relative;
		display: inline-flex;
		align-items: center;
		margin-top: 0.2rem;
	}
	.tea-receipt__trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		min-height: 1.35rem;
		padding: 0 0.3rem;
		border: 0;
		border-radius: 0.6rem;
		background: transparent;
		color: var(--tea-muted-soft);
		font-size: 0.66rem;
		cursor: pointer;
	}
	.tea-receipt__trigger:hover,
	.tea-receipt__trigger[aria-expanded="true"] {
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
	}
	.tea-receipt__faces {
		display: inline-flex;
		align-items: center;
	}
	.tea-receipt__faces img {
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 50%;
		object-fit: cover;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
		border: 1px solid var(--card-bg, #fff);
	}
	.tea-receipt__faces img + img {
		margin-inline-start: -0.3rem;
	}
	.tea-receipt__faces span {
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: 0.5rem;
		font-weight: 600;
		color: #fff;
		border: 1px solid var(--card-bg, #fff);
	}
	.tea-receipt__faces span + span,
	.tea-receipt__faces img + span {
		margin-inline-start: -0.3rem;
	}
	.tea-receipt__pop {
		position: fixed;
		z-index: 100;
		width: min(15rem, calc(100vw - 2rem));
		max-height: min(18rem, 60vh);
		overflow-y: auto;
		overscroll-behavior: contain;
		border: 1px solid var(--tea-line);
		border-radius: 0.8rem;
		background: var(--card-bg, #fff);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
		padding: 0.35rem;
	}
	.tea-receipt__pop[hidden] {
		display: none;
	}
	.tea-receipt__pop h5 {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin: 0 0 0.25rem;
		padding: 0.15rem 0.4rem 0.35rem;
		border-bottom: 1px solid var(--tea-line);
		font-size: 0.72rem;
		font-weight: 600;
	}
	.tea-receipt__pop h5 small {
		color: var(--tea-muted-soft);
		font-weight: 400;
	}
	.tea-receipt__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.tea-receipt__list li {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.28rem 0.4rem;
		border-radius: 0.45rem;
		font-size: 0.72rem;
	}
	.tea-receipt__list li:hover {
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
	}
	.tea-receipt__list img,
	.tea-receipt__list span.tea-receipt__ph {
		width: 1.35rem;
		height: 1.35rem;
		flex: none;
		border-radius: 50%;
		object-fit: cover;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
		display: grid;
		place-items: center;
		font-size: 0.62rem;
	}
	.tea-receipt__who {
		min-width: 0;
		display: grid;
	}
	.tea-receipt__who small {
		color: var(--tea-muted-soft);
		font-size: 0.62rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.tea-jump {
		position: absolute;
		left: 50%;
		bottom: 0.7rem;
		transform: translateX(-50%);
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		border: 1px solid var(--tea-line-strong);
		background: var(--tea-surface);
		color: inherit;
		font-size: 0.72rem;
		box-shadow: 0 8px 22px -14px rgba(0, 0, 0, 0.5);
		cursor: pointer;
	}
	.tea-jump svg {
		width: 0.9rem;
		height: 0.9rem;
	}

	/* 输入区 */
	.tea-composer {
		border-top: 1px solid var(--tea-line);
		padding: 0.7rem 0.95rem 0.8rem;
		display: grid;
		gap: 0.4rem;
	}
	.tea-gate {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.6rem 0.7rem;
		border-radius: 0.9rem;
		background: color-mix(in oklch, var(--primary) 6%, transparent);
		border: 1px dashed color-mix(in oklch, var(--primary) 30%, transparent);
	}
	.tea-gate__icon {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 0.7rem;
		display: grid;
		place-items: center;
		background: color-mix(in oklch, var(--primary) 16%, transparent);
		color: color-mix(in oklch, var(--primary) 74%, currentColor);
		flex: none;
	}
	.tea-gate__icon svg {
		width: 1.15rem;
		height: 1.15rem;
	}
	.tea-gate__copy {
		display: grid;
		gap: 0.1rem;
		min-width: 0;
		flex: 1;
	}
	.tea-gate__copy b {
		font-size: 0.84rem;
		font-weight: 600;
	}
	.tea-gate__copy span {
		font-size: 0.72rem;
		color: var(--tea-muted);
	}

	.tea-input {
		display: grid;
		gap: 0.35rem;
	}
	.tea-input textarea {
		width: 100%;
		resize: none;
		min-height: 2.5rem;
		max-height: 8rem;
		padding: 0.55rem 0.7rem;
		border-radius: 0.75rem;
		border: 1px solid var(--tea-line-strong);
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.86rem;
		line-height: 1.6;
		outline: none;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.tea-input textarea:focus {
		border-color: color-mix(in oklch, var(--primary) 48%, transparent);
		box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 14%, transparent);
	}
	.tea-input__foot {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.tea-input__hint {
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		flex: 1;
	}
	.tea-input__count {
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		font-variant-numeric: tabular-nums;
	}

	/* 按钮 */
	.tea-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		border-radius: 0.65rem;
		border: 1px solid transparent;
		font: inherit;
		font-size: 0.78rem;
		font-weight: 500;
		padding: 0.45rem 0.9rem;
		cursor: pointer;
		transition: transform 0.12s ease, filter 0.15s ease, background 0.15s ease;
		white-space: nowrap;
	}
	.tea-btn svg {
		width: 1rem;
		height: 1rem;
	}
	.tea-btn--primary {
		background: var(--primary);
		color: color-mix(in oklch, var(--primary) 22%, #2b2205);
		box-shadow: 0 8px 18px -12px color-mix(in oklch, var(--primary) 80%, transparent);
	}
	.tea-btn--primary:hover {
		filter: brightness(1.04);
	}
	.tea-btn--primary:active {
		transform: translateY(1px);
	}
	.tea-btn--ghost {
		background: transparent;
		border-color: var(--tea-line-strong);
		color: inherit;
	}
	.tea-btn--ghost:hover {
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-btn:disabled {
		opacity: 0.5;
		cursor: not-allowed;
		transform: none;
	}
	.tea-send {
		padding: 0.42rem 0.8rem;
	}
	.tea-form-error {
		margin: 0;
		font-size: 0.72rem;
		color: #c0563f;
	}

	/* ─── 点歌台 ───────────────────────────────────────────── */
	.tea-juke {
		display: flex;
		flex-direction: column;
		min-height: 0;
		background: var(--tea-surface);
		border: 1px solid var(--tea-line);
		border-radius: 1.1rem;
		overflow: hidden;
	}
	.tea-juke__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.7rem 0.8rem;
		border-bottom: 1px solid var(--tea-line);
		flex: none;
	}
	.tea-juke__title {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		min-width: 0;
	}
	.tea-juke__title svg {
		width: 1rem;
		height: 1rem;
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
	}
	.tea-juke__title h2 {
		margin: 0;
		font-size: 0.86rem;
		font-weight: 600;
	}
	.tea-juke__tools {
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}
	.tea-juke__live {
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		white-space: nowrap;
	}
	.tea-juke__live i {
		width: 0.34rem;
		height: 0.34rem;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.5;
	}
	.tea-juke__live b {
		font-weight: 400;
	}
	.tea-juke__live.is-playing {
		color: #2f9e6b;
	}
	.tea-juke__live.is-playing i {
		opacity: 1;
		box-shadow: 0 0 0 3px color-mix(in oklch, #2f9e6b 20%, transparent);
	}

	.tea-juke__stage {
		display: grid;
		gap: 0.55rem;
		padding: 0.75rem 0.8rem 0;
		flex: none;
	}
	.tea-juke__cover {
		position: relative;
		aspect-ratio: 16 / 10;
		border-radius: 0.8rem;
		background-color: color-mix(in oklch, var(--primary) 12%, transparent);
		background-size: cover;
		background-position: center;
		border: 1px solid var(--tea-line);
		overflow: hidden;
	}
	.tea-juke__eq {
		position: absolute;
		left: 0.55rem;
		bottom: 0.55rem;
		display: flex;
		align-items: flex-end;
		gap: 0.14rem;
		height: 0.85rem;
		padding: 0.18rem 0.32rem;
		border-radius: 0.4rem;
		background: rgba(0, 0, 0, 0.35);
		backdrop-filter: blur(4px);
	}
	.tea-juke__eq i {
		width: 2px;
		background: #fff;
		border-radius: 1px;
		height: 30%;
		opacity: 0.55;
	}
	.tea-juke__eq i:nth-child(2) {
		height: 70%;
	}
	.tea-juke__eq i:nth-child(3) {
		height: 45%;
	}
	.tea-juke.is-playing .tea-juke__eq i {
		animation: tea-eq 0.9s ease-in-out infinite alternate;
		opacity: 1;
	}
	.tea-juke.is-playing .tea-juke__eq i:nth-child(2) {
		animation-delay: -0.3s;
	}
	.tea-juke.is-playing .tea-juke__eq i:nth-child(3) {
		animation-delay: -0.6s;
	}
	@keyframes tea-eq {
		from {
			height: 22%;
		}
		to {
			height: 100%;
		}
	}
	.tea-juke__meta {
		min-width: 0;
	}
	.tea-juke__eyebrow {
		font-size: 0.6rem;
		letter-spacing: 0.08em;
		color: var(--tea-muted-soft);
	}
	.tea-juke__meta h3 {
		margin: 0.05rem 0 0;
		font-size: 0.84rem;
		font-weight: 600;
		line-height: 1.35;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tea-juke__meta p {
		margin: 0.1rem 0 0;
		font-size: 0.68rem;
		color: var(--tea-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.tea-juke__timeline {
		padding: 0.55rem 0.8rem 0;
		flex: none;
	}
	.tea-juke input[type="range"] {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 3px;
		border-radius: 999px;
		background: linear-gradient(
			to right,
			var(--primary) 0%,
			var(--primary) var(--p, 0%),
			color-mix(in oklch, currentColor 14%, transparent) var(--p, 0%),
			color-mix(in oklch, currentColor 14%, transparent) 100%
		);
		outline: none;
		cursor: pointer;
	}
	.tea-juke input[type="range"]::-webkit-slider-thumb {
		-webkit-appearance: none;
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--primary);
		border: 2px solid var(--tea-surface);
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
	}
	.tea-juke input[type="range"]::-moz-range-thumb {
		width: 0.6rem;
		height: 0.6rem;
		border: 2px solid var(--tea-surface);
		border-radius: 50%;
		background: var(--primary);
	}
	.tea-juke__times {
		display: flex;
		justify-content: space-between;
		font-size: 0.62rem;
		color: var(--tea-muted-soft);
		margin-top: 0.2rem;
		font-variant-numeric: tabular-nums;
	}

	.tea-juke__controls {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem 0.8rem 0.6rem;
		flex: none;
	}
	.tea-juke__ctrl,
	.tea-juke__play {
		border: 0;
		background: transparent;
		color: inherit;
		cursor: pointer;
		display: grid;
		place-items: center;
		border-radius: 50%;
		opacity: 0.75;
	}
	.tea-juke__ctrl {
		width: 1.9rem;
		height: 1.9rem;
	}
	.tea-juke__ctrl:hover {
		opacity: 1;
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.1));
	}
	.tea-juke__ctrl svg {
		width: 1.1rem;
		height: 1.1rem;
	}
	.tea-juke__play {
		width: 2.35rem;
		height: 2.35rem;
		background: var(--primary);
		color: color-mix(in oklch, var(--primary) 20%, #2b2205);
		box-shadow: 0 8px 18px -12px color-mix(in oklch, var(--primary) 80%, transparent);
		opacity: 1;
	}
	.tea-juke__play svg {
		width: 1.25rem;
		height: 1.25rem;
	}
	.tea-juke__play span {
		display: grid;
		place-items: center;
	}
	.tea-juke__play span[hidden] {
		display: none;
	}
	.tea-juke__vol {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		margin-left: auto;
		flex: 1;
		max-width: 5.6rem;
		color: var(--tea-muted-soft);
	}
	.tea-juke__vol svg {
		width: 0.9rem;
		height: 0.9rem;
		flex: none;
	}

	.tea-juke__tabs {
		display: flex;
		gap: 0.2rem;
		padding: 0 0.7rem;
		border-top: 1px solid var(--tea-line);
		flex: none;
	}
	.tea-juke__tabs button {
		border: 0;
		background: none;
		color: var(--tea-muted);
		font: inherit;
		font-size: 0.72rem;
		padding: 0.5rem 0.4rem 0.45rem;
		cursor: pointer;
		border-bottom: 2px solid transparent;
	}
	.tea-juke__tabs button.is-active {
		color: inherit;
		font-weight: 600;
		border-bottom-color: var(--primary);
	}
	.tea-juke__panel {
		flex: 1 1 auto;
		min-height: 5rem;
		overflow-y: auto;
		padding: 0.35rem 0.4rem 0.6rem;
		scrollbar-width: thin;
	}
	.tea-juke__empty {
		margin: 0;
		padding: 0.6rem 0.4rem;
		font-size: 0.7rem;
		color: var(--tea-muted-soft);
	}
	.tea-song {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: 100%;
		padding: 0.3rem 0.4rem;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		border-radius: 0.55rem;
		cursor: pointer;
	}
	.tea-song:hover {
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-song.is-current {
		background: color-mix(in oklch, var(--primary) 10%, transparent);
	}
	.tea-song__idx {
		width: 1rem;
		flex: none;
		font-size: 0.62rem;
		color: var(--tea-muted-soft);
		font-variant-numeric: tabular-nums;
		text-align: center;
	}
	.tea-song.is-current .tea-song__idx {
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
	}
	.tea-song__copy {
		min-width: 0;
		display: grid;
	}
	.tea-song__name {
		font-size: 0.74rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tea-song__artist {
		font-size: 0.64rem;
		color: var(--tea-muted-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tea-juke__lyrics {
		font-size: 0.75rem;
		text-align: center;
		padding: 0.5rem 0.5rem 3rem;
		-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 1.4rem, #000 calc(100% - 1.6rem), transparent 100%);
		mask-image: linear-gradient(to bottom, transparent 0, #000 1.4rem, #000 calc(100% - 1.6rem), transparent 100%);
	}
	.tea-lyric {
		display: block;
		width: 100%;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		font-size: 0.75rem;
		line-height: 2.05;
		padding: 0.08rem 0.3rem;
		text-align: center;
		cursor: pointer;
		border-radius: 0.45rem;
		opacity: 0.58;
		transition: opacity 0.2s ease, color 0.2s ease;
	}
	.tea-lyric:hover {
		opacity: 0.95;
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-lyric.is-current {
		opacity: 1;
		font-weight: 600;
		color: color-mix(in oklch, var(--primary) 74%, currentColor);
	}
	.dark .tea-lyric.is-current {
		color: color-mix(in oklch, var(--primary) 86%, white);
	}

	/* ─── 图片预览 ─────────────────────────────────────────── */
	.tea-zoom {
		position: fixed;
		inset: 0;
		z-index: 60;
		display: grid;
		place-items: center;
		padding: 5vh 4vw;
		background: rgba(14, 16, 12, 0.78);
		backdrop-filter: blur(8px);
		animation: tea-zoom-in 0.18s ease-out;
		cursor: zoom-out;
	}
	.tea-zoom[hidden] {
		display: none;
	}
	.tea-zoom img {
		max-width: min(92vw, 1400px);
		max-height: 88vh;
		border-radius: 0.8rem;
		box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
		object-fit: contain;
		cursor: default;
	}
	.tea-zoom__close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		width: 2.4rem;
		height: 2.4rem;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.92);
		color: #1f2418;
		cursor: pointer;
		box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.7);
	}
	.tea-zoom__close svg {
		width: 1.2rem;
		height: 1.2rem;
	}
	@keyframes tea-zoom-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.tea-zoom {
			animation: none;
		}
	}

	/* ─── 弹窗 ─────────────────────────────────────────────── */
	.tea-dialog {
		border: 0;

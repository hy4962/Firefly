	.tea-msg__reactions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin-top: 0.2rem;
	}
	.tea-msg__reaction {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.1rem 0.4rem;
		border: 1px solid var(--tea-line);
		border-radius: 999px;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.08));
		font-size: 0.72rem;
		cursor: pointer;

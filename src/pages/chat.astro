	.tea-switch__copy small { font-size: 0.62rem; color: var(--tea-muted); line-height: 1.45; }
	.tea-seg { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.3rem; }
	.tea-seg button {
		padding: 0.4rem 0.2rem;
		border: 1px solid var(--tea-line);
		border-radius: 0.5rem;
		background: var(--tea-surface, #fff);
		color: var(--tea-muted);
		font: inherit;
		font-size: 0.7rem;
		cursor: pointer;
		transition: background 0.15s, border-color 0.15s, color 0.15s;
	}
	.tea-seg button:hover { color: inherit; }
	.tea-seg button.is-active {
		background: var(--primary);
		border-color: transparent;
		color: color-mix(in oklch, var(--primary) 22%, #2b2205);
		font-weight: 600;
	}

	.tea-profile__foot {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.15rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--tea-line);
	}
	.tea-profile__foot .tea-btn { font-size: 0.72rem; padding: 0.38rem 0.7rem; }
	/* 说明：.tea-btn--ghost 里写了 color: inherit，且在文件后面；
	   这里必须多一层前缀，否则红色被压掉 */
	.tea-profile__foot .tea-profile__logout { color: #c0563f; border-color: transparent; }
	.tea-profile__save { min-width: 6.5rem; justify-content: center; }
	.tea-profile__spacer { flex: 1; }
	@media (max-width: 720px) {
		.tea-profile__grid { grid-template-columns: 1fr; }
		.tea-profile__meta { max-width: 40%; }
		.tea-profile__foot .tea-btn { flex: 1; justify-content: center; }
		.tea-profile__spacer { display: none; }
	}

	/* ── 茶室搜索 ─────────────────────────────────────────── */
	.tea-search-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
		height: 1.85rem;
		padding: 0 0.62rem;
		border-radius: 999px;
		border: 1px solid var(--tea-line);
		background: transparent;
		color: var(--tea-muted);
		font: inherit;
		font-size: 0.72rem;
		font-weight: 500;
		white-space: nowrap;
		cursor: pointer;
		transition: background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}
	.tea-search-btn svg { width: 0.9rem; height: 0.9rem; }
	.tea-search-btn:hover {
		color: var(--primary);
		border-color: color-mix(in oklch, var(--primary) 34%, transparent);
		background: color-mix(in oklch, var(--primary) 8%, transparent);
	}

	/* 历史定位提示条 */
	.tea-historybar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0.7rem 0.45rem;
		padding: 0.42rem 0.7rem;
		border-radius: 0.7rem;
		border: 1px solid color-mix(in oklch, var(--primary) 26%, transparent);
		background: color-mix(in oklch, var(--primary) 10%, transparent);
		font-size: 0.7rem;
	}
	.tea-historybar[hidden] { display: none; }
	.tea-historybar__tag {
		display: inline-flex;
		align-items: center;
		gap: 0.24rem;
		font-weight: 600;
		color: color-mix(in oklch, var(--primary) 82%, currentColor);
		white-space: nowrap;
	}
	.tea-historybar__tag svg { width: 0.9rem; height: 0.9rem; }
	.tea-historybar__text {
		flex: 1;
		min-width: 0;
		color: var(--tea-muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.tea-historybar__exit {
		flex: none;
		border: 1px solid var(--tea-line-strong);
		border-radius: 0.45rem;
		background: var(--tea-surface, #fff);
		color: inherit;
		font: inherit;
		font-size: 0.68rem;
		padding: 0.2rem 0.5rem;
		cursor: pointer;
	}
	.tea-historybar__exit:hover { background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08)); }

	/* 搜索结果里点进来的那条，闪一下主色描边 */
	.tea-msg.is-hit .tea-msg__text {
		box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary) 62%, transparent);
	}

	.tea-dialog.tea-search { width: min(40rem, calc(100vw - 2rem)); }
	.tea-search__inner { max-height: calc(100dvh - 3rem); overflow-y: auto; }
	.tea-search__filters {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.55rem 0.7rem;
	}
	.tea-search__filters input[type="search"]::-webkit-search-cancel-button,
	.tea-search__filters input[type="search"]::-webkit-search-decoration {
		-webkit-appearance: none;
		appearance: none;
	}
	.tea-search__kw { position: relative; display: block; }
	.tea-search__kw input { padding-right: 2.1rem; }
	.tea-search__clear {
		position: absolute;
		right: 0.3rem;
		top: 50%;
		transform: translateY(-50%);
		width: 1.5rem;
		height: 1.5rem;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: transparent;
		color: var(--tea-muted);
		cursor: pointer;
	}
	.tea-search__clear:hover { background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.1)); color: inherit; }
	.tea-search__clear[hidden] { display: none; }
	.tea-search__clear svg { width: 0.85rem; height: 0.85rem; }
	.tea-search__go {
		justify-content: center;
		height: 2.4rem;
		border-radius: 0.7rem;
	}
	.tea-search__results {
		display: grid;
		gap: 0.5rem;
		padding-top: 0.7rem;
		border-top: 1px solid var(--tea-line);
	}
	.tea-search__meta { margin: 0; font-size: 0.68rem; color: var(--tea-muted); }
	.tea-search__list {
		display: grid;
		gap: 0.5rem;
		max-height: 22rem;
		min-height: 13rem;
		overflow-y: auto;
		scrollbar-width: thin;
		padding-right: 0.1rem;
	}
	.tea-search__card {
		display: grid;
		gap: 0.32rem;
		padding: 0.6rem 0.7rem;
		border: 1px solid var(--tea-line);
		border-radius: 0.7rem;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.06));
	}
	.tea-search__card header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.tea-search__card b {
		font-size: 0.74rem;
		font-weight: 600;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.tea-search__card time {
		flex: none;
		font-size: 0.64rem;
		color: var(--tea-muted-soft);
		font-variant-numeric: tabular-nums;
	}
	.tea-search__card p {
		margin: 0;
		font-size: 0.74rem;
		line-height: 1.6;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	.tea-search__card mark {
		background: color-mix(in oklch, var(--primary) 36%, transparent);
		color: inherit;
		border-radius: 0.2rem;
		padding: 0 0.1rem;
	}
	.tea-search__jump {
		justify-self: start;
		border: 0;
		padding: 0;
		background: none;
		font: inherit;
		font-size: 0.66rem;
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
		cursor: pointer;
	}
	.tea-search__jump:hover { text-decoration: underline; }
	.tea-search__empty {
		padding: 1.2rem 0.5rem;
		text-align: center;
		font-size: 0.72rem;
		color: var(--tea-muted);
	}
	@media (max-width: 640px) {
		.tea-search__filters { grid-template-columns: 1fr; }
		.tea-search-btn span { display: none; }
		.tea-search-btn { padding: 0 0.45rem; }
	}

	/* 房间列表 */
	.tea-rooms {
		flex: none;
	}
	.tea-rooms__list {
		list-style: none;
		margin: 0;
		padding: 0 0.45rem 0.55rem;
		display: grid;
		gap: 0.15rem;
	}
	.tea-rooms__group {
		font-size: 0.62rem;
		letter-spacing: 0.04em;
		color: var(--tea-muted-soft);
		padding: 0.35rem 0.45rem 0.15rem;
	}
	.tea-room-item {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: 100%;
		padding: 0.38rem 0.45rem;
		border: 1px solid transparent;
		border-radius: 0.6rem;
		background: transparent;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition: background 0.15s ease, border-color 0.15s ease;
	}
	.tea-room-item:hover {
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-room-item.is-active {
		background: color-mix(in oklch, var(--primary) 10%, transparent);
		border-color: color-mix(in oklch, var(--primary) 22%, transparent);
	}
	.tea-room-item__hash {
		width: 1.5rem;
		height: 1.5rem;
		flex: none;
		display: grid;
		place-items: center;
		border-radius: 0.5rem;
		font-size: 0.72rem;
		font-weight: 600;
		color: color-mix(in oklch, var(--primary) 72%, currentColor);
		background: color-mix(in oklch, var(--primary) 12%, transparent);
	}
	.tea-room-item__avatar {
		width: 1.5rem;
		height: 1.5rem;
		flex: none;
		display: grid;
		place-items: center;
		border-radius: 0.5rem;
		overflow: hidden;
		background: color-mix(in oklch, var(--primary) 12%, transparent);
	}
	.tea-room-item__avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.tea-room-item__copy {
		min-width: 0;
		display: grid;
		gap: 0.05rem;
	}
	.tea-room-item__copy b {
		font-size: 0.76rem;
		font-weight: 600;
	}
	.tea-room-item__copy span {
		font-size: 0.64rem;
		color: var(--tea-muted-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* 在线列表 */
	.tea-roster {
		flex: 1 0 auto;
		display: flex;
		flex-direction: column;
		min-height: 9rem;
	}
	/* 宽屏点「在线列表」图标时闪一下，替代移动端抽屉 */
	.tea-roster.is-flash {
		animation: tea-roster-flash 1.2s ease;
	}
	@keyframes tea-roster-flash {
		0% { box-shadow: 0 0 0 0 color-mix(in oklch, var(--primary) 0%, transparent); }
		12% { box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 72%, transparent); }
		68% { box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 72%, transparent); }
		100% { box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 0%, transparent); }
	}
	@media (prefers-reduced-motion: reduce) {
		.tea-roster.is-flash { animation-duration: 0.01s; }
	}
	.tea-roster__count {
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
		font-size: 0.68rem;
		color: var(--tea-muted);
	}
	.tea-roster__count i {
		width: 0.36rem;
		height: 0.36rem;
		border-radius: 50%;
		background: #34c759;
		box-shadow: 0 0 0 3px color-mix(in oklch, #34c759 22%, transparent);
	}
	.tea-roster__count b {
		font-weight: 600;
	}
	.tea-roster__list {
		list-style: none;
		margin: 0;
		padding: 0 0.45rem 0.55rem;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		scrollbar-width: thin;
	}
	.tea-roster__empty {
		padding: 0.6rem 0.5rem 0.9rem;
		font-size: 0.74rem;
		color: var(--tea-muted-soft);
	}
	.tea-member {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.42rem 0.45rem;
		border-radius: 0.55rem;
		font-size: 0.78rem;
		border-bottom: 1px dashed color-mix(in oklch, currentColor 12%, transparent);
	}
	.tea-member:last-child {
		border-bottom: 0;
	}
	.tea-roster__group {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin: 0.15rem 0 0.25rem;
		padding: 0 0.55rem;
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--tea-muted);
	}
	.tea-roster__group:not(:first-child) {
		margin-top: 0.55rem;
		padding-top: 0.5rem;
		border-top: 1px dashed var(--tea-line);
	}
	.tea-roster__group-count {
		font-weight: 500;
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
	}
	.tea-member:hover {
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-member__badge {
		margin-left: auto;
		flex: none;
		font-size: 0.62rem;
		line-height: 1;
		padding: 0.22rem 0.5rem;
		border-radius: 999px;
		border: 1px solid transparent;
		white-space: nowrap;
	}
	.tea-member__badge.is-online {
		color: #2f9e6b;
		background: color-mix(in oklch, #2f9e6b 12%, transparent);
		border-color: color-mix(in oklch, #2f9e6b 28%, transparent);
	}
	.tea-member__badge.is-away {
		color: #b07d12;
		background: color-mix(in oklch, #e0a020 16%, transparent);
		border-color: color-mix(in oklch, #e0a020 32%, transparent);
	}
	.dark .tea-member__badge.is-online {
		color: #5fd39a;
	}
	.dark .tea-member__badge.is-away {
		color: #f0c264;
	}
	.tea-member__avatar {
		width: 1.7rem;
		height: 1.7rem;
		border-radius: 50%;
		flex: none;
		display: grid;
		place-items: center;
		font-size: 0.7rem;
		font-weight: 600;
		color: #fff;
		background-size: cover;
		background-position: center;
	}
	.tea-member--clickable { cursor: pointer; }
	.tea-member--clickable:hover { color: color-mix(in oklch, var(--primary) 70%, currentColor); }
	.tea-member__copy {
		min-width: 0;
		display: grid;
		gap: 0.05rem;
	}
	.tea-member__name {
		display: flex;
		align-items: center;
		gap: 0.28rem;
		min-width: 0;
		font-weight: 500;
	}
	.tea-member__name b {
		font-weight: inherit;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tea-member__tag {
		flex: none;
		font-style: normal;
		font-size: 0.56rem;
		font-weight: 600;
		line-height: 1;
		padding: 0.14rem 0.3rem;
		border-radius: 0.28rem;
		border: 1px solid color-mix(in oklch, var(--primary) 28%, transparent);
		background: color-mix(in oklch, var(--primary) 12%, transparent);
		color: color-mix(in oklch, var(--primary) 74%, currentColor);
	}
	.tea-member__tag.is-host {
		border-color: color-mix(in oklch, var(--primary) 46%, transparent);
		background: color-mix(in oklch, var(--primary) 26%, transparent);
		color: color-mix(in oklch, var(--primary) 90%, currentColor);
	}
	.tea-member__site {
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tea-member--idle {
		opacity: 0.92;
	}
	.tea-roster__all {
		flex: none;
		margin: 0 0.55rem 0.6rem;
		padding: 0.42rem 0.5rem;
		border-radius: 0.6rem;
		border: 1px solid var(--tea-line);
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.72rem;
		cursor: pointer;
		opacity: 0.75;
		transition: opacity 0.15s ease, background 0.15s ease;
	}
	.tea-roster__all:hover {
		opacity: 1;
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}

	/* 公告 */
	.tea-notice {
		flex: none;
	}
	.tea-notice__list {
		margin: 0;
		padding: 0 0.95rem 0.9rem;
		list-style: none;
		display: grid;
		gap: 0.4rem;
		font-size: 0.73rem;
		line-height: 1.65;
		color: var(--tea-muted);
		counter-reset: rule;
	}
	.tea-notice__list li {
		position: relative;
		padding-left: 0.95rem;
	}
	.tea-notice__list li::before {
		counter-increment: rule;
		content: counter(rule);
		position: absolute;
		left: 0;
		top: 0.05rem;
		font-size: 0.6rem;
		font-weight: 700;
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
		opacity: 0.85;
	}

	/* ─── 主区 ─────────────────────────────────────────────── */
	.tea-room {
		position: relative;
		display: grid;
		grid-template-rows: auto auto auto minmax(0, 1fr) auto;
		min-height: 0;
		background: var(--tea-surface);
		border: 1px solid var(--tea-line);
		border-radius: 1.1rem;
		overflow: hidden;
	}
	.tea-bar { grid-row: 1; }
	.tea-pins { grid-row: 2; }
	.tea-historybar { grid-row: 3; }
	.tea-feed-wrap { grid-row: 4; }
	.tea-composer { grid-row: 5; }
	.tea-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 0.95rem;
		border-bottom: 1px solid var(--tea-line);
	}
	.tea-bar__brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
	}
	.tea-bar__mark {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 0.7rem;
		display: grid;
		place-items: center;
		color: color-mix(in oklch, var(--primary) 82%, #3f2d0a);
		background: color-mix(in oklch, var(--primary) 16%, transparent);
		border: 1px solid color-mix(in oklch, var(--primary) 26%, transparent);
		flex: none;
		overflow: hidden;
	}
	.tea-bar__mark svg {
		width: 1.15rem;
		height: 1.15rem;
	}
	.tea-bar__mark img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.tea-bar__title {
		margin: 0;
		font-size: 0.98rem;
		font-weight: 600;
		line-height: 1.25;
	}
	.tea-bar__sub {
		margin: 0;
		font-size: 0.68rem;
		color: var(--tea-muted-soft);
		letter-spacing: 0.02em;
	}
	.tea-bar__tools {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.tea-conn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.7rem;
		color: var(--tea-muted);
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--tea-line);
		margin-right: 0.15rem;
		white-space: nowrap;
	}
	.tea-conn i {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.45;
	}
	.tea-conn.is-live {
		color: #2f9e6b;
		border-color: color-mix(in oklch, #2f9e6b 30%, transparent);
		background: color-mix(in oklch, #2f9e6b 8%, transparent);
	}
	.tea-conn.is-live i {
		opacity: 1;
		box-shadow: 0 0 0 3px color-mix(in oklch, #2f9e6b 20%, transparent);
	}
	.tea-conn.is-down {
		color: #c0563f;
		border-color: color-mix(in oklch, #c0563f 30%, transparent);
	}
	.tea-icon-btn {
		width: 2rem;
		height: 2rem;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 0.6rem;
		background: transparent;
		color: inherit;
		cursor: pointer;
		opacity: 0.72;
		transition: background 0.15s ease, opacity 0.15s ease;
	}
	.tea-icon-btn:hover {
		opacity: 1;
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.1));
	}
	.tea-icon-btn svg {
		width: 1.15rem;
		height: 1.15rem;
	}

	/* 互联提示条 */
	.tea-banner {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		margin: 0.7rem 0.95rem 0;
		padding: 0.5rem 0.7rem;
		border-radius: 0.75rem;
		background: color-mix(in oklch, var(--primary) 8%, transparent);
		border: 1px solid color-mix(in oklch, var(--primary) 16%, transparent);
		font-size: 0.72rem;
		line-height: 1.6;
		color: var(--tea-muted);
	}
	.tea-banner > svg {
		width: 0.95rem;
		height: 0.95rem;
		flex: none;
		margin-top: 0.18rem;
		color: color-mix(in oklch, var(--primary) 72%, currentColor);
	}
	.tea-banner p {
		margin: 0;
	}
	.tea-banner a {
		color: color-mix(in oklch, var(--primary) 62%, #4b3a12);
		text-decoration: none;
		border-bottom: 1px solid color-mix(in oklch, var(--primary) 30%, transparent);
	}
	.tea-banner a:hover {
		border-bottom-color: currentColor;
	}
	.tea-banner__sep {
		opacity: 0.5;
	}

	/* 置顶消息条 */
	.tea-pins {
		display: flex;
		align-items: flex-start;
		min-width: 0;
		gap: 0.5rem;
		margin: 0.5rem 0.95rem 0;
		padding: 0.4rem 0.65rem;
		border-radius: 0.7rem;
		background: color-mix(in oklch, var(--primary) 6%, var(--tea-surface));
		border: 1px solid color-mix(in oklch, var(--primary) 18%, transparent);
		font-size: 0.72rem;
		line-height: 1.55;
	}
	.tea-pins[hidden] { display: none; }
	.tea-pins__icon {
		display: inline-flex;
		flex: none;
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
		margin-top: 0.1rem;
	}
	.tea-pins__icon svg { width: 0.9rem; height: 0.9rem; }
	.tea-pins__body { flex: 1; min-width: 0; color: var(--tea-muted); }
	/* 名称 + 正文同一行；折叠时单行省略，别让多行置顶把整条撑高 */
	.tea-pins__item { display: flex; align-items: baseline; gap: 0.35rem; min-width: 0; }
	.tea-pins__who { flex: none; font-weight: 700; color: var(--primary); }
	.tea-pins__text {
		flex: 1;
		min-width: 0;
		white-space: nowrap;
		word-break: normal;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tea-pins__text pre,
	.tea-pins__text p,
	.tea-pins__text div { display: inline; }
	.tea-pins__text a { color: var(--primary); text-decoration: none; border-bottom: 1px solid color-mix(in oklch, var(--primary) 30%, transparent); }
	/* 点「展开」才恢复原文换行 */
	.tea-pins:not(.tea-pins--collapsed) .tea-pins__text { white-space: pre-wrap; overflow: visible; text-overflow: clip; }
	.tea-pins__toggle {
		flex: none;
		border: 0;
		background: transparent;
		color: var(--primary);
		font: inherit;
		font-size: 0.68rem;
		cursor: pointer;
		padding: 0.05rem 0.2rem;
	}
	.tea-pins__toggle:hover { text-decoration: underline; }

	/* 消息流 */
	.tea-feed-wrap {
		position: relative;
		min-height: 0;
		/* 不锁住的话，置顶栏 nowrap 的最小内容宽度会把整条 grid 列撑出视口 */
		min-width: 0;
	}
	.tea-feed {
		height: 100%;
		/* 悬停操作按钮是 absolute 挂在气泡外侧的，别让它给消息区撑出横向滚动条 */
		overflow-x: hidden;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.9rem 1rem 2.6rem;
		display: flex;
		flex-direction: column;
		gap: 0.95rem;
		scrollbar-width: thin;
		outline: none;
	}
	.tea-feed::-webkit-scrollbar {
		width: 6px;
	}
	.tea-feed__status {
		margin: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.78rem;
		color: var(--tea-muted-soft);
		text-align: center;
	}
	.tea-feed__status--error {
		flex-direction: column;
		gap: 0.45rem;
	}
	.tea-feed__status--error b {
		font-size: 0.88rem;
		font-weight: 600;
		color: inherit;
		opacity: 0.85;
	}
	.tea-feed__status--error span {
		font-size: 0.72rem;
		opacity: 0.7;
		word-break: break-word;
	}
	.tea-spinner {
		width: 0.85rem;
		height: 0.85rem;
		border-radius: 50%;
		border: 2px solid color-mix(in oklch, var(--primary) 30%, transparent);
		border-top-color: var(--primary);
		animation: tea-spin 0.8s linear infinite;
		flex: none;
	}
	@keyframes tea-spin {
		to {
			transform: rotate(360deg);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.tea-spinner {
			animation-duration: 2s;
		}
	}
	.tea-empty {
		margin: auto;
		text-align: center;
		display: grid;
		gap: 0.3rem;
		color: var(--tea-muted-soft);
	}
	.tea-empty b {
		font-size: 0.9rem;
		font-weight: 600;
		color: inherit;
		opacity: 0.8;
	}
	.tea-empty span {
		font-size: 0.74rem;
	}

	.tea-day {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.68rem;
		color: var(--tea-muted-soft);
		margin: 0.2rem 0 -0.25rem;
	}
	.tea-day::before,
	.tea-day::after {
		content: "";
		height: 1px;
		flex: 1;
		background: var(--tea-line);
	}

	/* 撤回提示 */
	.tea-recall {
		align-self: center;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		max-width: 90%;
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
		background: color-mix(in oklch, var(--primary) 6%, transparent);
		border: 1px dashed color-mix(in oklch, var(--primary) 22%, transparent);
		font-size: 0.68rem;
		line-height: 1.4;
		color: var(--tea-muted);
	}
	.tea-recall b { color: color-mix(in oklch, var(--primary) 70%, currentColor); font-weight: 600; }

	/* 上次阅读位置 */
	.tea-readmark {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0.2rem 0;
	}
	.tea-readmark::before,
	.tea-readmark::after {
		content: "";
		height: 1px;
		flex: 1;
		background: color-mix(in oklch, var(--primary) 42%, transparent);
	}
	.tea-readmark span {
		flex: none;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		background: color-mix(in oklch, var(--primary) 13%, transparent);
		border: 1px solid color-mix(in oklch, var(--primary) 28%, transparent);
		color: color-mix(in oklch, var(--primary) 72%, currentColor);
		font-size: 0.66rem;
		white-space: nowrap;
	}
	.tea-readjump {
		position: absolute;
		right: 1rem;
		bottom: 0.6rem;
		z-index: 12;
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		border: 1px solid color-mix(in oklch, var(--primary) 35%, transparent);
		background: var(--tea-surface, #fff);
		color: var(--primary);
		font: inherit;
		font-size: 0.7rem;
		cursor: pointer;
		box-shadow: 0 4px 14px rgba(0,0,0,.1);
	}
	.tea-readjump[hidden] { display: none; }

	.tea-msg {
		display: grid;
		grid-template-columns: 2.1rem minmax(0, 1fr);
		gap: 0.6rem;
		align-items: start;
	}
	.tea-msg__avatar {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: 0.78rem;
		font-weight: 600;
		color: #fff;
		background-size: cover;
		background-position: center;
		flex: none;
	}
	/* 头像就是名片入口：按钮化后清掉浏览器默认样式，再补 hover / 键盘焦点 */
	button.tea-msg__avatar {
		appearance: none;
		border: 0;
		padding: 0;
		background-color: transparent;
		font-family: inherit;
		cursor: pointer;
		transition: box-shadow 0.15s ease, transform 0.15s ease;
	}
	button.tea-msg__avatar:hover {
		box-shadow: 0 0 0 2px color-mix(in oklch, var(--primary) 40%, transparent);
		transform: translateY(-1px);
	}
	button.tea-msg__avatar:focus-visible {
		outline: 2px solid color-mix(in oklch, var(--primary) 55%, transparent);
		outline-offset: 2px;
	}
	.tea-msg__body {
		min-width: 0;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}
	.tea-msg__head {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 0.16rem;
	}
	.tea-msg__nick {
		font-size: 0.8rem;
		font-weight: 600;
	}
	.tea-msg__site {
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
		border-radius: 999px;
		padding: 0.05rem 0.42rem;
		white-space: nowrap;
	}
	.tea-msg__time {
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		font-variant-numeric: tabular-nums;
	}
	.tea-msg__text {
		position: relative;
		display: inline-block;
		max-width: 100%;
		padding: 0.42rem 0.62rem;
		border: 1px solid var(--tea-line);
		border-radius: 0.75rem;
		background: var(--card-bg, #fff);
		box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
		font-size: 0.86rem;
		line-height: 1.7;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.tea-msg__text a {
		color: color-mix(in oklch, var(--primary) 60%, #4b3a12);
		text-decoration: underline;
		text-decoration-color: color-mix(in oklch, var(--primary) 35%, transparent);
		text-underline-offset: 2px;
	}
	/* 纯媒体消息：去掉气泡外框，媒体直接贴在消息流里。
	   自己发的消息还有一份同权重的 .tea-msg--mine 样式（它带底色），
	   这里补一个组合选择器把它压住，否则自己的图/视频背后会多出一块色块。 */
	.tea-msg--media .tea-msg__text,
	.tea-msg--media.tea-msg--mine .tea-msg__text {
		padding: 0;
		border: 0;
		border-radius: 0;
		background: transparent;
		box-shadow: none;
	}
	.tea-msg--media .tea-msg__text img {
		margin-top: 0;
	}
	/* 视频：跟图片一样直接贴在消息流里。给了 info.w/h 就按真实比例，
	   没给（外站客户端没填）退回 16:9，别在 metadata 回来前塌成一条窄黑边。 */
	.tea-msg__text video.tea-video,
	.tea-thread__msg video.tea-video {
		display: block;
		width: 20rem;
		max-width: 100%;
		aspect-ratio: 16 / 9;
		margin-top: 0.3rem;
		border: 1px solid var(--tea-line);
		border-radius: 0.7rem;
		background: #000;
	}
	.tea-msg--media .tea-msg__text video.tea-video {
		margin-top: 0;
	}
	.tea-video__cap {
		max-width: 20rem;
		margin-top: 0.35rem;
		font-size: 0.86rem;
		line-height: 1.7;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.tea-msg__text img {
		display: block;
		max-width: min(100%, 17rem);
		max-height: 14rem;
		border-radius: 0.7rem;
		margin-top: 0.3rem;
		border: 1px solid var(--tea-line);
		cursor: zoom-in;
		transition: filter 0.15s ease;
	}
	.tea-msg__text img:hover {
		filter: brightness(1.04);
	}
	.tea-msg__text img.tea-emoticon {
		display: inline-block;
		width: 2.4rem;
		height: 2.4rem;
		max-width: none;
		max-height: none;
		vertical-align: middle;
		margin: 0;
		border: 0;
		cursor: default;
	}
	.tea-msg__text img.tea-inline-emoji {
		display: inline-block;
		width: 1.35rem;
		height: 1.35rem;
		max-width: none;
		max-height: none;
		vertical-align: -0.22rem;
		margin: 0 0.08rem;
		border: 0;
		cursor: default;
	}
	.tea-msg__text pre {
		margin: 0.35rem 0 0;
		padding: 0.5rem 0.65rem;
		border-radius: 0.6rem;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
		overflow-x: auto;
		font-size: 0.74rem;
		line-height: 1.65;
		white-space: pre;
	}
	.tea-msg__text code {
		font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
		font-size: 0.94em;
	}
	.tea-msg__text strong {
		font-weight: 600;
	}
	.tea-msg__reply {
		display: block;
		width: 100%;
		margin: 0 0 0.3rem;
		padding: 0.3rem 0.55rem;
		text-align: left;
		font: inherit;
		font-size: 0.76rem;
		line-height: 1.5;
		color: inherit;
		appearance: none;
		border: 0;
		border-left: 2px solid color-mix(in oklch, var(--primary) 55%, transparent);
		border-radius: 0 0.45rem 0.45rem 0;
		background: color-mix(in oklch, var(--primary) 8%, var(--btn-regular-bg, rgba(128, 128, 128, 0.08)));
	}
	button.tea-msg__reply {
		cursor: pointer;
		transition: background 0.15s ease;
	}
	button.tea-msg__reply:hover {
		background: color-mix(in oklch, var(--primary) 16%, var(--btn-regular-bg, rgba(128, 128, 128, 0.08)));
	}
	button.tea-msg__reply:active { transform: translateY(1px); }
	.tea-msg__reply b {
		display: block;
		font-size: 0.7rem;
		font-weight: 600;
		color: color-mix(in oklch, var(--primary) 62%, currentColor);
	}
	.tea-msg__reply span {
		display: block;
		opacity: 0.78;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	/* 投票卡片 */
	.tea-poll-card {
		margin: 0.2rem 0;
		min-width: 13rem;
		max-width: 20rem;
		display: grid;
		gap: 0.35rem;
	}
	.tea-poll-card__q {
		font-weight: 600;
		font-size: 0.84rem;
	}
	.tea-poll-card__opt {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		width: 100%;
		padding: 0.35rem 0.6rem;
		border: 1px solid var(--tea-line-strong);
		border-radius: 0.5rem;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.78rem;
		text-align: left;
		cursor: pointer;
		overflow: hidden;
	}
	.tea-poll-card__opt:hover:not(:disabled) {
		border-color: color-mix(in oklch, var(--primary) 55%, transparent);
	}
	.tea-poll-card__opt:disabled { cursor: default; }
	.tea-poll-card__bar {
		position: absolute;
		inset: 0 auto 0 0;
		background: color-mix(in oklch, var(--primary) 18%, transparent);
		transition: width 0.3s ease;
	}
	.tea-poll-card__opt.is-mine {
		border-color: color-mix(in oklch, var(--primary) 70%, transparent);
	}
	.tea-poll-card__opt.is-mine .tea-poll-card__bar {
		background: color-mix(in oklch, var(--primary) 32%, transparent);
	}
	.tea-poll-card__label,
	.tea-poll-card__pct { position: relative; z-index: 1; }
	.tea-poll-card__pct { font-variant-numeric: tabular-nums; opacity: 0.8; }
	.tea-poll-card__foot {
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
	}
	.tea-poll-options { display: grid; gap: 0.45rem; margin-bottom: 0.4rem; }
	.tea-poll-add {
		width: 100%;
		margin-bottom: 0.5rem;
		font-size: 0.76rem;
	}

	/* 成员名片 */
	.tea-membercard {
		border: 0;
		padding: 0;
		margin: auto;
		width: min(58rem, calc(100vw - 2rem));
		max-height: calc(100dvh - 2rem);
		border-radius: 1rem;
		background: var(--card-bg, #fff);
		color: inherit;
		box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.5);
		overflow: hidden;
	}
	.tea-membercard::backdrop { background: rgba(0, 0, 0, 0.45); backdrop-filter: blur(6px); }
	.tea-membercard__inner { display: grid; grid-template-rows: auto minmax(0, 1fr); height: 100%; max-height: calc(100dvh - 2rem); }
	.tea-membercard__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.7rem 1rem;
		border-bottom: 1px solid var(--tea-line);
	}
	.tea-membercard__head h3 { margin: 0; font-size: 0.95rem; font-weight: 600; }
	.tea-membercard__head .tea-icon-btn { width: 1.8rem; height: 1.8rem; }
	.tea-membercard__head .tea-icon-btn svg { width: 1.1rem; height: 1.1rem; }
	.tea-membercard__cols { display: grid; grid-template-columns: minmax(17rem, 40%) minmax(0, 1fr); min-height: 0; }
	.tea-membercard__left,
	.tea-membercard__right { overflow-y: auto; overflow-x: hidden; overscroll-behavior: contain; min-height: 0; }
	/* 隐式列必须收成 minmax(0, 1fr)：否则一条 nowrap 的长消息会按 min-content 把整列撑宽，
	   卡片、统计、按钮全被右边缘裁掉，还会多出一条横向滚动条。 */
	.tea-membercard__left { padding: 0.9rem; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.6rem; align-content: start; border-right: 1px solid var(--tea-line); }
	.tea-membercard__left > * { min-width: 0; }
	.tea-membercard__right { padding: 0.9rem 1rem; display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.6rem; align-content: start; }
	@media (max-width: 720px) {
		.tea-membercard__cols { grid-template-columns: minmax(0, 1fr); }
		.tea-membercard__left { border-right: 0; border-bottom: 1px solid var(--tea-line); }
	}
	.mc-card {
		min-width: 0;
		border-radius: 0.85rem;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.08));
		padding: 0.75rem;
		display: grid;
		gap: 0.55rem;
	}
	.mc-top { display: flex; align-items: center; gap: 0.6rem; min-width: 0; }
	.mc-avatar {
		position: relative;
		width: 3.2rem;
		height: 3.2rem;
		border-radius: 0.75rem;
		flex: none;
		background-size: cover;
		background-position: center;
		display: grid;
		place-items: center;
		font-weight: 600;
	}
	.mc-dot { position: absolute; right: -2px; bottom: -2px; width: 0.7rem; height: 0.7rem; border-radius: 50%; border: 2px solid var(--card-bg, #fff); background: #9ca3af; }
	.mc-dot.is-on { background: #22c55e; }
	.mc-ident { min-width: 0; display: grid; gap: 0.2rem; }
	.mc-name { font-size: 0.92rem; font-weight: 600; display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; min-width: 0; overflow-wrap: anywhere; }
	.mc-badge { font-size: 0.6rem; padding: 0.05rem 0.35rem; border-radius: 0.35rem; background: color-mix(in oklch, #eab308 25%, transparent); color: #a16207; font-weight: 600; }
	.mc-meta { font-size: 0.7rem; color: var(--tea-muted); display: flex; gap: 0.3rem; flex-wrap: wrap; min-width: 0; }
	.mc-meta i { opacity: 0.5; font-style: normal; }
	.mc-signature, .mc-site {
		border: 1px solid var(--tea-line-strong);
		border-radius: 0.55rem;
		padding: 0.4rem 0.6rem;
		font-size: 0.74rem;
		min-width: 0;
	}
	.mc-signature { color: var(--tea-muted); overflow-wrap: anywhere; }
	.mc-site { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; color: color-mix(in oklch, var(--primary) 70%, currentColor); text-decoration: none; }
	.mc-site span:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.mc-site span:last-child { flex: none; font-size: 0.66rem; }
	.mc-mx { font-size: 0.66rem; color: var(--tea-muted); display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.25rem; border-top: 1px solid var(--tea-line); padding-top: 0.5rem; min-width: 0; }
	/* 账号太长时整段换到下一行，别截断成半截 ID */
	.mc-mx > div { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.1rem 0.5rem; min-width: 0; }
	.mc-mx > div span:first-child { flex: none; white-space: nowrap; }
	.mc-mx > div span:last-child { flex: 1 0 auto; max-width: 100%; min-width: 0; text-align: right; font-family: monospace; color: color-mix(in oklch, var(--primary) 68%, currentColor); overflow-wrap: anywhere; }
	/* 归属互联茶室：站点名片 + 访问主页 / 前往茶室 */
	.mc-home {
		display: grid;
		gap: 0.35rem;
		padding: 0.55rem 0.65rem;
		border-radius: 0.75rem;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.06));
	}
	.mc-home__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 0.5rem;
	}
	.mc-home__head .mc-block-title { margin: 0; }
	.mc-home__owner { font-size: 0.62rem; color: var(--tea-muted-soft); }

	/* 自己的消息：头像移到右侧，正文整体靠右对齐 */
	.tea-msg--mine {
		grid-template-columns: minmax(0, 1fr) 2.1rem;
	}
	.tea-msg--mine .tea-msg__avatar {
		grid-column: 2;
		grid-row: 1;
	}
	.tea-msg--mine .tea-msg__body {
		grid-column: 1;
		grid-row: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}
	.tea-msg--mine .tea-msg__head {
		justify-content: flex-end;
	}
	.tea-msg--mine .tea-msg__nick {
		color: color-mix(in oklch, var(--primary) 66%, currentColor);
	}
	.tea-msg--mine .tea-msg__text {
		background: color-mix(in oklch, var(--primary) 16%, var(--card-bg, #fff));
		border-color: color-mix(in oklch, var(--primary) 28%, transparent);
		text-align: left;

	.tea-react-picker[hidden] { display: none; }
	.tea-react-picker__quick {
		display: flex;
		gap: 0.1rem;
		padding-bottom: 0.3rem;
		border-bottom: 1px solid var(--tea-line);
	}
	.tea-react-picker__quick button,
	.tea-react-picker__grid button {
		border: 0;
		background: transparent;

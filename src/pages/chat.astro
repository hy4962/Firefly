</style>

<script is:inline define:vars={{ API_BASE: CHAT_API, SITE_NAME }}>
	(() => {
		const KEY = "__teaRoomRuntime";
		const api0 = new URLSearchParams(location.search).get("api") || API_BASE;

		const esc = (s) =>
			String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

		const hash = (str) => {
			let h = 2166136261;
			for (let i = 0; i < str.length; i++) {
				h ^= str.charCodeAt(i);
				h = Math.imul(h, 16777619);
			}
			return Math.abs(h);
		};

		const avatarStyle = (nick, site) => {
			const h = hash(nick + "|" + (site || ""));
			const a = h % 360;
			const b = (a + 38) % 360;
			return `background-image:linear-gradient(145deg,oklch(0.74 0.13 ${a}),oklch(0.62 0.14 ${b}))`;
		};

		const initials = (nick) => {
			const n = String(nick || "?").trim();
			if (!n) return "?";
			return /[\u4e00-\u9fa5]/.test(n[0]) ? n[0] : n.slice(0, 1).toUpperCase();
		};

		// 极简 markdown：只认图片、链接、粗体、代码块，够大厅里的分享消息用
		const inlineFmt = (raw) => {
			const re = /(!?)\[([^\]]*)\]\((https?:\/\/[^)\s]+)\)|(https?:\/\/[^\s<>"'）)，。]+)/g;
			let out = "";
			let last = 0;
			let m;
			while ((m = re.exec(raw))) {
				out += esc(raw.slice(last, m.index));
				if (m[3]) {
					const url = m[3];
					const label = m[2] || "";
					out +=
						m[1] === "!"
							? `<img src="${esc(url)}" alt="${esc(label)}" loading="lazy" />`
							: `<a href="${esc(url)}" target="_blank" rel="noopener noreferrer nofollow">${esc(label || url)}</a>`;
				} else if (m[4]) {
					const url = m[4];
					out += `<a href="${esc(url)}" target="_blank" rel="noopener noreferrer nofollow">${esc(url.replace(/^https?:\/\//, ""))}</a>`;
				}
				last = m.index + m[0].length;
			}
			out += esc(raw.slice(last));
			return out.replace(/\*\*([^*<]{1,80})\*\*/g, "<strong>$1</strong>");
		};

		const fmtText = (text) => {
			const parts = String(text ?? "").split(/```[a-zA-Z0-9+#-]*\n?/);
			return parts
				.map((chunk, i) => (i % 2 === 1 ? `<pre><code>${esc(chunk.replace(/\n$/, ""))}</code></pre>` : inlineFmt(chunk)))
				.join("");
		};

		const fmtTime = (ts) =>
			new Date(ts).toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit", hour12: false });

		const dayKey = (ts) => {
			const d = new Date(ts);
			return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
		};

		const dayLabel = (ts) => {
			const d = new Date(ts);
			const today = new Date();
			const diff = (today.setHours(0, 0, 0, 0) - new Date(ts).setHours(0, 0, 0, 0)) / 86400000;
			if (diff === 0) return "今天";
			if (diff === 1) return "昨天";
			return `${d.getMonth() + 1} 月 ${d.getDate()} 日`;
		};

		const store = {
			get identity() {
				try {
					return JSON.parse(localStorage.getItem("tea.identity") || "null");
				} catch {
					return null;
				}
			},
			set identity(v) {
				if (v) localStorage.setItem("tea.identity", JSON.stringify(v));
				else localStorage.removeItem("tea.identity");
			},
			get count() {
				return Number(localStorage.getItem("tea.count") || 0);
			},
			bump() {
				localStorage.setItem("tea.count", String(this.count + 1));
			},
		};

		// ── 实例状态 ──────────────────────────────────────────────
		const rt =
			window[KEY] ||
			(window[KEY] = {
				bound: false,
				timer: null,
				since: null,
				lastId: null,
				seen: new Set(),
				sending: false,
				jukeTimer: null,
				visitor: store.identity,
			});

		const root = () => document.getElementById("tea-app");
		const q = (sel) => (root() ? root().querySelector(sel) : null);

		const setConn = (state, text) => {
			const el = q("[data-tea-conn]");
			const label = q("[data-tea-conn-text]");
			if (!el) return;
			el.classList.toggle("is-live", state === "live");
			el.classList.toggle("is-down", state === "down");
			if (label) label.textContent = text || (state === "live" ? "已连接" : state === "down" ? "连接中断" : "连接中");
		};

		const showError = (msg) => {
			const box = q("[data-tea-error]");
			if (!box) return;
			box.textContent = msg || "";
			box.hidden = !msg;
		};

		// ── 渲染 ─────────────────────────────────────────────────
		const feedEl = () => q("[data-tea-feed]");

		const atBottom = () => {
			const f = feedEl();
			if (!f) return true;
			return f.scrollHeight - f.scrollTop - f.clientHeight < 90;
		};

		const scrollBottom = (smooth) => {
			const f = feedEl();
			if (!f) return;
			f.scrollTo({ top: f.scrollHeight, behavior: smooth ? "smooth" : "auto" });
		};

		const renderMessage = (m) => {
			const f = feedEl();
			if (!f) return;
			if (m.id && rt.seen.has(m.id)) return;
			if (m.id) rt.seen.add(m.id);

			const prev = f.querySelector(".tea-msg:last-of-type");
			const grouped =
				prev &&
				prev.dataset.nick === m.nick &&
				prev.dataset.site === (m.site || "") &&
				Number(m.ts) - Number(prev.dataset.ts || 0) < 4 * 60 * 1000;

			const lastDay = f.dataset.day;
			if (lastDay !== dayKey(m.ts)) {
				const sep = document.createElement("div");
				sep.className = "tea-day";
				sep.textContent = dayLabel(m.ts);
				f.appendChild(sep);
				f.dataset.day = dayKey(m.ts);
			}

			const mine = !!(rt.visitor && m.nick === rt.visitor.nick && (m.site || "") === SITE_NAME);
			const el = document.createElement("article");
			el.className = "tea-msg" + (grouped ? " tea-msg--grouped" : "") + (mine ? " tea-msg--mine" : "");
			el.dataset.nick = m.nick || "";
			el.dataset.site = m.site || "";
			el.dataset.ts = String(m.ts || Date.now());
			if (m.id) el.dataset.id = m.id;
			if (m.pending) el.classList.add("tea-msg--pending");
			if (m.failed) el.classList.add("tea-msg--failed");

			const av = m.avatar
				? `style="background-image:url('${esc(m.avatar)}')"`
				: `style="${avatarStyle(m.nick, m.site)}"`;
			const siteTag = m.site ? `<span class="tea-msg__site">来自 ${esc(m.site)}</span>` : "";
			const body = m.image
				? `<img src="${esc(m.image)}" alt="图片" loading="lazy" />`
				: fmtText(m.text || "");

			el.innerHTML = `
				<div class="tea-msg__avatar" ${av} aria-hidden="true">${m.avatar ? "" : esc(initials(m.nick))}</div>
				<div class="tea-msg__body">
					<div class="tea-msg__head">
						<span class="tea-msg__nick">${esc(m.nick || "茶友")}</span>
						${siteTag}
						<time class="tea-msg__time">${esc(fmtTime(m.ts))}</time>
					</div>
					<div class="tea-msg__text">${body}</div>
				</div>`;

			f.appendChild(el);
			if (m.scroll !== false) scrollBottom(!m.pending);
		};

		const renderMembers = (members) => {
			const list = q("[data-tea-members]");
			if (!list) return;
			const online = members.filter((m) => m.online !== false);
			const countEl = q("[data-tea-online]");
			if (countEl) countEl.textContent = String(online.length);
			if (!members.length) {
				list.innerHTML = `<li class="tea-roster__empty">暂时没人，等你来坐第一桌。</li>`;
				return;
			}
			const shown = members.slice(0, 20);
			list.innerHTML =
				shown
					.map((m) => {
						const av = m.avatar
							? `style="background-image:url('${esc(m.avatar)}')"`
							: `style="${avatarStyle(m.nick, m.site)}"`;
						return `<li class="tea-member${m.online === false ? " tea-member--idle" : ""}" title="${esc(m.nick)}${m.site ? " · " + esc(m.site) : ""}">
						<span class="tea-member__avatar" ${av}>${m.avatar ? "" : esc(initials(m.nick))}</span>
						<span class="tea-member__copy">
							<span class="tea-member__name">${esc(m.nick)}</span>
							<span class="tea-member__site">${esc(m.site || "Matrix")}</span>
						</span>
					</li>`;
					})
					.join("") +
				(members.length > shown.length
					? `<li class="tea-roster__empty">还有 ${members.length - shown.length} 位茶友没显示</li>`
					: "");
		};

		const renderSelf = () => {
			const v = rt.visitor;
			const av = q("[data-tea-me-avatar]");
			const name = q("[data-tea-me-name]");
			const meta = q("[data-tea-me-meta]");
			const count = q("[data-tea-me-count]");
			const act = q("[data-tea-enter]");
			if (!av || !name) return;
			if (v) {
				av.textContent = initials(v.nick);
				av.setAttribute("style", avatarStyle(v.nick, SITE_NAME));
				name.textContent = v.nick;
				if (meta) meta.textContent = `来自 ${SITE_NAME}`;
				if (count) count.textContent = String(store.count);
				if (act) act.textContent = "换个身份";
			} else {
				av.textContent = "?";
				av.removeAttribute("style");
				name.textContent = "还没入座";
				if (meta) meta.textContent = "填个昵称，就能在这儿坐下。";
				if (count) count.textContent = "0";
				if (act) act.textContent = "入座";
			}
			const since = q("[data-tea-me-since]");
			if (since) since.textContent = v ? "已入座" : "今天刚到";
		};

		const setGate = (entered) => {
			const gate = q("[data-tea-gate]");
			const input = q("[data-tea-input]");
			if (gate) gate.hidden = !!entered;
			if (input) input.hidden = !entered;
		};

		// ── 数据 ─────────────────────────────────────────────────
		const api = async (path, opts = {}) => {
			const res = await fetch(api0.replace(/\/$/, "") + path, {
				...opts,
				headers: { "Content-Type": "application/json", ...(opts.headers || {}) },
			});
			let data = {};
			try {
				data = await res.json();
			} catch (_) {}
			if (!res.ok || data.ok === false) throw new Error(data.error || `HTTP ${res.status}`);
			return data;
		};

		const feedStatus = (html, isError) => {
			const f = feedEl();
			if (!f) return;
			f.innerHTML = `<div class="tea-feed__status${isError ? " tea-feed__status--error" : ""}">${html}</div>`;
			f.dataset.day = "";
			rt.seen.clear();
		};

		const loadHistory = async () => {
			feedStatus(`<span class="tea-spinner"></span> 正在看看大家聊到哪儿了…`);
			try {
				const [hist, sync] = await Promise.all([api("/api/history?limit=60"), api("/api/sync")]);
				feedStatus("");
				const f = feedEl();
				if (f) f.innerHTML = "";
				const msgs = [...(hist.messages || []), ...(sync.messages || [])];
				msgs.sort((a, b) => a.ts - b.ts);
				if (!msgs.length) {
					feedStatus(`<div class="tea-empty"><b>茶室里还没人说话</b><span>要不你先开个话头？</span></div>`);
				} else {
					for (const m of msgs) renderMessage({ ...m, scroll: false });
					scrollBottom(false);
				}
				rt.since = sync.next || null;
				setConn("live");
				loadRoom();
			} catch (e) {
				feedStatus(
					`<b>茶室暂时打不开</b><span>${esc(e.message || "网络异常")}</span><button type="button" class="tea-btn tea-btn--ghost" data-tea-retry>重试</button>`,
					true,
				);
				setConn("down", "连接失败");
				const btn = q("[data-tea-retry]");
				if (btn) btn.addEventListener("click", () => {
					showError("");
					loadHistory();
				});
			}
		};

		const loadRoom = async () => {
			try {
				const data = await api("/api/room");
				renderMembers(data.members || []);
			} catch (_) {}
		};

		const poll = async () => {
			if (!root()) return;
			try {
				const data = await api("/api/sync" + (rt.since ? `?since=${encodeURIComponent(rt.since)}` : ""));
				if (data.next) rt.since = data.next;
				const list = data.messages || [];
				if (list.length) {
					const stick = atBottom();
					for (const m of list) renderMessage({ ...m, scroll: false });
					if (stick) scrollBottom(true);
					else {
						const jump = q("[data-tea-jump]");
						if (jump) jump.hidden = false;
					}
				}
				setConn("live");
			} catch (_) {
				setConn("down", "连接中断");
			}
			rt.timer = setTimeout(poll, 3000);
		};

		const startLoop = () => {
			clearTimeout(rt.timer);
			poll();
		};

		// ── 发送 ─────────────────────────────────────────────────
		const sendText = async (text, node) => {
			const v = rt.visitor;
			if (!v) return;
			let target = node;
			if (!target) {
				const ts = Date.now();
				renderMessage({ id: "tmp-" + ts, ts, nick: v.nick, site: SITE_NAME, text, self: true, pending: true });
				target = feedEl().querySelector(`.tea-msg[data-id="tmp-${ts}"]`);
			}
			try {
				const res = await api("/api/send", {
					method: "POST",
					body: JSON.stringify({ nick: v.nick, email: v.email, website: v.website, text }),
				});
				if (target) {
					target.classList.remove("tea-msg--pending", "tea-msg--failed");
					if (res.id) {
						target.dataset.id = res.id;
						rt.seen.add(res.id);
					}
					const old = target.querySelector(".tea-msg__retry");
					if (old) old.remove();
				}
				store.bump();
				const c = q("[data-tea-me-count]");
				if (c) c.textContent = String(store.count);
			} catch (e) {
				if (target) {
					target.classList.remove("tea-msg--pending");
					target.classList.add("tea-msg--failed");
					const old = target.querySelector(".tea-msg__retry");
					if (old) old.remove();
					const retry = document.createElement("button");
					retry.type = "button";
					retry.className = "tea-msg__retry";
					retry.textContent = "发送失败：" + (e.message || "网络异常") + "，点此重试";
					retry.addEventListener("click", () => {
						target.remove();
						sendText(text);
					});
					target.querySelector(".tea-msg__body").appendChild(retry);
				}
			}
		};

		// ── 交互 ─────────────────────────────────────────────────
		const openDialog = () => {
			const dlg = document.querySelector("[data-tea-dialog]");
			const form = document.querySelector("[data-tea-identity]");
			if (!dlg || !form) return;
			const v = rt.visitor;
			if (v) {
				form.elements.nick.value = v.nick || "";
				form.elements.email.value = v.email || "";
				form.elements.website.value = v.website || "";
				updatePreview();
			}
			if (typeof dlg.showModal === "function") dlg.showModal();
		};

		const updatePreview = () => {
			const form = document.querySelector("[data-tea-identity]");
			if (!form) return;
			const nick = (form.elements.nick.value || "").trim();
			const av = document.querySelector("[data-tea-preview-avatar]");
			const name = document.querySelector("[data-tea-preview-name]");
			if (av) {
				av.textContent = nick ? initials(nick) : "?";
				av.setAttribute("style", nick ? avatarStyle(nick, SITE_NAME) : "");
			}
			if (name) name.textContent = nick ? `${nick} · ${SITE_NAME}` : "还没填昵称";
		};

		const submitIdentity = async (e) => {
			e.preventDefault();
			const form = document.querySelector("[data-tea-identity]");
			if (!form) return;
			const nick = (form.elements.nick.value || "").trim();
			const email = (form.elements.email.value || "").trim();
			const website = (form.elements.website.value || "").trim();
			const err = document.querySelector("[data-tea-dialog-error]");
			const btn = document.querySelector("[data-tea-submit]");
			if (!nick) {
				if (err) {
					err.textContent = "昵称不能为空";
					err.hidden = false;
				}
				return;
			}
			if (err) err.hidden = true;
			if (btn) btn.disabled = true;
			try {
				rt.visitor = { nick, email, website };
				store.identity = rt.visitor;
				renderSelf();
				setGate(true);
				const dlg = document.querySelector("[data-tea-dialog]");
				if (dlg) dlg.close();
				const ta = q("[data-tea-text]");
				if (ta) ta.focus();
			} finally {
				if (btn) btn.disabled = false;
			}
		};

		// ── 点歌台：复用站点全局播放器 window.__fireflyMusic ─────
		const jukeSig = { list: "", lrc: -1, tab: "list" };

		const musicApi = () => (window.__fireflyMusic ? window.__fireflyMusic : null);
		const jukeNode = (sel) => (root() ? root().querySelector("[data-tea-juke] " + sel) : null);

		const renderPlaylist = (st) => {
			const box = jukeNode("[data-juke-list]");
			if (!box) return;
			const sig = st.playlist.length + "|" + st.currentIndex;
			if (jukeSig.list === sig) return;
			jukeSig.list = sig;
			if (!st.playlist.length) {
				box.innerHTML = `<p class="tea-juke__empty">歌单还没加载出来，点一下播放试试。</p>`;
				return;
			}
			box.innerHTML = st.playlist
				.map((t, i) => {
					const cur = i === st.currentIndex;
					return `<button type="button" class="tea-song${cur ? " is-current" : ""}" data-juke-index="${i}">
						<span class="tea-song__idx">${cur ? "♪" : i + 1}</span>
						<span class="tea-song__copy">
							<span class="tea-song__name">${esc(t.name || "未知曲目")}</span>
							<span class="tea-song__artist">${esc(t.artist || "")}</span>
						</span>
					</button>`;
				})
				.join("");
		};

		const renderLyrics = (st, force) => {
			const box = jukeNode("[data-juke-lyrics]");
			if (!box) return;
			if (!st.lyrics || !st.lyrics.length) {
				if (box.dataset.empty !== "1") {
					box.innerHTML = `<p class="tea-juke__empty">这首歌暂时没有歌词。</p>`;
					box.dataset.empty = "1";
					jukeSig.lrc = -1;
				}
				return;
			}
			if (box.dataset.empty === "1" || force) {
				box.innerHTML = st.lyrics.map((l) => `<p>${esc(l.text)}</p>`).join("");
				box.dataset.empty = "0";
				jukeSig.lrc = -1;
			}
			if (jukeSig.lrc !== st.currentLrcIndex) {
				jukeSig.lrc = st.currentLrcIndex;
				const lines = box.querySelectorAll("p");
				lines.forEach((p, i) => p.classList.toggle("is-current", i === st.currentLrcIndex));
				const active = lines[st.currentLrcIndex];
				if (active) active.scrollIntoView({ block: "center", behavior: "smooth" });
			}
		};

		const renderJuke = () => {
			const juke = root() ? root().querySelector("[data-tea-juke]") : null;
			if (!juke) return;
			const m = musicApi();
			if (!m) {
				const t = jukeNode("[data-juke-title]");
				if (t) t.textContent = "播放器还没就绪";
				return;
			}
			const st = m.getState();
			if (!st.initialized && !st.error) {
				try {
					m.init();
				} catch (_) {}
			}
			juke.classList.toggle("is-playing", !!st.isPlaying);
			const live = jukeNode("[data-juke-live]");
			if (live) {
				live.classList.toggle("is-playing", !!st.isPlaying);
				const label = live.querySelector("b");
				if (label) label.textContent = st.isPlaying ? "播放中" : st.initialized ? "已暂停" : "加载中";
			}
			const cover = jukeNode("[data-juke-cover]");
			if (cover) cover.style.backgroundImage = st.track && st.track.pic ? `url("${st.track.pic}")` : "";
			const title = jukeNode("[data-juke-title]");
			if (title) title.textContent = (st.track && st.track.name) || "还没开始听";
			const artist = jukeNode("[data-juke-artist]");
			if (artist) artist.textContent = (st.track && st.track.artist) || "从下面挑一首，或者让茶室随便放";
			const seek = jukeNode("[data-juke-seek]");
			if (seek) {
				seek.value = String(Math.round((st.progress || 0) * 10));
				seek.style.setProperty("--p", (st.progress || 0) + "%");
			}
			const cur = jukeNode("[data-juke-cur]");
			if (cur) cur.textContent = st.currentTimeStr || "0:00";
			const dur = jukeNode("[data-juke-dur]");
			if (dur) dur.textContent = st.durationStr || "0:00";
			const vol = jukeNode("[data-juke-vol]");
			if (vol) vol.value = String(Math.round((st.isMuted ? 0 : st.volume || 0) * 100));
			const playBtn = jukeNode("[data-juke-play]");
			if (playBtn) {
				const iPlay = playBtn.querySelector("[data-juke-icon-play]");
				const iPause = playBtn.querySelector("[data-juke-icon-pause]");
				if (iPlay) iPlay.hidden = !!st.isPlaying;
				if (iPause) iPause.hidden = !st.isPlaying;
				playBtn.setAttribute("aria-label", st.isPlaying ? "暂停" : "播放");
			}
			renderPlaylist(st);
			if (jukeSig.tab === "lyrics") renderLyrics(st);
		};

		const bindJuke = () => {
			const juke = root() ? root().querySelector("[data-tea-juke]") : null;
			if (!juke || juke.dataset.bound === "1") return;
			juke.dataset.bound = "1";
			const m = () => musicApi();

			juke.addEventListener("click", (e) => {
				const song = e.target.closest("[data-juke-index]");
				if (song && m()) {
					m().playTrackByIndex(Number(song.dataset.jukeIndex));
					setTimeout(renderJuke, 150);
					return;
				}
				const tab = e.target.closest("[data-juke-tab]");
				if (tab) {
					jukeSig.tab = tab.dataset.jukeTab;
					for (const b of juke.querySelectorAll("[data-juke-tab]")) b.classList.toggle("is-active", b === tab);
					const list = jukeNode("[data-juke-list]");
					const lrc = jukeNode("[data-juke-lyrics]");
					if (list) list.hidden = jukeSig.tab !== "list";
					if (lrc) lrc.hidden = jukeSig.tab !== "lyrics";
					if (jukeSig.tab === "lyrics" && m()) renderLyrics(m().getState(), true);
				}
			});

			juke.querySelector("[data-juke-play]").addEventListener("click", () => {
				if (m()) m().togglePlay();
				setTimeout(renderJuke, 160);
			});
			juke.querySelector("[data-juke-prev]").addEventListener("click", () => m() && m().playPrev());
			juke.querySelector("[data-juke-next]").addEventListener("click", () => m() && m().playNext());
			juke.querySelector("[data-juke-seek]").addEventListener("input", (e) => {
				if (m()) m().seek(Number(e.target.value) / 10);
			});
			juke.querySelector("[data-juke-vol]").addEventListener("input", (e) => {
				if (m()) m().setVolume(Number(e.target.value) / 100);
			});
			juke.querySelector("[data-juke-close]").addEventListener("click", () => {
				const shell = root();
				if (!shell) return;
				if (window.matchMedia("(min-width: 1241px)").matches) shell.classList.add("is-juke-hidden");
				else shell.classList.remove("is-juke-open");
			});

			if (!rt.jukeTimer) {
				rt.jukeTimer = setInterval(() => {
					if (!root()) {
						clearInterval(rt.jukeTimer);
						rt.jukeTimer = null;
						return;
					}
					renderJuke();
				}, 900);
			}
			renderJuke();
		};

		const setup = () => {
			const shell = root();
			if (!shell || shell.dataset.ready === "1") return;
			shell.dataset.ready = "1";

			// 视口高度：按导航栏实际底部算，避免和胶囊导航打架
			const measure = () => {
				const nav = document.querySelector("#navbar") || document.querySelector("header");
				if (!nav) return;
				const r = nav.getBoundingClientRect();
				const top = Math.max(0, Math.round(r.bottom)) + 8;
				if (top > 8) shell.style.setProperty("--tea-top", top + "px");
			};
			measure();
			window.addEventListener("resize", measure);

			renderSelf();
			setGate(!!rt.visitor);
			loadHistory();
			startLoop();

			// 身份弹窗
			for (const el of document.querySelectorAll("[data-tea-enter]")) {
				el.addEventListener("click", openDialog);
			}
			const form = document.querySelector("[data-tea-identity]");
			if (form) {
				form.addEventListener("submit", (e) => {
					if (e.submitter && e.submitter.value === "cancel") return;
					submitIdentity(e);
				});
				form.elements.nick.addEventListener("input", updatePreview);
			}

			// 输入框
			const ta = q("[data-tea-text]");
			const counter = q("[data-tea-count]");
			if (ta) {
				ta.addEventListener("input", () => {
					ta.style.height = "auto";
					ta.style.height = Math.min(ta.scrollHeight, 128) + "px";
					if (counter) counter.textContent = `${ta.value.length}/500`;
				});
				ta.addEventListener("keydown", (e) => {
					if (e.key === "Enter" && !e.shiftKey && !e.isComposing) {
						e.preventDefault();
						const f = q("[data-tea-composer]");
						if (f) f.requestSubmit();
					}
				});
			}
			const composer = q("[data-tea-composer]");
			if (composer) {
				composer.addEventListener("submit", async (e) => {
					e.preventDefault();
					if (!ta) return;
					const text = ta.value.trim();
					if (!text) return;
					if (!rt.visitor) {
						openDialog();
						return;
					}
					showError("");
					ta.value = "";
					ta.style.height = "auto";
					if (counter) counter.textContent = "0/500";
					await sendText(text);
				});
			}

			// 回到最新
			const jump = q("[data-tea-jump]");
			if (jump) {
				jump.addEventListener("click", () => {
					scrollBottom(true);
					jump.hidden = true;
				});
			}
			const feed = feedEl();
			if (feed) {
				feed.addEventListener("scroll", () => {
					if (atBottom()) {
						const j = q("[data-tea-jump]");
						if (j) j.hidden = true;
					}
				});
			}

			// 刷新 / 抽屉
			const refresh = q("[data-tea-refresh]");
			if (refresh) {
				refresh.addEventListener("click", () => {
					rt.since = null;
					clearTimeout(rt.timer);
					loadHistory();
					startLoop();
				});
			}
			const toggle = q("[data-tea-roster-toggle]");
			const scrim = q("[data-tea-scrim]");
			const closeDrawer = () => {
				shell.classList.remove("is-drawer-open");
				if (scrim) scrim.hidden = true;
			};
			if (toggle) {
				toggle.addEventListener("click", () => {
					const open = !shell.classList.contains("is-drawer-open");
					shell.classList.toggle("is-drawer-open", open);
					if (scrim) scrim.hidden = !open;
				});
			}
			if (scrim) scrim.addEventListener("click", closeDrawer);

			// 点歌台开关
			const jukeToggle = q("[data-tea-juke-toggle]");
			if (jukeToggle) {
				jukeToggle.addEventListener("click", () => {
					if (window.matchMedia("(min-width: 1241px)").matches) shell.classList.toggle("is-juke-hidden");
					else shell.classList.toggle("is-juke-open");
					bindJuke();
					setTimeout(renderJuke, 60);
				});
			}
			const jukeScrim = q("[data-juke-scrim]");
			if (jukeScrim) jukeScrim.addEventListener("click", () => shell.classList.remove("is-juke-open"));
			bindJuke();
		};

		if (!rt.bound) {
			for (const name of ["astro:page-load", "astro:after-swap", "swup:contentReplaced", "swup:page:view"]) {
				document.addEventListener(name, () => {
					if (root()) setup();
					else clearTimeout(rt.timer);
				});
			}
			rt.bound = true;
		}
		setup();
	})();
</script>

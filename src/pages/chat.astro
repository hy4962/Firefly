---
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const title = "茶室";
const description = "一个连着 Matrix 公共大厅的聊天室，消息会同步到已接入的友站。";

// ── 桥接服务地址（Cloudflare Worker，见仓库 chat-bridge/ ）────────────
// 调试时可用 ?api=http://127.0.0.1:8787 覆盖，方便本地联调。
const CHAT_API = "https://tea.9ll.uk";

// 站点署名，后缀会拼到访客昵称后面同步到大厅
const SITE_NAME = "折腾进行时";

const roomRules = [
	"友善交流，别刷屏、别发广告，也别打探别人的隐私。",
	"这里是公开房间，消息会同步到 Matrix 和其他友站，别放私密内容。",
	"图片每 10 分钟最多 3 张，慢慢来。",
];

// 互联茶室友站（点击顶栏的站点按钮可查看）
const peers = [
	{ name: "听雨茶室", owner: "朝朝听雨", avatar: "https://rainzt.cn/zzty.png", url: "https://rainzt.cn/chat/", desc: "物物而不物于物，念念而不念于念" },
	{ name: "Detached 茶室", owner: "Detached", avatar: "https://detached.online/favicon.ico", url: "https://detached.online/chat/", desc: "总能看见不完美，所以一直追求完美" },
	{ name: "雪的茶室", owner: "AIOVTUE-雪", avatar: "https://daily.yybb.us/owo/snow/snow-03.webp", url: "https://chat.yybb.us/", desc: "雨滴会记录生命中的每一个瞬间" },
	{ name: "Somoe 茶室", owner: "Somoe", avatar: "https://somoe.xyz/favicon.ico", url: "https://somoe.xyz/chat", desc: "在文字的深海里，拾贝而行" },
];
const selfSite = { name: "折腾进行时", owner: "HY", avatar: "/assets/images/kirino.webp", url: "https://www.9ll.uk/chat/", desc: "在折腾里慢慢变老", isSelf: true };
---

<MainGridLayout title={title} description={description} heading={title}>
	<section class="tea-app" id="tea-app" data-tea-app data-api={CHAT_API} data-site={SITE_NAME}>
		<!-- ── 左栏 ───────────────────────────────────────────── -->
		<aside class="tea-side" data-tea-side>
			<div class="tea-card tea-me" data-tea-me>
				<div class="tea-me__cover" aria-hidden="true">
					<span class="tea-me__glow"></span>
					<span class="tea-me__glow tea-me__glow--b"></span>
				</div>
				<div class="tea-me__body">
					<div class="tea-me__avatar" data-tea-me-avatar aria-hidden="true">?</div>
					<div class="tea-me__name" data-tea-me-name>还没入座</div>
					<p class="tea-me__meta" data-tea-me-meta>填个昵称，就能在这儿坐下。</p>
					<div class="tea-me__stats">
						<span><b data-tea-me-count>0</b> 发言</span>
						<span class="tea-me__dot"></span>
						<span data-tea-me-since>今天刚到</span>
					</div>
					<button type="button" class="tea-btn tea-btn--ghost tea-me__act" data-tea-enter>
						<Icon is:inline name="material-symbols:login-rounded" /> 入座
					</button>
				</div>
			</div>

			<div class="tea-card tea-rooms">
				<header class="tea-card__head">
					<span class="tea-card__title">
						<Icon is:inline name="material-symbols:forum-outline-rounded" /> 房间与成员
					</span>
				</header>
				<ul class="tea-rooms__list" data-tea-rooms>
					<li class="tea-rooms__group">互联房间</li>
					<li>
						<button type="button" class="tea-room-item is-active" data-room="lobby">
							<span class="tea-room-item__avatar"><img src="/assets/images/room-lobby.webp" data-room-avatar="lobby" alt="" /></span>
							<span class="tea-room-item__copy">
								<b>互联茶室</b>
								<span>和其他站点的朋友一起聊天</span>
							</span>
						</button>
					</li>
					<li class="tea-rooms__group">本站</li>
					<li>
						<button type="button" class="tea-room-item" data-room="chat">
							<span class="tea-room-item__avatar"><img src="/assets/images/room-chat.webp" data-room-avatar="chat" alt="" loading="lazy" /></span>
							<span class="tea-room-item__copy">
								<b>闲聊</b>
								<span>随便聊聊日常与折腾</span>
							</span>
						</button>
					</li>
				</ul>
			</div>

			<div class="tea-card tea-roster">
				<header class="tea-card__head">
					<span class="tea-card__title">
						<Icon is:inline name="material-symbols:group-outline-rounded" /> 在线茶友
					</span>
					<span class="tea-roster__count"><i></i><b data-tea-online>0</b> 人在线</span>
				</header>
				<ul class="tea-roster__list" data-tea-members>
					<li class="tea-roster__empty">暂时没人，等你来坐第一桌。</li>
				</ul>
				<button type="button" class="tea-roster__all" data-tea-roster-all hidden>显示全部</button>
			</div>

			<div class="tea-card tea-notice">
				<header class="tea-card__head">
					<span class="tea-card__title">
						<Icon is:inline name="material-symbols:campaign-outline-rounded" /> 群公告
					</span>
				</header>
				<ul class="tea-notice__list">
					{roomRules.map((rule) => <li>{rule}</li>)}
				</ul>
			</div>
		</aside>

		<!-- ── 主区 ───────────────────────────────────────────── -->
		<div class="tea-room">
			<header class="tea-bar" data-tea-bar>
				<div class="tea-bar__brand">
					<span class="tea-bar__mark"><Icon is:inline name="material-symbols:emoji-food-beverage-outline-rounded" /></span>
					<div>
						<h1 class="tea-bar__title">{title}</h1>
						<p class="tea-bar__sub">Matrix 互联大厅</p>
					</div>
					<button type="button" class="tea-room-switch" data-tea-sites-trigger aria-expanded="false" title="查看互联茶室友站" aria-label="查看互联茶室友站">
						<Icon is:inline name="material-symbols:public-rounded" />
						<span>互联茶室</span>
						<b data-tea-sites-count>{peers.length + 1}</b><span class="tea-room-switch__unit">个站点</span>
						<Icon is:inline name="material-symbols:expand-more-rounded" class="tea-room-switch__caret" />
					</button>
				</div>
				<div class="tea-bar__tools">
					<span class="tea-conn" data-tea-conn><i></i><span data-tea-conn-text>连接中</span></span>
					<button type="button" class="tea-thread-pill" data-tea-threads-trigger aria-expanded="false" title="查看活跃线程回复" aria-label="查看活跃线程回复" hidden>
						<Icon is:inline name="material-symbols:forum-rounded" />
						<span>线程回复</span>
						<b data-tea-threads-count>0</b>
					</button>
					<button type="button" class="tea-icon-btn" data-tea-juke-toggle title="点歌台" aria-label="打开点歌台">
						<Icon is:inline name="material-symbols:music-note-rounded" />
					</button>
					<button type="button" class="tea-icon-btn" data-tea-roster-toggle title="在线列表" aria-label="在线列表">
						<Icon is:inline name="material-symbols:group-outline-rounded" />
					</button>
					<button type="button" class="tea-icon-btn" data-tea-refresh title="刷新" aria-label="刷新">
						<Icon is:inline name="material-symbols:refresh-rounded" />
					</button>
				</div>
			</header>

			<div class="tea-banner">
				<Icon is:inline name="material-symbols:public" />
				<p>
					<span data-tea-banner-text>公开房间，消息会同步到 Matrix 大厅和已接入的友站。</span>
					<span class="tea-banner__peers" data-tea-peers>
						{peers.map((p, i) => (
							<>
								{i > 0 && <span class="tea-banner__sep">、</span>}
								<a href={p.url} target="_blank" rel="noopener noreferrer">{p.name}</a>
							</>
						))}
					</span>
				</p>
			</div>

			<!-- ── 置顶消息 ───────────────────────────────────────── -->
			<div class="tea-pins" data-tea-pins hidden>
				<span class="tea-pins__icon"><Icon is:inline name="material-symbols:push-pin" /></span>
				<div class="tea-pins__body" data-tea-pins-body></div>
				<button type="button" class="tea-pins__toggle" data-tea-pins-toggle aria-label="展开或收起置顶">展开</button>
			</div>

			<div class="tea-feed-wrap">
				<div class="tea-feed" data-tea-feed tabindex="0" role="log" aria-live="polite" aria-label="茶室消息">
					<div class="tea-feed__status" data-tea-feed-status>
						<span class="tea-spinner"></span> 正在看看大家聊到哪儿了…
					</div>
				</div>
				<button type="button" class="tea-jump" data-tea-jump hidden>
					<Icon is:inline name="material-symbols:arrow-downward-rounded" /> 有新消息
				</button>
				<button type="button" class="tea-readjump" data-tea-readjump hidden>回到上次阅读位置 ↑</button>
			</div>

			<form class="tea-composer" data-tea-composer autocomplete="off">
				<div class="tea-gate" data-tea-gate>
					<span class="tea-gate__icon"><Icon is:inline name="material-symbols:coffee-rounded" /></span>
					<div class="tea-gate__copy">
						<b>坐下来，一起聊聊吧</b>
						<span>填个昵称就能进，不用注册账号。</span>
					</div>
					<button type="button" class="tea-btn tea-btn--primary" data-tea-enter>进入茶室</button>
				</div>
				<div class="tea-typing" data-tea-typing hidden aria-live="polite"><span class="tea-typing__dots"><i></i><i></i><i></i></span><span data-tea-typing-text></span></div>
				<div class="tea-replybar" data-tea-replybar hidden>
					<span class="tea-replybar__icon"><Icon is:inline name="material-symbols:reply-rounded" /></span>
					<span class="tea-replybar__copy"><b data-tea-reply-who></b><span data-tea-reply-text></span></span>
					<button type="button" data-tea-reply-cancel aria-label="取消回复">×</button>
				</div>
				<div class="tea-input" data-tea-input hidden>
					<div class="tea-md-preview" data-tea-md-preview hidden>
						<div class="tea-md-preview__head">
							<span>预览 Markdown</span>
							<button type="button" data-tea-md-close aria-label="切回编辑">切回编辑</button>
						</div>
						<div class="tea-md-preview__body" data-tea-md-body></div>
					</div>
					<textarea
						name="message"
						rows="1"
						maxlength="500"
						placeholder="说点什么…"
						data-tea-text
					></textarea>
					<div class="tea-input__tools">
						<button type="button" class="tea-tool" data-tea-emoji-toggle title="表情" aria-label="表情">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
						</button>
						<button type="button" class="tea-tool" data-tea-image-pick title="发送图片或链接" aria-label="发送图片或链接">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
						</button>
						<input type="file" accept="image/*" data-tea-image-file hidden />
						<button type="button" class="tea-tool" data-tea-poll-toggle title="发起投票" aria-label="发起投票">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3v18h18"/><rect x="7" y="10" width="3" height="8" rx="1"/><rect x="13" y="5" width="3" height="13" rx="1"/><rect x="19" y="13" width="3" height="5" rx="1"/></svg>
						</button>
						<button type="button" class="tea-tool" data-tea-md-toggle title="预览 Markdown" aria-label="预览 Markdown">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
						</button>
						<span class="tea-input__count" data-tea-count>0/500</span>
						<button type="submit" class="tea-btn tea-btn--primary tea-send" data-tea-send>
							<span>发送</span>
							<Icon is:inline name="material-symbols:send-rounded" />
						</button>
					</div>
					<div class="tea-emoji-panel" data-tea-emoji-panel hidden></div>
				</div>
				<p class="tea-form-error" data-tea-error hidden></p>
			</form>
		</div>

		<!-- ── 点歌台：茶室共享队列，复用站点全局播放器 ─────────── -->
		<aside class="tea-juke" data-tea-juke aria-label="点歌台">
			<header class="tea-juke__head">
				<div class="tea-juke__title">
					<Icon is:inline name="material-symbols:music-note-rounded" />
					<h2>点歌台</h2>
				</div>
				<div class="tea-juke__tools">
					<span class="tea-juke__live" data-juke-live><i></i><b>未开始</b></span>
					<button type="button" class="tea-icon-btn" data-juke-listen title="开始收听" aria-label="开始收听">
						<Icon is:inline name="material-symbols:headphones-rounded" />
					</button>
					<button type="button" class="tea-icon-btn" data-juke-close aria-label="关闭点歌台">
						<Icon is:inline name="material-symbols:close-rounded" />
					</button>
				</div>
			</header>

			<div class="tea-juke__stage">
				<div class="tea-juke__cover" data-juke-cover>
					<span class="tea-juke__eq"><i></i><i></i><i></i></span>
				</div>
				<div class="tea-juke__info">
					<div class="tea-juke__meta">
						<h3 data-juke-title>还没开始听</h3>
						<p data-juke-artist>从下面挑一首，或者让茶室随便放</p>
					</div>
					<div class="tea-juke__timeline">
						<input type="range" min="0" max="1000" step="1" value="0" data-juke-seek aria-label="播放进度" />
						<div class="tea-juke__times">
							<span data-juke-cur>0:00</span>
							<span data-juke-dur>0:00</span>
						</div>
					</div>
				</div>
			</div>

			<div class="tea-juke__controls">
				<button type="button" class="tea-juke__ctrl" data-juke-random title="随便放一首" aria-label="随便放一首">
					<Icon is:inline name="material-symbols:shuffle-rounded" />
				</button>
				<button type="button" class="tea-juke__ctrl" data-juke-prev aria-label="上一首">
					<Icon is:inline name="material-symbols:skip-previous-rounded" />
				</button>
				<button type="button" class="tea-juke__play" data-juke-play aria-label="播放">
					<span data-juke-icon-play><Icon is:inline name="material-symbols:play-arrow-rounded" /></span>
					<span data-juke-icon-pause hidden><Icon is:inline name="material-symbols:pause-rounded" /></span>
				</button>
				<button type="button" class="tea-juke__ctrl" data-juke-next aria-label="切下一首">
					<Icon is:inline name="material-symbols:skip-next-rounded" />
				</button>
				<label class="tea-juke__vol" title="音量">
					<Icon is:inline name="material-symbols:volume-up-rounded" />
					<input type="range" min="0" max="100" step="1" value="70" data-juke-vol aria-label="音量" />
				</label>
			</div>

			<nav class="tea-juke__tabs" role="tablist">
				<button type="button" class="is-active" data-juke-tab="lyrics" role="tab">歌词</button>
				<button type="button" data-juke-tab="search" role="tab">搜索</button>
				<button type="button" data-juke-tab="list" role="tab">歌单</button>
				<button type="button" data-juke-tab="history" role="tab">历史</button>
			</nav>

			<div class="tea-juke__panel tea-juke__lyrics" data-juke-lyrics role="tabpanel">
				<p class="tea-juke__empty">先挑一首歌吧。</p>
			</div>
			<div class="tea-juke__panel" data-juke-search role="tabpanel" hidden>
				<form class="tea-juke__searchform" data-juke-searchform>
					<input type="search" maxlength="40" placeholder="在站点歌单里找歌…" data-juke-q aria-label="搜索歌单" />
					<button type="submit" class="tea-btn tea-btn--primary">找</button>
				</form>
				<div class="tea-juke__results" data-juke-results><p class="tea-juke__empty">只搜本站歌单里的歌。</p></div>
			</div>
			<div class="tea-juke__panel" data-juke-list role="tabpanel" hidden>
				<p class="tea-juke__empty">歌单还在路上…</p>
			</div>
			<div class="tea-juke__panel" data-juke-history role="tabpanel" hidden>
				<p class="tea-juke__empty">还没有播放记录。</p>
			</div>

			<div class="tea-juke__queue">
				<div class="tea-juke__queuehead">
					<span>待播 <b data-juke-queuecount>0</b></span>
					<div class="tea-juke__queuetabs">
						<button type="button" class="is-active" data-juke-queue-tab="request">点播</button>
						<button type="button" data-juke-queue-tab="rotation">轮播</button>
					</div>
				</div>
				<div class="tea-juke__queuelist" data-juke-queue><p class="tea-juke__empty">队列空着，点一首歌吧。</p></div>
			</div>
		</aside>

		<!-- ── 互联友站浮层 ─────────────────────────────────────── -->
		<div class="tea-pop tea-pop--sites" data-tea-sites-pop hidden role="dialog" aria-label="互联茶室友站列表">
			<div class="tea-pop__head">
				<span class="tea-pop__title"><Icon is:inline name="material-symbols:emoji-food-beverage-outline-rounded" /> 互联茶室</span>
				<div class="tea-pop__links">
					<a href="https://app.element.io/" target="_blank" rel="noopener noreferrer">Element <Icon is:inline name="material-symbols:open-in-new-rounded" /></a>
					<a href="https://rainzt.cn/posts/tingyu-tea-room-guide/" target="_blank" rel="noopener noreferrer">加入指南 <Icon is:inline name="material-symbols:open-in-new-rounded" /></a>
					<button type="button" data-tea-pop-close aria-label="关闭">×</button>
				</div>
			</div>
			<p class="tea-pop__note">以下这些博客是和本站聊天互相连通的哦，也可以去他们的小站坐坐：</p>
			<div class="tea-pop__list" data-tea-sites-list></div>
		</div>

		<!-- ── 活跃线程浮层 ─────────────────────────────────────── -->
		<div class="tea-pop tea-pop--threads" data-tea-threads-pop hidden role="dialog" aria-label="活跃线程回复列表">
			<div class="tea-pop__head">
				<span class="tea-pop__title"><Icon is:inline name="material-symbols:forum-rounded" /> 活跃线程回复</span>
				<div class="tea-pop__links">
					<span class="tea-pop__badge" data-tea-threads-total>0 个</span>
					<button type="button" data-tea-pop-close aria-label="关闭">×</button>
				</div>
			</div>
			<div class="tea-pop__list" data-tea-threads-list></div>
		</div>

		<!-- ── 线程详情弹层 ─────────────────────────────────────── -->
		<div class="tea-thread" data-tea-thread-view hidden role="dialog" aria-label="线程回复详情">
			<div class="tea-thread__scrim" data-tea-thread-close></div>
			<div class="tea-thread__panel">
				<header class="tea-thread__head">
					<div>
						<b>线程回复</b>
						<span data-tea-thread-sub>Matrix 线程 · 0 条回复</span>
					</div>
					<button type="button" class="tea-icon-btn" data-tea-thread-close aria-label="关闭线程">
						<Icon is:inline name="material-symbols:close-rounded" />
					</button>
				</header>
				<div class="tea-thread__body" data-tea-thread-body></div>
				<div class="tea-thread__footer" data-tea-thread-footer>
					<textarea rows="2" maxlength="500" placeholder="在此线程中回复，Enter 发送…" data-tea-thread-input></textarea>
					<button type="button" class="tea-btn tea-btn--primary" data-tea-thread-send>发送</button>
				</div>
			</div>
		</div>

		<!-- ── 图片预览 ─────────────────────────────────────────── -->
		<div class="tea-zoom" data-tea-zoom hidden>
			<button type="button" class="tea-zoom__close" data-tea-zoom-close aria-label="关闭预览">
				<Icon is:inline name="material-symbols:close-rounded" />
			</button>
			<img data-tea-zoom-img alt="" />
		</div>

		<!-- ── 遮罩（移动端抽屉 / 点歌台浮层） ─────────────────── -->
		<div class="tea-scrim" data-tea-scrim hidden></div>
		<div class="tea-scrim" data-juke-scrim hidden></div>
	</section>

	<!-- ── 身份弹窗 ─────────────────────────────────────────── -->
	<dialog class="tea-dialog" data-tea-dialog aria-labelledby="tea-dialog-title">
		<form method="dialog" class="tea-dialog__inner" data-tea-identity>
			<header class="tea-dialog__head">
				<span class="tea-dialog__icon"><Icon is:inline name="material-symbols:local-cafe-rounded" /></span>
				<button type="button" class="tea-icon-btn tea-dialog__close" data-tea-dialog-close aria-label="关闭">
					<Icon is:inline name="material-symbols:close-rounded" />
				</button>
			</header>
			<h3 id="tea-dialog-title">欢迎来喝杯茶</h3>
			<p class="tea-dialog__desc">填个昵称和邮箱就能开始聊天，邮箱不会公开显示。</p>

			<label class="tea-field">
				<span>昵称 <em>最多 8 个字</em></span>
				<input type="text" name="nick" maxlength="8" placeholder="你的名字或昵称" required />
			</label>
			<label class="tea-field">
				<span>邮箱 <em>不会公开，只用来认人</em></span>
				<input type="email" name="email" maxlength="120" placeholder="you@example.com" required />
			</label>
			<label class="tea-field">
				<span>网站 <em>选填</em></span>
				<input type="text" name="website" maxlength="120" placeholder="https://你的博客" />
			</label>

			<div class="tea-dialog__preview">
				<div class="tea-dialog__avatar" data-tea-preview-avatar>?</div>
				<div class="tea-dialog__preview-copy">
					<b data-tea-preview-name>还没填昵称</b>
					<span>会以「昵称 · {SITE_NAME}」的身份出现在大厅</span>
				</div>
			</div>

			<button type="submit" class="tea-btn tea-btn--primary tea-dialog__submit" value="ok" data-tea-submit>
				<span data-tea-submit-label>进入茶室</span>
				<Icon is:inline name="material-symbols:arrow-forward-rounded" />
			</button>
			<p class="tea-dialog__error" data-tea-dialog-error hidden></p>

			<div class="tea-dialog__divider"><span>也可以使用 Waline 账号</span></div>
			<button type="button" class="tea-btn tea-btn--ghost tea-dialog__waline" data-tea-waline-open>
				<Icon is:inline name="material-symbols:forum-outline-rounded" />
				Waline 账号登录 / 注册
			</button>
			<p class="tea-dialog__hint">同一邮箱共用茶室资料、聊天记录和网站绑定，切换登录方式无需重复填写。</p>
			<button type="button" class="tea-dialog__back" data-tea-matrix-open>
				<Icon is:inline name="material-symbols:admin-panel-settings-outline-rounded" /> 已有 Matrix 账号？登录
			</button>
		</form>

		<form method="dialog" class="tea-dialog__inner" data-tea-waline hidden>
			<header class="tea-dialog__head">
				<span class="tea-dialog__icon"><Icon is:inline name="material-symbols:forum-outline-rounded" /></span>
				<button type="button" class="tea-icon-btn tea-dialog__close" data-tea-waline-close aria-label="关闭">
					<Icon is:inline name="material-symbols:close-rounded" />
				</button>
			</header>
			<h3>用 Waline 账号进茶室</h3>
			<p class="tea-dialog__desc">用留言板那个账号登录，昵称、头像和网站直接沿用。</p>

			<label class="tea-field">
				<span>邮箱</span>
				<input type="email" name="email" autocomplete="email" maxlength="120" placeholder="you@example.com" required />
			</label>
			<label class="tea-field">
				<span>密码</span>
				<input type="password" name="password" autocomplete="current-password" maxlength="120" placeholder="Waline 密码" required />
			</label>

			<button type="submit" class="tea-btn tea-btn--primary tea-dialog__submit" data-tea-waline-submit>
				<span data-tea-waline-label>登录并进入</span>
				<Icon is:inline name="material-symbols:arrow-forward-rounded" />
			</button>
			<p class="tea-dialog__error" data-tea-waline-error hidden></p>
			<button type="button" class="tea-dialog__back" data-tea-waline-back>
				<Icon is:inline name="material-symbols:arrow-back-rounded" /> 用昵称和邮箱进入
			</button>
			<p class="tea-dialog__hint">还没注册过？先去留言板发一条评论注册，再回来登录。</p>
		</form>

		<form method="dialog" class="tea-dialog__inner" data-tea-matrix hidden>
			<header class="tea-dialog__head">
				<span class="tea-dialog__icon"><Icon is:inline name="material-symbols:admin-panel-settings-outline-rounded" /></span>
				<button type="button" class="tea-icon-btn tea-dialog__close" data-tea-matrix-close aria-label="关闭">
					<Icon is:inline name="material-symbols:close-rounded" />
				</button>
			</header>
			<h3>用 Matrix 账号进茶室</h3>
			<p class="tea-dialog__desc">站长或有 Matrix 账号的人用这个。发言直接用你自己的账号，其他站点看到的也是你。</p>

			<label class="tea-field">
				<span>服务器</span>
				<input type="text" name="homeserver" value="https://matrix.0dm.cn" readonly />
			</label>
			<label class="tea-field">
				<span>用户名</span>
				<input type="text" name="username" autocomplete="username" placeholder="heyuan" required />
			</label>
			<label class="tea-field">
				<span>密码</span>
				<input type="password" name="password" autocomplete="current-password" placeholder="Matrix 密码" required />
			</label>

			<button type="submit" class="tea-btn tea-btn--primary tea-dialog__submit" data-tea-matrix-submit>
				<span data-tea-matrix-label>登录并进入</span>
				<Icon is:inline name="material-symbols:arrow-forward-rounded" />
			</button>
			<p class="tea-dialog__error" data-tea-matrix-error hidden></p>
			<button type="button" class="tea-dialog__back" data-tea-matrix-back>
				<Icon is:inline name="material-symbols:arrow-back-rounded" /> 返回其他方式
			</button>
		</form>
	</dialog>

	<!-- ── 投票弹窗 ─────────────────────────────────────────── -->
	<dialog class="tea-dialog tea-poll-dialog" data-tea-poll-dialog aria-labelledby="tea-poll-title">
		<form class="tea-dialog__inner" data-tea-poll-form>
			<header class="tea-dialog__head">
				<span class="tea-dialog__icon"><Icon is:inline name="material-symbols:bar-chart-rounded" /></span>
				<button type="button" class="tea-icon-btn tea-dialog__close" data-tea-poll-close aria-label="关闭">
					<Icon is:inline name="material-symbols:close-rounded" />
				</button>
			</header>
			<h3 id="tea-poll-title">发起投票</h3>
			<p class="tea-dialog__desc">让大家选一选，投票会显示在聊天里。</p>
			<label class="tea-field">
				<span>问题</span>
				<input type="text" name="question" maxlength="80" placeholder="想问点什么？" required />
			</label>
			<div class="tea-poll-options" data-tea-poll-options>
				<label class="tea-field"><span>选项 1</span><input type="text" name="option" maxlength="60" placeholder="选项一" required /></label>
				<label class="tea-field"><span>选项 2</span><input type="text" name="option" maxlength="60" placeholder="选项二" required /></label>
			</div>
			<button type="button" class="tea-btn tea-btn--ghost tea-poll-add" data-tea-poll-add>+ 添加选项</button>
			<button type="submit" class="tea-btn tea-btn--primary tea-dialog__submit" data-tea-poll-submit>
				<span>发起投票</span>
				<Icon is:inline name="material-symbols:send-rounded" />
			</button>
			<p class="tea-dialog__error" data-tea-poll-error hidden></p>
		</form>
	</dialog>

	<!-- ── 成员名片 ─────────────────────────────────────────── -->
	<dialog class="tea-membercard" data-tea-membercard aria-labelledby="tea-membercard-title">
		<div class="tea-membercard__inner">
			<header class="tea-membercard__head">
				<h3 id="tea-membercard-title">成员名片</h3>
				<button type="button" class="tea-icon-btn" data-tea-membercard-close aria-label="关闭">
					<Icon is:inline name="material-symbols:close-rounded" />
				</button>
			</header>
			<div class="tea-membercard__cols">
				<div class="tea-membercard__left" data-tea-mc-left></div>
				<div class="tea-membercard__right">
					<div class="tea-membercard__songs-head">
						<span>点过的歌 <em data-tea-mc-song-note></em></span>
						<div class="tea-membercard__sort">
							<button type="button" class="is-active" data-tea-mc-sort="time">按时间</button>
							<button type="button" data-tea-mc-sort="count">按次数</button>
						</div>
					</div>
					<ul class="tea-membercard__songs" data-tea-mc-songs></ul>
				</div>
			</div>
		</div>
	</dialog>
</MainGridLayout>

<style is:global>
	/* ─── 页面容器：固定视口，盖住侧栏，独占一屏 ─────────────── */
	html:has(.tea-app) {
		overflow: hidden !important;
		overscroll-behavior: none;
	}
	body:has(.tea-app) {
		overflow: hidden !important;
	}
	/* 上游布局的外层带 transform / 入场动画，会让 position:fixed 认错包含块，
	   这里针对本页拆掉；同时把壁纸和侧栏藏掉，给茶室一个干净的底 */
	html:has(.tea-app) :is(#content-panel, #content-panel-inner, #main-grid, #content-column, #content-wrapper, #swup-container) {
		transform: none !important;
		animation: none !important;
		opacity: 1 !important;
		contain: none !important;
	}
	html:has(.tea-app) body :is(#wallpaper-wrapper, #category-bar-wrapper, #category-bar, #left-sidebar-wrapper, #right-sidebar-wrapper, #left-sidebar, #right-sidebar, #left-sidebar-static, #right-sidebar-static, #left-sidebar-sticky, #right-sidebar-sticky, #left-sidebar-dynamic, #right-sidebar-dynamic, #mobile-bottom-sidebar, .site-footer, .floating-controls-container) {
		display: none !important;
	}
	html:has(.tea-app),
	html:has(.tea-app) body {
		background: var(--page-bg, #f6f6f1) !important;
	}

	html:has(.tea-app) {
		--tea-line: var(--line-divider, rgba(0, 0, 0, 0.08));
		--tea-line-strong: var(--line-color, rgba(0, 0, 0, 0.12));
		--tea-muted: color-mix(in oklch, currentColor 58%, transparent);
		--tea-muted-soft: color-mix(in oklch, currentColor 42%, transparent);
		--tea-surface: var(--card-bg, #fff);
		--tea-surface-2: color-mix(in oklch, var(--primary) 5%, var(--card-bg, #fff));
	}
	.tea-app {
		--tea-top: 5rem;
		--tea-gap: 1rem;
		position: fixed;
		z-index: 28;
		top: var(--tea-top);
		bottom: 0.9rem;
		left: max(var(--tea-gap), calc((100vw - var(--page-width, 100rem)) / 2));
		right: max(var(--tea-gap), calc((100vw - var(--page-width, 100rem)) / 2));
		display: grid;
		grid-template-columns: 17.5rem minmax(0, 1fr) 17.5rem;
		gap: 0.9rem;
		min-height: 0;
		color: inherit;
	}
	.tea-app.is-juke-hidden {
		grid-template-columns: 17.5rem minmax(0, 1fr);
	}
	.tea-app.is-juke-hidden .tea-juke {
		display: none;
	}

	/* ─── 通用卡片 ─────────────────────────────────────────── */
	.tea-card {
		background: var(--tea-surface);
		border: 1px solid var(--tea-line);
		border-radius: 1.1rem;
		overflow: hidden;
	}
	.tea-card__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.85rem 0.95rem 0.55rem;
	}
	.tea-card__title {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.01em;
	}
	.tea-card__title svg {
		width: 1rem;
		height: 1rem;
		opacity: 0.72;
	}

	/* ─── 左栏 ─────────────────────────────────────────────── */
	.tea-side {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		min-height: 0;
		overflow-y: auto;
		scrollbar-width: thin;
		padding-right: 2px;
	}
	.tea-side::-webkit-scrollbar {
		width: 4px;
	}
	.tea-side::-webkit-scrollbar-thumb {
		background: color-mix(in oklch, currentColor 18%, transparent);
		border-radius: 999px;
	}

	/* 名片 */
	.tea-me {
		flex: none;
		position: relative;
	}
	.tea-me__cover {
		position: relative;
		height: 5.6rem;
		overflow: hidden;
		background:
			linear-gradient(120deg, color-mix(in oklch, var(--primary) 34%, transparent), transparent 62%),
			color-mix(in oklch, var(--primary) 10%, var(--card-bg, #fff));
	}
	.tea-me__glow {
		position: absolute;
		width: 7rem;
		height: 7rem;
		border-radius: 50%;
		background: color-mix(in oklch, var(--primary) 42%, transparent);
		filter: blur(26px);
		top: -2.6rem;
		left: -1.2rem;
	}
	.tea-me__glow--b {
		top: auto;
		left: auto;
		right: -1.6rem;
		bottom: -3rem;
		opacity: 0.65;
		background: color-mix(in oklch, var(--primary) 26%, transparent);
	}
	.tea-me__line {
		display: none;
	}
	.tea-me__body {
		position: relative;
		z-index: 1;
		padding: 0 1rem 1rem;
		margin-top: -1.75rem;
		display: grid;
		justify-items: center;
		text-align: center;
		gap: 0.3rem;
	}
	.tea-me__avatar {
		width: 3.4rem;
		height: 3.4rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: 1.15rem;
		font-weight: 600;
		color: #fff;
		background: linear-gradient(150deg, color-mix(in oklch, var(--primary) 92%, white), color-mix(in oklch, var(--primary) 66%, #1f2937));
		border: 3px solid var(--tea-surface);
		box-shadow: 0 6px 18px -8px color-mix(in oklch, var(--primary) 70%, transparent);
		background-size: cover;
		background-position: center;
	}
	.tea-me__name {
		font-size: 0.95rem;
		font-weight: 600;
		line-height: 1.3;
	}
	.tea-me__meta {
		margin: 0;
		font-size: 0.72rem;
		line-height: 1.55;
		color: var(--tea-muted);
	}
	.tea-me__stats {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 0.7rem;
		color: var(--tea-muted);
		margin-top: 0.1rem;
	}
	.tea-me__stats b {
		font-weight: 600;
		color: inherit;
	}
	.tea-me__dot {
		width: 3px;
		height: 3px;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.35;
	}
	.tea-me__act {
		margin-top: 0.35rem;
		font-size: 0.75rem;
		padding: 0.35rem 0.9rem;
	}

	/* 房间列表 */
	.tea-rooms {
		flex: none;
	}
	.tea-rooms__list {
		list-style: none;
		margin: 0;
		padding: 0 0.45rem 0.55rem;
		display: grid;
		gap: 0.15rem;
	}
	.tea-rooms__group {
		font-size: 0.62rem;
		letter-spacing: 0.04em;
		color: var(--tea-muted-soft);
		padding: 0.35rem 0.45rem 0.15rem;
	}
	.tea-room-item {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: 100%;
		padding: 0.38rem 0.45rem;
		border: 1px solid transparent;
		border-radius: 0.6rem;
		background: transparent;
		color: inherit;
		font: inherit;
		text-align: left;
		cursor: pointer;
		transition: background 0.15s ease, border-color 0.15s ease;
	}
	.tea-room-item:hover {
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-room-item.is-active {
		background: color-mix(in oklch, var(--primary) 10%, transparent);
		border-color: color-mix(in oklch, var(--primary) 22%, transparent);
	}
	.tea-room-item__hash {
		width: 1.5rem;
		height: 1.5rem;
		flex: none;
		display: grid;
		place-items: center;
		border-radius: 0.5rem;
		font-size: 0.72rem;
		font-weight: 600;
		color: color-mix(in oklch, var(--primary) 72%, currentColor);
		background: color-mix(in oklch, var(--primary) 12%, transparent);
	}
	.tea-room-item__avatar {
		width: 1.5rem;
		height: 1.5rem;
		flex: none;
		display: grid;
		place-items: center;
		border-radius: 0.5rem;
		overflow: hidden;
		background: color-mix(in oklch, var(--primary) 12%, transparent);
	}
	.tea-room-item__avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.tea-room-item__copy {
		min-width: 0;
		display: grid;
		gap: 0.05rem;
	}
	.tea-room-item__copy b {
		font-size: 0.76rem;
		font-weight: 600;
	}
	.tea-room-item__copy span {
		font-size: 0.64rem;
		color: var(--tea-muted-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* 在线列表 */
	.tea-roster {
		flex: 1 0 auto;
		display: flex;
		flex-direction: column;
		min-height: 9rem;
	}
	.tea-roster__count {
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
		font-size: 0.68rem;
		color: var(--tea-muted);
	}
	.tea-roster__count i {
		width: 0.36rem;
		height: 0.36rem;
		border-radius: 50%;
		background: #34c759;
		box-shadow: 0 0 0 3px color-mix(in oklch, #34c759 22%, transparent);
	}
	.tea-roster__count b {
		font-weight: 600;
	}
	.tea-roster__list {
		list-style: none;
		margin: 0;
		padding: 0 0.45rem 0.55rem;
		overflow-y: auto;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
		scrollbar-width: thin;
	}
	.tea-roster__empty {
		padding: 0.6rem 0.5rem 0.9rem;
		font-size: 0.74rem;
		color: var(--tea-muted-soft);
	}
	.tea-member {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.42rem 0.45rem;
		border-radius: 0.55rem;
		font-size: 0.78rem;
		border-bottom: 1px dashed color-mix(in oklch, currentColor 12%, transparent);
	}
	.tea-member:last-child {
		border-bottom: 0;
	}
	.tea-roster__group {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin: 0.15rem 0 0.25rem;
		padding: 0 0.55rem;
		font-size: 0.7rem;
		font-weight: 600;
		color: var(--tea-muted);
	}
	.tea-roster__group:not(:first-child) {
		margin-top: 0.55rem;
		padding-top: 0.5rem;
		border-top: 1px dashed var(--tea-line);
	}
	.tea-roster__group-count {
		font-weight: 500;
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
	}
	.tea-member:hover {
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-member__badge {
		margin-left: auto;
		flex: none;
		font-size: 0.62rem;
		line-height: 1;
		padding: 0.22rem 0.5rem;
		border-radius: 999px;
		border: 1px solid transparent;
		white-space: nowrap;
	}
	.tea-member__badge.is-online {
		color: #2f9e6b;
		background: color-mix(in oklch, #2f9e6b 12%, transparent);
		border-color: color-mix(in oklch, #2f9e6b 28%, transparent);
	}
	.tea-member__badge.is-away {
		color: #b07d12;
		background: color-mix(in oklch, #e0a020 16%, transparent);
		border-color: color-mix(in oklch, #e0a020 32%, transparent);
	}
	.dark .tea-member__badge.is-online {
		color: #5fd39a;
	}
	.dark .tea-member__badge.is-away {
		color: #f0c264;
	}
	.tea-member__avatar {
		width: 1.7rem;
		height: 1.7rem;
		border-radius: 50%;
		flex: none;
		display: grid;
		place-items: center;
		font-size: 0.7rem;
		font-weight: 600;
		color: #fff;
		background-size: cover;
		background-position: center;
	}
	.tea-member--clickable { cursor: pointer; }
	.tea-member--clickable:hover { color: color-mix(in oklch, var(--primary) 70%, currentColor); }
	.tea-member__copy {
		min-width: 0;
		display: grid;
		gap: 0.05rem;
	}
	.tea-member__name {
		font-weight: 500;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tea-member__site {
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tea-member--idle {
		opacity: 0.92;
	}
	.tea-roster__all {
		flex: none;
		margin: 0 0.55rem 0.6rem;
		padding: 0.42rem 0.5rem;
		border-radius: 0.6rem;
		border: 1px solid var(--tea-line);
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.72rem;
		cursor: pointer;
		opacity: 0.75;
		transition: opacity 0.15s ease, background 0.15s ease;
	}
	.tea-roster__all:hover {
		opacity: 1;
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}

	/* 公告 */
	.tea-notice {
		flex: none;
	}
	.tea-notice__list {
		margin: 0;
		padding: 0 0.95rem 0.9rem;
		list-style: none;
		display: grid;
		gap: 0.4rem;
		font-size: 0.73rem;
		line-height: 1.65;
		color: var(--tea-muted);
		counter-reset: rule;
	}
	.tea-notice__list li {
		position: relative;
		padding-left: 0.95rem;
	}
	.tea-notice__list li::before {
		counter-increment: rule;
		content: counter(rule);
		position: absolute;
		left: 0;
		top: 0.05rem;
		font-size: 0.6rem;
		font-weight: 700;
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
		opacity: 0.85;
	}

	/* ─── 主区 ─────────────────────────────────────────────── */
	.tea-room {
		position: relative;
		display: grid;
		grid-template-rows: auto auto auto minmax(0, 1fr) auto;
		min-height: 0;
		background: var(--tea-surface);
		border: 1px solid var(--tea-line);
		border-radius: 1.1rem;
		overflow: hidden;
	}
	.tea-bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem 0.95rem;
		border-bottom: 1px solid var(--tea-line);
	}
	.tea-bar__brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		min-width: 0;
	}
	.tea-bar__mark {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 0.7rem;
		display: grid;
		place-items: center;
		color: color-mix(in oklch, var(--primary) 82%, #3f2d0a);
		background: color-mix(in oklch, var(--primary) 16%, transparent);
		border: 1px solid color-mix(in oklch, var(--primary) 26%, transparent);
		flex: none;
	}
	.tea-bar__mark svg {
		width: 1.15rem;
		height: 1.15rem;
	}
	.tea-bar__title {
		margin: 0;
		font-size: 0.98rem;
		font-weight: 600;
		line-height: 1.25;
	}
	.tea-bar__sub {
		margin: 0;
		font-size: 0.68rem;
		color: var(--tea-muted-soft);
		letter-spacing: 0.02em;
	}
	.tea-bar__tools {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}
	.tea-conn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.7rem;
		color: var(--tea-muted);
		padding: 0.2rem 0.55rem;
		border-radius: 999px;
		border: 1px solid var(--tea-line);
		margin-right: 0.15rem;
		white-space: nowrap;
	}
	.tea-conn i {
		width: 0.4rem;
		height: 0.4rem;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.45;
	}
	.tea-conn.is-live {
		color: #2f9e6b;
		border-color: color-mix(in oklch, #2f9e6b 30%, transparent);
		background: color-mix(in oklch, #2f9e6b 8%, transparent);
	}
	.tea-conn.is-live i {
		opacity: 1;
		box-shadow: 0 0 0 3px color-mix(in oklch, #2f9e6b 20%, transparent);
	}
	.tea-conn.is-down {
		color: #c0563f;
		border-color: color-mix(in oklch, #c0563f 30%, transparent);
	}
	.tea-icon-btn {
		width: 2rem;
		height: 2rem;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 0.6rem;
		background: transparent;
		color: inherit;
		cursor: pointer;
		opacity: 0.72;
		transition: background 0.15s ease, opacity 0.15s ease;
	}
	.tea-icon-btn:hover {
		opacity: 1;
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.1));
	}
	.tea-icon-btn svg {
		width: 1.15rem;
		height: 1.15rem;
	}

	/* 互联提示条 */
	.tea-banner {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		margin: 0.7rem 0.95rem 0;
		padding: 0.5rem 0.7rem;
		border-radius: 0.75rem;
		background: color-mix(in oklch, var(--primary) 8%, transparent);
		border: 1px solid color-mix(in oklch, var(--primary) 16%, transparent);
		font-size: 0.72rem;
		line-height: 1.6;
		color: var(--tea-muted);
	}
	.tea-banner > svg {
		width: 0.95rem;
		height: 0.95rem;
		flex: none;
		margin-top: 0.18rem;
		color: color-mix(in oklch, var(--primary) 72%, currentColor);
	}
	.tea-banner p {
		margin: 0;
	}
	.tea-banner a {
		color: color-mix(in oklch, var(--primary) 62%, #4b3a12);
		text-decoration: none;
		border-bottom: 1px solid color-mix(in oklch, var(--primary) 30%, transparent);
	}
	.tea-banner a:hover {
		border-bottom-color: currentColor;
	}
	.tea-banner__sep {
		opacity: 0.5;
	}

	/* 置顶消息条 */
	.tea-pins {
		display: flex;
		align-items: flex-start;
		gap: 0.5rem;
		margin: 0.5rem 0.95rem 0;
		padding: 0.4rem 0.65rem;
		border-radius: 0.7rem;
		background: color-mix(in oklch, var(--primary) 6%, var(--tea-surface));
		border: 1px solid color-mix(in oklch, var(--primary) 18%, transparent);
		font-size: 0.72rem;
		line-height: 1.55;
	}
	.tea-pins[hidden] { display: none; }
	.tea-pins__icon {
		display: inline-flex;
		flex: none;
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
		margin-top: 0.1rem;
	}
	.tea-pins__icon svg { width: 0.9rem; height: 0.9rem; }
	.tea-pins__body { flex: 1; min-width: 0; color: var(--tea-muted); }
	.tea-pins__who { font-weight: 700; color: var(--primary); }
	.tea-pins__text { white-space: pre-wrap; word-break: break-word; }
	.tea-pins__text a { color: var(--primary); text-decoration: none; border-bottom: 1px solid color-mix(in oklch, var(--primary) 30%, transparent); }
	.tea-pins--collapsed .tea-pins__text {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 1;
		overflow: hidden;
	}
	.tea-pins__toggle {
		flex: none;
		border: 0;
		background: transparent;
		color: var(--primary);
		font: inherit;
		font-size: 0.68rem;
		cursor: pointer;
		padding: 0.05rem 0.2rem;
	}
	.tea-pins__toggle:hover { text-decoration: underline; }

	/* 消息流 */
	.tea-feed-wrap {
		position: relative;
		min-height: 0;
	}
	.tea-feed {
		height: 100%;
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.9rem 1rem 1rem;
		display: flex;
		flex-direction: column;
		gap: 0.95rem;
		scrollbar-width: thin;
		outline: none;
	}
	.tea-feed::-webkit-scrollbar {
		width: 6px;
	}
	.tea-feed__status {
		margin: auto;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.78rem;
		color: var(--tea-muted-soft);
		text-align: center;
	}
	.tea-feed__status--error {
		flex-direction: column;
		gap: 0.45rem;
	}
	.tea-feed__status--error b {
		font-size: 0.88rem;
		font-weight: 600;
		color: inherit;
		opacity: 0.85;
	}
	.tea-feed__status--error span {
		font-size: 0.72rem;
		opacity: 0.7;
		word-break: break-word;
	}
	.tea-spinner {
		width: 0.85rem;
		height: 0.85rem;
		border-radius: 50%;
		border: 2px solid color-mix(in oklch, var(--primary) 30%, transparent);
		border-top-color: var(--primary);
		animation: tea-spin 0.8s linear infinite;
		flex: none;
	}
	@keyframes tea-spin {
		to {
			transform: rotate(360deg);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.tea-spinner {
			animation-duration: 2s;
		}
	}
	.tea-empty {
		margin: auto;
		text-align: center;
		display: grid;
		gap: 0.3rem;
		color: var(--tea-muted-soft);
	}
	.tea-empty b {
		font-size: 0.9rem;
		font-weight: 600;
		color: inherit;
		opacity: 0.8;
	}
	.tea-empty span {
		font-size: 0.74rem;
	}

	.tea-day {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.68rem;
		color: var(--tea-muted-soft);
		margin: 0.2rem 0 -0.25rem;
	}
	.tea-day::before,
	.tea-day::after {
		content: "";
		height: 1px;
		flex: 1;
		background: var(--tea-line);
	}

	/* 撤回提示 */
	.tea-recall {
		align-self: center;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		max-width: 90%;
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
		background: color-mix(in oklch, var(--primary) 6%, transparent);
		border: 1px dashed color-mix(in oklch, var(--primary) 22%, transparent);
		font-size: 0.68rem;
		line-height: 1.4;
		color: var(--tea-muted);
	}
	.tea-recall b { color: color-mix(in oklch, var(--primary) 70%, currentColor); font-weight: 600; }

	/* 上次阅读位置 */
	.tea-readmark {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0.2rem 0;
	}
	.tea-readmark::before,
	.tea-readmark::after {
		content: "";
		height: 1px;
		flex: 1;
		background: color-mix(in oklch, var(--primary) 42%, transparent);
	}
	.tea-readmark span {
		flex: none;
		padding: 0.15rem 0.55rem;
		border-radius: 999px;
		background: color-mix(in oklch, var(--primary) 13%, transparent);
		border: 1px solid color-mix(in oklch, var(--primary) 28%, transparent);
		color: color-mix(in oklch, var(--primary) 72%, currentColor);
		font-size: 0.66rem;
		white-space: nowrap;
	}
	.tea-readjump {
		position: absolute;
		right: 1rem;
		bottom: 0.6rem;
		z-index: 12;
		padding: 0.3rem 0.7rem;
		border-radius: 999px;
		border: 1px solid color-mix(in oklch, var(--primary) 35%, transparent);
		background: var(--tea-surface, #fff);
		color: var(--primary);
		font: inherit;
		font-size: 0.7rem;
		cursor: pointer;
		box-shadow: 0 4px 14px rgba(0,0,0,.1);
	}
	.tea-readjump[hidden] { display: none; }

	.tea-msg {
		display: grid;
		grid-template-columns: 2.1rem minmax(0, 1fr);
		gap: 0.6rem;
		align-items: start;
	}
	.tea-msg__avatar {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: 0.78rem;
		font-weight: 600;
		color: #fff;
		background-size: cover;
		background-position: center;
		flex: none;
	}
	.tea-msg__body {
		min-width: 0;
	}
	.tea-msg__head {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-bottom: 0.16rem;
	}
	.tea-msg__nick {
		font-size: 0.8rem;
		font-weight: 600;
	}
	.tea-msg__site {
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
		border-radius: 999px;
		padding: 0.05rem 0.42rem;
		white-space: nowrap;
	}
	.tea-msg__time {
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		font-variant-numeric: tabular-nums;
	}
	.tea-msg__text {
		font-size: 0.86rem;
		line-height: 1.7;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	.tea-msg__text a {
		color: color-mix(in oklch, var(--primary) 60%, #4b3a12);
		text-decoration: underline;
		text-decoration-color: color-mix(in oklch, var(--primary) 35%, transparent);
		text-underline-offset: 2px;
	}
	.tea-msg__text img {
		display: block;
		max-width: min(100%, 17rem);
		max-height: 14rem;
		border-radius: 0.7rem;
		margin-top: 0.3rem;
		border: 1px solid var(--tea-line);
		cursor: zoom-in;
		transition: filter 0.15s ease;
	}
	.tea-msg__text img:hover {
		filter: brightness(1.04);
	}
	.tea-msg__text img.tea-emoticon {
		display: inline-block;
		width: 2.4rem;
		height: 2.4rem;
		max-width: none;
		max-height: none;
		vertical-align: middle;
		margin: 0;
		border: 0;
		cursor: default;
	}
	.tea-msg__text img.tea-inline-emoji {
		display: inline-block;
		width: 1.35rem;
		height: 1.35rem;
		max-width: none;
		max-height: none;
		vertical-align: -0.22rem;
		margin: 0 0.08rem;
		border: 0;
		cursor: default;
	}
	.tea-msg__text pre {
		margin: 0.35rem 0 0;
		padding: 0.5rem 0.65rem;
		border-radius: 0.6rem;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
		overflow-x: auto;
		font-size: 0.74rem;
		line-height: 1.65;
		white-space: pre;
	}
	.tea-msg__text code {
		font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, monospace);
		font-size: 0.94em;
	}
	.tea-msg__text strong {
		font-weight: 600;
	}
	.tea-msg__reply {
		margin: 0 0 0.3rem;
		padding: 0.3rem 0.55rem;
		border-left: 2px solid color-mix(in oklch, var(--primary) 55%, transparent);
		border-radius: 0 0.45rem 0.45rem 0;
		background: color-mix(in oklch, var(--primary) 8%, var(--btn-regular-bg, rgba(128, 128, 128, 0.08)));
		font-size: 0.76rem;
		line-height: 1.5;
	}
	.tea-msg__reply b {
		display: block;
		font-size: 0.7rem;
		font-weight: 600;
		color: color-mix(in oklch, var(--primary) 62%, currentColor);
	}
	.tea-msg__reply span {
		display: block;
		opacity: 0.78;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}
	/* 投票卡片 */
	.tea-poll-card {
		margin: 0.2rem 0;
		min-width: 13rem;
		max-width: 20rem;
		display: grid;
		gap: 0.35rem;
	}
	.tea-poll-card__q {
		font-weight: 600;
		font-size: 0.84rem;
	}
	.tea-poll-card__opt {
		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		width: 100%;
		padding: 0.35rem 0.6rem;
		border: 1px solid var(--tea-line-strong);
		border-radius: 0.5rem;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.78rem;
		text-align: left;
		cursor: pointer;
		overflow: hidden;
	}
	.tea-poll-card__opt:hover:not(:disabled) {
		border-color: color-mix(in oklch, var(--primary) 55%, transparent);
	}
	.tea-poll-card__opt:disabled { cursor: default; }
	.tea-poll-card__bar {
		position: absolute;
		inset: 0 auto 0 0;
		background: color-mix(in oklch, var(--primary) 18%, transparent);
		transition: width 0.3s ease;
	}
	.tea-poll-card__opt.is-mine {
		border-color: color-mix(in oklch, var(--primary) 70%, transparent);
	}
	.tea-poll-card__opt.is-mine .tea-poll-card__bar {
		background: color-mix(in oklch, var(--primary) 32%, transparent);
	}
	.tea-poll-card__label,
	.tea-poll-card__pct { position: relative; z-index: 1; }
	.tea-poll-card__pct { font-variant-numeric: tabular-nums; opacity: 0.8; }
	.tea-poll-card__foot {
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
	}
	.tea-poll-options { display: grid; gap: 0.45rem; margin-bottom: 0.4rem; }
	.tea-poll-add {
		width: 100%;
		margin-bottom: 0.5rem;
		font-size: 0.76rem;
	}

	/* 成员名片 */
	.tea-membercard {
		border: 0;
		padding: 0;
		margin: auto;
		width: min(56rem, calc(100vw - 2rem));
		max-height: calc(100dvh - 2rem);
		border-radius: 1rem;
		background: var(--card-bg, #fff);
		color: inherit;
		box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.5);
		overflow: hidden;
	}
	.tea-membercard::backdrop { background: rgba(0, 0, 0, 0.45); backdrop-filter: blur(6px); }
	.tea-membercard__inner { display: grid; grid-template-rows: auto minmax(0, 1fr); height: 100%; max-height: calc(100dvh - 2rem); }
	.tea-membercard__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.7rem 1rem;
		border-bottom: 1px solid var(--tea-line);
	}
	.tea-membercard__head h3 { margin: 0; font-size: 0.95rem; font-weight: 600; }
	.tea-membercard__head .tea-icon-btn { width: 1.8rem; height: 1.8rem; }
	.tea-membercard__head .tea-icon-btn svg { width: 1.1rem; height: 1.1rem; }
	.tea-membercard__cols { display: grid; grid-template-columns: minmax(0, 38%) minmax(0, 62%); min-height: 0; }
	.tea-membercard__left,
	.tea-membercard__right { overflow-y: auto; overscroll-behavior: contain; min-height: 0; }
	.tea-membercard__left { padding: 0.85rem; display: grid; gap: 0.6rem; align-content: start; border-right: 1px solid var(--tea-line); }
	.tea-membercard__right { padding: 0.85rem 1rem; display: grid; gap: 0.6rem; align-content: start; }
	@media (max-width: 720px) {
		.tea-membercard__cols { grid-template-columns: 1fr; }
		.tea-membercard__left { border-right: 0; border-bottom: 1px solid var(--tea-line); }
	}
	.mc-card {
		border-radius: 0.85rem;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.08));
		padding: 0.7rem;
		display: grid;
		gap: 0.6rem;
	}
	.mc-top { display: flex; align-items: center; gap: 0.6rem; }
	.mc-avatar {
		position: relative;
		width: 3.2rem;
		height: 3.2rem;
		border-radius: 0.75rem;
		flex: none;
		background-size: cover;
		background-position: center;
		display: grid;
		place-items: center;
		font-weight: 600;
	}
	.mc-dot { position: absolute; right: -2px; bottom: -2px; width: 0.7rem; height: 0.7rem; border-radius: 50%; border: 2px solid var(--card-bg, #fff); background: #9ca3af; }
	.mc-dot.is-on { background: #22c55e; }
	.mc-ident { min-width: 0; display: grid; gap: 0.2rem; }
	.mc-name { font-size: 0.92rem; font-weight: 600; display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; }
	.mc-badge { font-size: 0.6rem; padding: 0.05rem 0.35rem; border-radius: 0.35rem; background: color-mix(in oklch, #eab308 25%, transparent); color: #a16207; font-weight: 600; }
	.mc-meta { font-size: 0.7rem; color: var(--tea-muted); display: flex; gap: 0.3rem; flex-wrap: wrap; }
	.mc-meta i { opacity: 0.5; font-style: normal; }
	.mc-signature, .mc-site {
		border: 1px solid var(--tea-line-strong);
		border-radius: 0.55rem;
		padding: 0.4rem 0.6rem;
		font-size: 0.74rem;
	}
	.mc-signature { color: var(--tea-muted); }
	.mc-site { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; color: color-mix(in oklch, var(--primary) 70%, currentColor); text-decoration: none; }
	.mc-site span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.mc-site span:last-child { flex: none; font-size: 0.66rem; }
	.mc-mx { font-size: 0.66rem; color: var(--tea-muted); display: grid; gap: 0.25rem; border-top: 1px solid var(--tea-line); padding-top: 0.5rem; }
	.mc-mx > div { display: flex; justify-content: space-between; gap: 0.5rem; }
	.mc-mx > div span:last-child { font-family: monospace; color: color-mix(in oklch, var(--primary) 68%, currentColor); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.mc-at {
		display: block;
		text-align: center;
		padding: 0.55rem;
		border-radius: 0.6rem;
		background: color-mix(in oklch, var(--primary) 88%, #000);
		color: #fff;
		font-size: 0.78rem;
		font-weight: 600;
		text-decoration: none;
	}
	.mc-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 0.4rem; }
	.mc-stat { display: flex; align-items: center; justify-content: space-between; gap: 0.4rem; padding: 0.45rem 0.6rem; border-radius: 0.55rem; background: var(--btn-regular-bg, rgba(128, 128, 128, 0.08)); font-size: 0.68rem; color: var(--tea-muted); }
	.mc-stat b { color: var(--deep-text, inherit); font-size: 0.76rem; }
	.mc-stat b.is-away { color: #ea580c; }
	.mc-block-title { font-size: 0.76rem; font-weight: 600; margin: 0.15rem 0 0; }
	.mc-artists { display: flex; flex-wrap: wrap; gap: 0.35rem; }
	.mc-artist { font-size: 0.68rem; padding: 0.25rem 0.5rem; border-radius: 2rem; background: var(--btn-regular-bg, rgba(128, 128, 128, 0.08)); }
	.mc-artist b { color: color-mix(in oklch, var(--primary) 70%, currentColor); margin-left: 0.2rem; }
	.mc-recent { display: grid; gap: 0.35rem; }
	.mc-recent-item { display: flex; justify-content: space-between; gap: 0.6rem; padding: 0.5rem 0.6rem; border-radius: 0.55rem; background: var(--btn-regular-bg, rgba(128, 128, 128, 0.08)); font-size: 0.7rem; }
	.mc-recent-item span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.mc-recent-item span:last-child { flex: none; color: var(--tea-muted-soft); font-size: 0.64rem; }
	.tea-membercard__songs-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--tea-line); font-size: 0.78rem; font-weight: 600; }
	.tea-membercard__songs-head em { font-style: normal; font-size: 0.64rem; font-weight: 500; padding: 0.1rem 0.4rem; border-radius: 0.4rem; background: color-mix(in oklch, var(--primary) 16%, transparent); color: color-mix(in oklch, var(--primary) 70%, currentColor); margin-left: 0.3rem; }
	.tea-membercard__sort { display: inline-flex; padding: 0.15rem; border-radius: 0.5rem; background: var(--btn-regular-bg, rgba(128, 128, 128, 0.08)); }
	.tea-membercard__sort button { border: 0; background: none; color: var(--tea-muted); font-size: 0.68rem; padding: 0.25rem 0.6rem; border-radius: 0.4rem; cursor: pointer; }
	.tea-membercard__sort button.is-active { background: color-mix(in oklch, var(--primary) 85%, #000); color: #fff; }
	.tea-membercard__songs { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
	.mc-song { display: flex; align-items: center; gap: 0.6rem; padding: 0.45rem 0.55rem; border-radius: 0.6rem; background: var(--btn-regular-bg, rgba(128, 128, 128, 0.08)); }
	.mc-song__idx { width: 1rem; flex: none; font-size: 0.72rem; color: var(--tea-muted); font-variant-numeric: tabular-nums; }
	.mc-song__cover { width: 2.3rem; height: 2.3rem; border-radius: 0.45rem; object-fit: cover; flex: none; background: rgba(128,128,128,.15); }
	.mc-song__copy { min-width: 0; flex: 1; display: grid; gap: 0.1rem; }
	.mc-song__copy b { font-size: 0.76rem; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.mc-song__copy span { font-size: 0.65rem; color: var(--tea-muted); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.mc-song__add { flex: none; border: 1px solid color-mix(in oklch, var(--primary) 45%, transparent); border-radius: 2rem; background: transparent; color: color-mix(in oklch, var(--primary) 70%, currentColor); font-size: 0.66rem; padding: 0.25rem 0.6rem; cursor: pointer; }
	.mc-empty { font-size: 0.72rem; color: var(--tea-muted); padding: 1.5rem 0.5rem; text-align: center; }

	.tea-msg__actions {
		display: inline-flex;
		align-items: center;
		gap: 0.15rem;
		margin-inline-start: 0.4rem;
		vertical-align: middle;
		opacity: 0;
		transition: opacity 0.15s;
	}
	.tea-msg:hover .tea-msg__actions,
	.tea-msg__actions:focus-within {
		opacity: 1;
	}
	.tea-msg__action {
		width: 1.35rem;
		height: 1.35rem;
		display: grid;
		place-items: center;
		border: 1px solid var(--tea-line);
		border-radius: 0.4rem;
		background: var(--card-bg, #fff);
		color: var(--tea-muted);
		cursor: pointer;
	}
	.tea-msg__action:hover {
		color: color-mix(in oklch, var(--primary) 72%, currentColor);
		border-color: color-mix(in oklch, var(--primary) 45%, transparent);
	}
	.tea-msg__action svg { width: 0.85rem; height: 0.85rem; }
	.tea-msg__reactions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		margin-top: 0.2rem;
	}
	.tea-msg__reaction {
		display: inline-flex;
		align-items: center;
		gap: 0.2rem;
		padding: 0.1rem 0.4rem;
		border: 1px solid var(--tea-line);
		border-radius: 999px;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.08));
		font-size: 0.72rem;
		cursor: pointer;
	}
	.tea-msg__reaction.is-mine {
		border-color: color-mix(in oklch, var(--primary) 55%, transparent);
		background: color-mix(in oklch, var(--primary) 14%, transparent);
	}
	.tea-msg--grouped {
		margin-top: -0.55rem;
	}
	.tea-msg--grouped .tea-msg__avatar {
		visibility: hidden;
		height: 0;
	}
	.tea-msg--grouped .tea-msg__head {
		display: none;
	}
	/* 自己的消息：头像移到右侧，正文整体靠右对齐 */
	.tea-msg--mine {
		grid-template-columns: minmax(0, 1fr) 2.1rem;
	}
	.tea-msg--mine .tea-msg__avatar {
		grid-column: 2;
		grid-row: 1;
	}
	.tea-msg--mine .tea-msg__body {
		grid-column: 1;
		grid-row: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}
	.tea-msg--mine .tea-msg__head {
		justify-content: flex-end;
	}
	.tea-msg--mine .tea-msg__nick {
		color: color-mix(in oklch, var(--primary) 66%, currentColor);
	}
	.tea-msg--mine .tea-msg__text {
		background: color-mix(in oklch, var(--primary) 11%, transparent);
		border: 1px solid color-mix(in oklch, var(--primary) 18%, transparent);
		border-radius: 0.75rem;
		padding: 0.42rem 0.62rem;
		display: inline-block;
		max-width: 100%;
		text-align: left;
	}
	.tea-msg--mine .tea-msg__reply {
		border-left: 0;
		border-right: 2px solid color-mix(in oklch, var(--primary) 55%, transparent);
		border-radius: 0.45rem 0 0 0.45rem;
	}
	.tea-msg--pending {
		opacity: 0.55;
	}
	.tea-msg--pending .tea-msg__actions { display: none; }
	.tea-msg--failed .tea-msg__text {
		border-color: color-mix(in oklch, #c0563f 45%, transparent);
	}
	.tea-msg__retry {
		font-size: 0.68rem;
		color: #c0563f;
		background: none;
		border: 0;
		padding: 0.2rem 0 0;
		cursor: pointer;
	}

	/* ── 已读回执 ───────────────────────────────────────── */
	.tea-receipt {
		position: relative;
		display: inline-flex;
		align-items: center;
		margin-top: 0.2rem;
	}
	.tea-receipt__trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		min-height: 1.35rem;
		padding: 0 0.3rem;
		border: 0;
		border-radius: 0.6rem;
		background: transparent;
		color: var(--tea-muted-soft);
		font-size: 0.66rem;
		cursor: pointer;
	}
	.tea-receipt__trigger:hover,
	.tea-receipt__trigger[aria-expanded="true"] {
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
	}
	.tea-receipt__faces {
		display: inline-flex;
		align-items: center;
	}
	.tea-receipt__faces img {
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 50%;
		object-fit: cover;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
		border: 1px solid var(--card-bg, #fff);
	}
	.tea-receipt__faces img + img {
		margin-inline-start: -0.3rem;
	}
	.tea-receipt__faces span {
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: 0.5rem;
		font-weight: 600;
		color: #fff;
		border: 1px solid var(--card-bg, #fff);
	}
	.tea-receipt__faces span + span,
	.tea-receipt__faces img + span {
		margin-inline-start: -0.3rem;
	}
	.tea-receipt__pop {
		position: fixed;
		z-index: 100;
		width: min(15rem, calc(100vw - 2rem));
		max-height: min(18rem, 60vh);
		overflow-y: auto;
		overscroll-behavior: contain;
		border: 1px solid var(--tea-line);
		border-radius: 0.8rem;
		background: var(--card-bg, #fff);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
		padding: 0.35rem;
	}
	.tea-receipt__pop[hidden] {
		display: none;
	}
	.tea-receipt__pop h5 {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		margin: 0 0 0.25rem;
		padding: 0.15rem 0.4rem 0.35rem;
		border-bottom: 1px solid var(--tea-line);
		font-size: 0.72rem;
		font-weight: 600;
	}
	.tea-receipt__pop h5 small {
		color: var(--tea-muted-soft);
		font-weight: 400;
	}
	.tea-receipt__list {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.tea-receipt__list li {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.28rem 0.4rem;
		border-radius: 0.45rem;
		font-size: 0.72rem;
	}
	.tea-receipt__list li:hover {
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
	}
	.tea-receipt__list img,
	.tea-receipt__list span.tea-receipt__ph {
		width: 1.35rem;
		height: 1.35rem;
		flex: none;
		border-radius: 50%;
		object-fit: cover;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
		display: grid;
		place-items: center;
		font-size: 0.62rem;
	}
	.tea-receipt__who {
		min-width: 0;
		display: grid;
	}
	.tea-receipt__who small {
		color: var(--tea-muted-soft);
		font-size: 0.62rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.tea-jump {
		position: absolute;
		left: 50%;
		bottom: 0.7rem;
		transform: translateX(-50%);
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		padding: 0.35rem 0.8rem;
		border-radius: 999px;
		border: 1px solid var(--tea-line-strong);
		background: var(--tea-surface);
		color: inherit;
		font-size: 0.72rem;
		box-shadow: 0 8px 22px -14px rgba(0, 0, 0, 0.5);
		cursor: pointer;
	}
	.tea-jump svg {
		width: 0.9rem;
		height: 0.9rem;
	}

	/* 输入区 */
	.tea-composer {
		border-top: 1px solid var(--tea-line);
		padding: 0.7rem 0.95rem 0.8rem;
		display: grid;
		gap: 0.4rem;
	}
	.tea-gate {
		display: flex;
		align-items: center;
		gap: 0.65rem;
		padding: 0.6rem 0.7rem;
		border-radius: 0.9rem;
		background: color-mix(in oklch, var(--primary) 6%, transparent);
		border: 1px dashed color-mix(in oklch, var(--primary) 30%, transparent);
	}
	.tea-gate__icon {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 0.7rem;
		display: grid;
		place-items: center;
		background: color-mix(in oklch, var(--primary) 16%, transparent);
		color: color-mix(in oklch, var(--primary) 74%, currentColor);
		flex: none;
	}
	.tea-gate__icon svg {
		width: 1.15rem;
		height: 1.15rem;
	}
	.tea-gate__copy {
		display: grid;
		gap: 0.1rem;
		min-width: 0;
		flex: 1;
	}
	.tea-gate__copy b {
		font-size: 0.84rem;
		font-weight: 600;
	}
	.tea-gate__copy span {
		font-size: 0.72rem;
		color: var(--tea-muted);
	}

	.tea-input {
		position: relative;
		display: grid;
		gap: 0.2rem;
		padding: 0.35rem 0.45rem 0.4rem;
		border: 1px solid var(--tea-line-strong);
		border-radius: 0.85rem;
		background: color-mix(in oklch, var(--primary) 2%, transparent);
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.tea-input:focus-within {
		border-color: color-mix(in oklch, var(--primary) 48%, transparent);
		box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 14%, transparent);
	}
	.tea-input textarea {
		width: 100%;
		resize: none;
		min-height: 4.3rem;
		max-height: 8rem;
		padding: 0.3rem 0.3rem;
		border: 0;
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.88rem;
		line-height: 1.6;
		outline: none;
	}
	.tea-input textarea:focus {
		box-shadow: none;
	}
	.tea-input__tools {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		flex-wrap: wrap;
	}
	.tea-tool {
		width: 1.8rem;
		height: 1.8rem;
		display: grid;
		place-items: center;
		border: 1px solid var(--tea-line);
		border-radius: 0.55rem;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.08));
		color: var(--tea-muted);
		cursor: pointer;
		transition: color 0.15s, background 0.15s;
	}
	.tea-tool:hover {
		color: color-mix(in oklch, var(--primary) 70%, currentColor);
		background: color-mix(in oklch, var(--primary) 12%, transparent);
	}
	.tea-tool svg {
		width: 1.1rem;
		height: 1.1rem;
	}
	.tea-tool.is-active {
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
		background: color-mix(in oklch, var(--primary) 14%, transparent);
	}
	.tea-md-preview {
		border: 1px solid var(--tea-line-strong);
		border-radius: 0.75rem;
		background: color-mix(in oklch, var(--primary) 4%, transparent);
		overflow: hidden;
	}
	.tea-md-preview[hidden] { display: none; }
	.tea-md-preview__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.35rem 0.6rem;
		font-size: 0.68rem;
		color: var(--tea-muted);
		border-bottom: 1px solid var(--tea-line);
	}
	.tea-md-preview__head button {
		border: 0;
		background: none;
		color: color-mix(in oklch, var(--primary) 70%, currentColor);
		font-size: 0.68rem;
		cursor: pointer;
	}
	.tea-md-preview__body {
		padding: 0.5rem 0.7rem;
		min-height: 2.4rem;
		max-height: 8rem;
		overflow: auto;
		font-size: 0.86rem;
		line-height: 1.6;
	}
	.tea-md-preview__body p { margin: 0 0 0.5rem; }
	.tea-md-preview__body p:last-child { margin-bottom: 0; }
	.tea-md-preview__body pre {
		padding: 0.5rem 0.6rem;
		border-radius: 0.5rem;
		background: rgba(128, 128, 128, 0.12);
		overflow: auto;
	}
	.tea-md-preview__body code { font-size: 0.8em; }
	.tea-md-preview__body a { color: color-mix(in oklch, var(--primary) 70%, currentColor); }
	.tea-md-preview__body .tea-poll-card { margin: 0; }
	.tea-emoji-panel {
		position: fixed;
		bottom: 0;
		left: 0;
		z-index: 130;
		width: 19rem;
		max-width: calc(100vw - 1.5rem);
		max-height: min(17rem, 48vh);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 0.6rem;
		border: 1px solid var(--tea-line);
		border-radius: 0.85rem;
		box-shadow: 0 14px 40px rgba(0, 0, 0, 0.16);
		background: var(--card-bg, #fff);
	}
	.tea-emoji-panel[data-anchored] { bottom: auto; left: auto; }
	.tea-emoji-panel[hidden] {
		display: none;
	}
	.tea-emoji-panel__tabs {
		display: flex;
		gap: 0.25rem;
		margin-bottom: 0.4rem;
	}
	.tea-emoji-panel__tab {
		padding: 0.15rem 0.55rem;
		border: 0;
		border-radius: 0.5rem;
		background: transparent;
		color: var(--tea-muted);
		font-size: 0.72rem;
		cursor: pointer;
	}
	.tea-emoji-panel__tab.is-active {
		background: color-mix(in oklch, var(--primary) 15%, transparent);
		color: color-mix(in oklch, var(--primary) 75%, currentColor);
		font-weight: 600;
	}
	.tea-emoji-panel__grid {
		display: grid;
		grid-template-columns: repeat(9, minmax(0, 1fr));
		gap: 0.1rem;
	}
	.tea-emoji-panel__grid img,
	.tea-emoji-panel__grid .tea-emoji-char {
		width: 100%;
		height: 2rem;
		display: grid;
		place-items: center;
		object-fit: contain;
		font-size: 1.25rem;
		line-height: 1;
		cursor: pointer;
		border: 0;
		border-radius: 0.35rem;
		background: transparent;
	}
	.tea-emoji-panel__grid img:hover,
	.tea-emoji-panel__grid .tea-emoji-char:hover {
		background: color-mix(in oklch, var(--primary) 15%, transparent);
	}
	.tea-emoji-panel__msg {
		font-size: 0.72rem;
		color: var(--tea-muted);
		padding: 0.4rem;
	}
	.tea-typing {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.25rem 0.4rem;
		font-size: 0.7rem;
		color: var(--tea-muted);
	}
	.tea-typing[hidden] {
		display: none;
	}
	.tea-typing__dots {
		display: inline-flex;
		gap: 0.15rem;
	}
	.tea-typing__dots i {
		width: 0.28rem;
		height: 0.28rem;
		border-radius: 50%;
		background: color-mix(in oklch, var(--primary) 65%, currentColor);
		animation: tea-typing-bounce 1.1s infinite ease-in-out;
	}
	.tea-typing__dots i:nth-child(2) { animation-delay: 0.15s; }
	.tea-typing__dots i:nth-child(3) { animation-delay: 0.3s; }
	@keyframes tea-typing-bounce {
		0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
		30% { transform: translateY(-0.2rem); opacity: 1; }
	}
	.tea-replybar {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.55rem;
		border-left: 2px solid color-mix(in oklch, var(--primary) 55%, transparent);
		background: color-mix(in oklch, var(--primary) 8%, transparent);
		border-radius: 0 0.5rem 0.5rem 0;
		font-size: 0.72rem;
	}
	.tea-replybar[hidden] { display: none; }
	.tea-replybar__icon svg { width: 1rem; height: 1rem; }
	.tea-replybar__copy { flex: 1; min-width: 0; display: grid; }
	.tea-replybar__copy b { color: color-mix(in oklch, var(--primary) 70%, currentColor); }
	.tea-replybar__copy span { color: var(--tea-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
	.tea-replybar button { border: 0; background: none; color: var(--tea-muted); font-size: 1.1rem; cursor: pointer; }
	.tea-input__count {
		margin-left: auto;
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		font-variant-numeric: tabular-nums;
	}

	/* 按钮 */
	.tea-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.3rem;
		border-radius: 0.65rem;
		border: 1px solid transparent;
		font: inherit;
		font-size: 0.78rem;
		font-weight: 500;
		padding: 0.45rem 0.9rem;
		cursor: pointer;
		transition: transform 0.12s ease, filter 0.15s ease, background 0.15s ease;
		white-space: nowrap;
	}
	.tea-btn svg {
		width: 1rem;
		height: 1rem;
	}
	.tea-btn--primary {
		background: var(--primary);
		color: color-mix(in oklch, var(--primary) 22%, #2b2205);
		box-shadow: 0 8px 18px -12px color-mix(in oklch, var(--primary) 80%, transparent);
	}
	.tea-btn--primary:hover {
		filter: brightness(1.04);
	}
	.tea-btn--primary:active {
		transform: translateY(1px);
	}
	.tea-btn--ghost {
		background: transparent;
		border-color: var(--tea-line-strong);
		color: inherit;
	}
	.tea-btn--ghost:hover {
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-btn:disabled {
		opacity: 0.5;
		cursor: not-allowed;
		transform: none;
	}
	.tea-send {
		padding: 0.42rem 0.8rem;
	}
	.tea-form-error {
		margin: 0;
		font-size: 0.72rem;
		color: #c0563f;
	}

	/* ─── 点歌台 ───────────────────────────────────────────── */
	.tea-juke {
		display: flex;
		flex-direction: column;
		min-height: 0;
		background: var(--tea-surface);
		border: 1px solid var(--tea-line);
		border-radius: 1.1rem;
		overflow: hidden;
	}
	.tea-juke__head {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.7rem 0.8rem;
		border-bottom: 1px solid var(--tea-line);
		flex: none;
	}
	.tea-juke__title {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		min-width: 0;
	}
	.tea-juke__title svg {
		width: 1rem;
		height: 1rem;
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
	}
	.tea-juke__title h2 {
		margin: 0;
		font-size: 0.86rem;
		font-weight: 600;
	}
	.tea-juke__tools {
		display: flex;
		align-items: center;
		gap: 0.3rem;
	}
	.tea-juke__live {
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
		font-size: 0.66rem;
		color: var(--tea-muted-soft);
		white-space: nowrap;
	}
	.tea-juke__live i {
		width: 0.34rem;
		height: 0.34rem;
		border-radius: 50%;
		background: currentColor;
		opacity: 0.5;
	}
	.tea-juke__live b {
		font-weight: 400;
	}
	.tea-juke__live.is-playing {
		color: #2f9e6b;
	}
	.tea-juke__live.is-playing i {
		opacity: 1;
		box-shadow: 0 0 0 3px color-mix(in oklch, #2f9e6b 20%, transparent);
	}

	.tea-juke__stage {
		display: grid;
		grid-template-columns: minmax(0, 40%) minmax(0, 1fr);
		gap: 0.65rem;
		padding: 0.8rem 0.8rem 0.15rem;
		align-items: center;
		flex: none;
	}
	.tea-juke__cover {
		position: relative;
		aspect-ratio: 1 / 1;
		width: 100%;
		border-radius: 0.8rem;
		background-color: color-mix(in oklch, var(--primary) 12%, transparent);
		background-size: cover;
		background-position: center;
		border: 1px solid var(--tea-line);
		overflow: hidden;
	}
	.tea-juke__eq {
		position: absolute;
		left: 0.55rem;
		bottom: 0.55rem;
		display: flex;
		align-items: flex-end;
		gap: 0.14rem;
		height: 0.85rem;
		padding: 0.18rem 0.32rem;
		border-radius: 0.4rem;
		background: rgba(0, 0, 0, 0.35);
		backdrop-filter: blur(4px);
	}
	.tea-juke__eq i {
		width: 2px;
		background: #fff;
		border-radius: 1px;
		height: 30%;
		opacity: 0.55;
	}
	.tea-juke__eq i:nth-child(2) {
		height: 70%;
	}
	.tea-juke__eq i:nth-child(3) {
		height: 45%;
	}
	.tea-juke.is-playing .tea-juke__eq i {
		animation: tea-eq 0.9s ease-in-out infinite alternate;
		opacity: 1;
	}
	.tea-juke.is-playing .tea-juke__eq i:nth-child(2) {
		animation-delay: -0.3s;
	}
	.tea-juke.is-playing .tea-juke__eq i:nth-child(3) {
		animation-delay: -0.6s;
	}
	@keyframes tea-eq {
		from {
			height: 22%;
		}
		to {
			height: 100%;
		}
	}
	.tea-juke__info {
		min-width: 0;
		display: grid;
		gap: 0.6rem;
		align-content: center;
	}
	.tea-juke__meta {
		min-width: 0;
	}
	.tea-juke__meta h3 {
		margin: 0;
		font-size: 0.82rem;
		font-weight: 600;
		line-height: 1.35;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}
	.tea-juke__meta p {
		margin: 0.25rem 0 0;
		font-size: 0.68rem;
		color: var(--tea-muted);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.tea-juke__timeline {
		min-width: 0;
	}
	.tea-juke input[type="range"] {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 3px;
		border-radius: 999px;
		background: linear-gradient(
			to right,
			var(--primary) 0%,
			var(--primary) var(--p, 0%),
			color-mix(in oklch, currentColor 14%, transparent) var(--p, 0%),
			color-mix(in oklch, currentColor 14%, transparent) 100%
		);
		outline: none;
		cursor: pointer;
	}
	.tea-juke input[type="range"]::-webkit-slider-thumb {
		-webkit-appearance: none;
		width: 0.6rem;
		height: 0.6rem;
		border-radius: 50%;
		background: var(--primary);
		border: 2px solid var(--tea-surface);
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
	}
	.tea-juke input[type="range"]::-moz-range-thumb {
		width: 0.6rem;
		height: 0.6rem;
		border: 2px solid var(--tea-surface);
		border-radius: 50%;
		background: var(--primary);
	}
	.tea-juke__times {
		display: flex;
		justify-content: space-between;
		font-size: 0.62rem;
		color: var(--tea-muted-soft);
		margin-top: 0.2rem;
		font-variant-numeric: tabular-nums;
	}

	.tea-juke__controls {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.45rem 0.8rem 0.6rem;
		flex: none;
	}
	.tea-juke__ctrl,
	.tea-juke__play {
		border: 0;
		background: transparent;
		color: inherit;
		cursor: pointer;
		display: grid;
		place-items: center;
		border-radius: 50%;
		opacity: 0.75;
	}
	.tea-juke__ctrl {
		width: 1.9rem;
		height: 1.9rem;
	}
	.tea-juke__ctrl:hover {
		opacity: 1;
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.1));
	}
	.tea-juke__ctrl svg {
		width: 1.1rem;
		height: 1.1rem;
	}
	.tea-juke__play {
		width: 2.35rem;
		height: 2.35rem;
		background: var(--primary);
		color: color-mix(in oklch, var(--primary) 20%, #2b2205);
		box-shadow: 0 8px 18px -12px color-mix(in oklch, var(--primary) 80%, transparent);
		opacity: 1;
	}
	.tea-juke__play svg {
		width: 1.25rem;
		height: 1.25rem;
	}
	.tea-juke__play span {
		display: grid;
		place-items: center;
	}
	.tea-juke__play span[hidden] {
		display: none;
	}
	.tea-juke__vol {
		display: flex;
		align-items: center;
		gap: 0.3rem;
		margin-left: auto;
		flex: 1;
		max-width: 5.6rem;
		color: var(--tea-muted-soft);
	}
	.tea-juke__vol svg {
		width: 0.9rem;
		height: 0.9rem;
		flex: none;
	}

	.tea-juke__tabs {
		display: flex;
		gap: 0.2rem;
		padding: 0 0.7rem;
		border-top: 1px solid var(--tea-line);
		flex: none;
	}
	.tea-juke__tabs button {
		border: 0;
		background: none;
		color: var(--tea-muted);
		font: inherit;
		font-size: 0.72rem;
		padding: 0.5rem 0.4rem 0.45rem;
		cursor: pointer;
		border-bottom: 2px solid transparent;
	}
	.tea-juke__tabs button.is-active {
		color: inherit;
		font-weight: 600;
		border-bottom-color: var(--primary);
	}
	.tea-juke__panel {
		flex: 1 1 auto;
		min-height: 5rem;
		overflow-y: auto;
		padding: 0.35rem 0.4rem 0.6rem;
		scrollbar-width: thin;
	}
	.tea-juke__empty {
		margin: 0;
		padding: 0.6rem 0.4rem;
		font-size: 0.7rem;
		color: var(--tea-muted-soft);
	}
	.tea-song {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		width: 100%;
		padding: 0.3rem 0.4rem;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		text-align: left;
		border-radius: 0.55rem;
		cursor: pointer;
	}
	.tea-song:hover {
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-song.is-current {
		background: color-mix(in oklch, var(--primary) 10%, transparent);
	}
	.tea-song__idx {
		width: 1rem;
		flex: none;
		font-size: 0.62rem;
		color: var(--tea-muted-soft);
		font-variant-numeric: tabular-nums;
		text-align: center;
	}
	.tea-song.is-current .tea-song__idx {
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
	}
	.tea-song__copy {
		min-width: 0;
		display: grid;
	}
	.tea-song__name {
		font-size: 0.74rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tea-song__artist {
		font-size: 0.64rem;
		color: var(--tea-muted-soft);
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.tea-juke__lyrics {
		font-size: 0.75rem;
		text-align: center;
		padding: 0.5rem 0.5rem 3rem;
		-webkit-mask-image: linear-gradient(to bottom, transparent 0, #000 1.4rem, #000 calc(100% - 1.6rem), transparent 100%);
		mask-image: linear-gradient(to bottom, transparent 0, #000 1.4rem, #000 calc(100% - 1.6rem), transparent 100%);
	}
	.tea-lyric {
		display: block;
		width: 100%;
		border: 0;
		background: none;
		color: inherit;
		font: inherit;
		font-size: 0.75rem;
		line-height: 2.05;
		padding: 0.08rem 0.3rem;
		text-align: center;
		cursor: pointer;
		border-radius: 0.45rem;
		opacity: 0.58;
		transition: opacity 0.2s ease, color 0.2s ease;
	}
	.tea-lyric:hover {
		opacity: 0.95;
		background: var(--btn-plain-bg-hover, rgba(128, 128, 128, 0.08));
	}
	.tea-lyric.is-current {
		opacity: 1;
		font-weight: 600;
		color: color-mix(in oklch, var(--primary) 74%, currentColor);
	}
	.dark .tea-lyric.is-current {
		color: color-mix(in oklch, var(--primary) 86%, white);
	}

	/* ─── 图片预览 ─────────────────────────────────────────── */
	.tea-zoom {
		position: fixed;
		inset: 0;
		z-index: 60;
		display: grid;
		place-items: center;
		padding: 5vh 4vw;
		background: rgba(14, 16, 12, 0.78);
		backdrop-filter: blur(8px);
		animation: tea-zoom-in 0.18s ease-out;
		cursor: zoom-out;
	}
	.tea-zoom[hidden] {
		display: none;
	}
	.tea-zoom img {
		max-width: min(92vw, 1400px);
		max-height: 88vh;
		border-radius: 0.8rem;
		box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.8);
		object-fit: contain;
		cursor: default;
	}
	.tea-zoom__close {
		position: absolute;
		top: 1rem;
		right: 1rem;
		width: 2.4rem;
		height: 2.4rem;
		display: grid;
		place-items: center;
		border: 0;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.92);
		color: #1f2418;
		cursor: pointer;
		box-shadow: 0 8px 24px -10px rgba(0, 0, 0, 0.7);
	}
	.tea-zoom__close svg {
		width: 1.2rem;
		height: 1.2rem;
	}
	@keyframes tea-zoom-in {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.tea-zoom {
			animation: none;
		}
	}

	/* ─── 弹窗 ─────────────────────────────────────────────── */
	.tea-dialog {
		border: 0;
		padding: 0;
		margin: auto;
		width: min(24rem, calc(100vw - 2rem));
		max-height: calc(100dvh - 2rem);
		border-radius: 1.1rem;
		background: var(--card-bg, #fff);
		color: inherit;
		box-shadow: 0 30px 80px -30px rgba(0, 0, 0, 0.5);
		overflow: auto;
	}
	.tea-dialog::backdrop {
		background: rgba(20, 24, 18, 0.36);
		backdrop-filter: blur(6px);
	}
	.tea-dialog__inner {
		padding: 1.05rem 1.25rem 1.25rem;
		display: grid;
		gap: 0.65rem;
	}
	.tea-dialog__head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
	}
	.tea-dialog__icon {
		width: 2.4rem;
		height: 2.4rem;
		border-radius: 0.8rem;
		display: grid;
		place-items: center;
		background: color-mix(in oklch, var(--primary) 15%, transparent);
		color: color-mix(in oklch, var(--primary) 78%, currentColor);
	}
	.tea-dialog__icon svg {
		width: 1.3rem;
		height: 1.3rem;
	}
	.tea-dialog__close {
		width: 1.9rem;
		height: 1.9rem;
	}
	.tea-dialog h3 {
		margin: 0;
		font-size: 1.05rem;
		font-weight: 600;
	}
	.tea-dialog__desc {
		margin: -0.25rem 0 0.2rem;
		font-size: 0.76rem;
		line-height: 1.6;
		color: var(--tea-muted);
	}
	.tea-field {
		display: grid;
		gap: 0.28rem;
	}
	.tea-field > span {
		display: flex;
		align-items: baseline;
		gap: 0.4rem;
		font-size: 0.74rem;
		font-weight: 500;
	}
	.tea-field em {
		font-style: normal;
		font-size: 0.66rem;
		font-weight: 400;
		color: var(--tea-muted-soft);
	}
	.tea-field input {
		width: 100%;
		padding: 0.5rem 0.65rem;
		border-radius: 0.6rem;
		border: 1px solid var(--tea-line-strong);
		background: transparent;
		color: inherit;
		font: inherit;
		font-size: 0.84rem;
		outline: none;
		transition: border-color 0.15s ease, box-shadow 0.15s ease;
	}
	.tea-field input:focus {
		border-color: color-mix(in oklch, var(--primary) 48%, transparent);
		box-shadow: 0 0 0 3px color-mix(in oklch, var(--primary) 14%, transparent);
	}
	.tea-dialog__preview {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.55rem 0.65rem;
		border-radius: 0.75rem;
		background: color-mix(in oklch, var(--primary) 6%, transparent);
		border: 1px solid color-mix(in oklch, var(--primary) 14%, transparent);
	}
	.tea-dialog__avatar {
		width: 2.1rem;
		height: 2.1rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: 0.78rem;
		font-weight: 600;
		color: #fff;
		background: color-mix(in oklch, var(--primary) 70%, #6b5a22);
		flex: none;
	}
	.tea-dialog__preview-copy {
		display: grid;
		gap: 0.08rem;
		min-width: 0;
	}
	.tea-dialog__preview-copy b {
		font-size: 0.8rem;
		font-weight: 600;
	}
	.tea-dialog__preview-copy span {
		font-size: 0.66rem;
		color: var(--tea-muted);
	}
	.tea-dialog__submit {
		margin-top: 0.15rem;
		padding: 0.55rem 1rem;
	}
	.tea-dialog__error {
		margin: 0;
		font-size: 0.72rem;
		color: #c0563f;
	}
	.tea-dialog__inner[hidden] {
		display: none;
	}
	.tea-dialog__divider {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin: 0.3rem 0 0.1rem;
		font-size: 0.68rem;
		color: var(--tea-muted-soft);
	}
	.tea-dialog__divider::before,
	.tea-dialog__divider::after {
		content: "";
		height: 1px;
		flex: 1;
		background: var(--tea-line-strong);
		opacity: 0.7;
	}
	.tea-dialog__waline {
		width: 100%;
		padding: 0.55rem 1rem;
		border-color: var(--tea-line);
	}
	.tea-dialog__hint {
		margin: 0;
		font-size: 0.66rem;
		line-height: 1.6;
		color: var(--tea-muted-soft);
	}
	.tea-dialog__back {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		align-self: center;
		border: 0;
		background: none;
		color: var(--tea-muted);
		font: inherit;
		font-size: 0.72rem;
		cursor: pointer;
		padding: 0.2rem;
	}
	.tea-dialog__back:hover {
		color: inherit;
	}
	.tea-dialog__back svg {
		width: 0.9rem;
		height: 0.9rem;
	}

	/* 遮罩（移动端抽屉） */
	.tea-scrim {
		position: fixed;
		inset: 0;
		z-index: 29;
		background: rgba(20, 24, 18, 0.32);
		backdrop-filter: blur(2px);
	}
	.tea-juke-scrim {
		display: none;
		z-index: 30;
	}

	/* ─── 响应式 ───────────────────────────────────────────── */
	@media (max-width: 1440px) {
		.tea-app {
			grid-template-columns: 15.5rem minmax(0, 1fr) 16rem;
		}
		.tea-app.is-juke-hidden {
			grid-template-columns: 15.5rem minmax(0, 1fr);
		}
	}

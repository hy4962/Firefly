	.tea-profile__preview-copy { flex: 1; min-width: 0; display: grid; gap: 0.15rem; }
	.tea-profile__nameline { display: flex; align-items: center; gap: 0.3rem; min-width: 0; }
	.tea-profile__nameline b {
		font-size: 0.9rem;

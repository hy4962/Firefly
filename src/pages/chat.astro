	   这里针对本页拆掉；同时把壁纸和侧栏藏掉，给茶室一个干净的底 */
	html:has(.tea-app) :is(#content-panel, #content-panel-inner, #main-grid, #content-column, #content-wrapper, #swup-container) {
		transform: none !important;
		animation: none !important;
		opacity: 1 !important;
		contain: none !important;
	}
	html:has(.tea-app) body :is(#wallpaper-wrapper, #category-bar-wrapper, #category-bar, #left-sidebar-wrapper, #right-sidebar-wrapper, #left-sidebar, #right-sidebar, #left-sidebar-static, #right-sidebar-static, #left-sidebar-sticky, #right-sidebar-sticky, #left-sidebar-dynamic, #right-sidebar-dynamic, #mobile-bottom-sidebar, .site-footer, .floating-controls-container) {

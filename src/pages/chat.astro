	/* ── 已读回执 ───────────────────────────────────────── */
	.tea-receipt {
		position: relative;
		display: inline-flex;
		align-items: center;
		margin-top: 0.2rem;
	}
	.tea-receipt__trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		min-height: 1.35rem;
		padding: 0 0.3rem;
		border: 0;
		border-radius: 0.6rem;
		background: transparent;
		color: var(--tea-muted-soft);
		font-size: 0.66rem;
		cursor: pointer;
	}
	.tea-receipt__trigger:hover,
	.tea-receipt__trigger[aria-expanded="true"] {
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
	}
	.tea-receipt__faces {
		display: inline-flex;
		align-items: center;
	}
	.tea-receipt__faces img {
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 50%;
		object-fit: cover;
		background: var(--btn-regular-bg, rgba(128, 128, 128, 0.1));
		border: 1px solid var(--card-bg, #fff);
	}
	.tea-receipt__faces img + img {
		margin-inline-start: -0.3rem;
	}
	.tea-receipt__faces span {
		width: 0.95rem;
		height: 0.95rem;
		border-radius: 50%;
		display: grid;
		place-items: center;
		font-size: 0.5rem;
		font-weight: 600;
		color: #fff;
		border: 1px solid var(--card-bg, #fff);

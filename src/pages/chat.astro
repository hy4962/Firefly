	.mc-recent { display: grid; grid-template-columns: minmax(0, 1fr); gap: 0.35rem; }
	.mc-recent-item { display: flex; justify-content: space-between; gap: 0.6rem; min-width: 0; padding: 0.5rem 0.6rem; border-radius: 0.55rem; background: var(--btn-regular-bg, rgba(128, 128, 128, 0.08)); font-size: 0.7rem; }
	.mc-recent-item span:first-child { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
	.mc-recent-item span:last-child { flex: none; color: var(--tea-muted-soft); font-size: 0.64rem; }
	.tea-membercard__songs-head { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding-bottom: 0.4rem; border-bottom: 1px solid var(--tea-line); font-size: 0.78rem; font-weight: 600; }
